max() {
	(( $1 > $2 )) && echo $1 && return
	echo $2
}

min() {
	(( $1 < $2 )) && echo $1 && return
	echo $2
}

layout_desktop() {
	:
}

calculate_workarea() {
	local monitorid=$1
	local -n monitor=monitor_$monitorid
	local -n struts=struts_$monitorid

	local left=0 right=0 top=0 bottom=0
	local x=${monitor[x]}
	local y=${monitor[y]}
	local width=${monitor[width]}
	local height=${monitor[height]}
	local root=${screen_0[root]}
	local id window strut sstrut
	
	log 'Struts: %s\n' "${struts[@]@Q}"

	for id in "${struts[@]}"; do
		log_array window_$id
		local -n window=window_$id
		sstrut="${window[$XA_NET_WM_STRUT_PARTIAL]}"
		log 'Strut: %s\n' "$sstrut"
		strut=( $sstrut )
		(( ${#strut[@]} >= 4 )) || continue
		left=$(max left strut[0])
		right=$(max right strut[1])
		top=$(max top strut[2])
		bottom=$(max bottom strut[3])
	done
	(( x += left ))
	(( y += top ))
	(( width -= left + right ))
	(( height -= top + bottom ))
	
	if (( monitor[wa_x] == x &&
			monitor[wa_y] == y &&
			monitor[wa_width] == width && 
			monitor[wa_height] == height )); then
		return
	fi

	log 'Work Area for Monitor %d: x=%d y=%d width=%d height=%d\n' \
		$monitorid $x $y $width $height

	monitor[wa_x]=$x
	monitor[wa_y]=$y
	monitor[wa_width]=$width
	monitor[wa_height]=$height

	update_workareas

	layout_tiles $desktopid
}

update_workareas() {
	local vals=()
	local i
	for (( i=0 ; i<desktop_count ; i++ )); do
		local -n monitor=monitor_${desktop_monitor[i]}
		vals+=( $((monitor[wa_x] - monitor[x])) \
			$((monitor[wa_y] - monitor[y])) \
			${monitor[wa_width]} \
			${monitor[wa_height]} )
	done
	log 'Work area values %d\n' ${#vals[@]}

	send_change_property ${screen_0[root]} $X_PropModeReplace \
		$XA_NET_WORKAREA $XA_CARDINAL 32 ${#vals[@]} "${vals[@]}"
}

add_strut() {
	local monitorid=$1
	local windowid=$2
	local -n struts=struts_$monitorid

	struts+=( $windowid )

	log_array struts_$monitorid
}

setlastfocus() {
	local -n focuslist=focuslist_$current_desktop

	setfocus ${focuslist[@]: -1}
}

setfocus() {
	local windowid=$1
	local timestamp=${2:-$X_CurrentTime}

	if [[ $windowid ]]; then
		local -n window=window_$windowid

		log 'Set Focus for window %s\n' $windowid

		log 'Window %s[mapped] = %s\n' $windowid ${window[mapped]} 

		[[ ${window[mapped]} == 1 ]] || return

		if (( window[take_focus] )); then
			send_protocol_message $windowid $XA_WM_TAKE_FOCUS
		else
			send_set_input_focus $windowid $timestamp
		fi
	else
		send_set_input_focus $X_PointerRoot $timestamp
	fi
}

set_active_window() {
	local windowid=${1:-0}
	local active_window=${screen_0[active]:-0}

	log 'SetActiveWindow <%s> -> <%s>\n' "$active_window" "$windowid"

	(( $windowid != $active_window )) || return

	if (( active_window )); then
		local -n window=window_$active_window
		send_set_border_color $active_window $wm_border_inactive
	fi

	active_window=$windowid

	screen_0[active]=$active_window
	if (( active_window )); then
		local -n window=window_$active_window
		send_set_border_color $active_window $wm_border_active
		send_change_property ${screen_0[root]} $X_PropModeReplace \
			$XA_NET_ACTIVE_WINDOW $XA_WINDOW 32 1 $active_window
		set_current_desktop ${window[desktop]}
	else
		send_delete_property ${screen_0[root]} $XA_NET_ACTIVE_WINDOW
	fi
}

set_current_desktop() {
	desktopid=$1

	(( desktopid != current_desktop )) || return

	current_desktop=$desktopid

	send_change_property ${screen_0[root]} $X_PropModeReplace \
		$XA_NET_CURRENT_DESKTOP $XA_CARDINAL 32 1 $current_desktop
}



focuslist_add() {
	local windowid=$1
	local -n window=window_$windowid
	local desktopid=${window[desktop]}
	local -n focuslist=focuslist_$desktopid

	remove_id focuslist $windowid

	log 'Adding window %s to focus list for desktop %s\n' $windowid $desktopid

	focuslist+=( $windowid )
}

focuslist_remove() {
	local windowid=$1
	local -n window=window_$windowid
	local desktopid=${window[desktop]}
	local -n focuslist=focuslist_$desktopid

	log 'Removing window %s from focus list for desktop %s\n' $windowid $desktopid

	remove_id focuslist $windowid
}

calc_overlap() {
	local monitorid=$1
	local windowid=$2
	local -n m=monitor_$monitorid
	local -n w=window_$windowid

	local tx=${ max ${m[x]} ${w[x]}; }
	local ty=${ max ${m[y]} ${w[y]}; }
	local bx=${ min $((m[x] + m[width])) $((w[x] + w[width])); }
	local by=${ min $((m[y] + m[height])) $((w[y] + w[height])); }

	log 'Calc Overlap top-left(%d:%d) bottom-right(%d:%d)\n' \
		$tx $ty $bx $by

	if (( tx >= bx || ty >= by )); then
		echo 0
	else
		echo $(( (bx - tx) * (by - ty) ))
	fi
}

window_monitor() {
	local windowid=$1
	local max_overlap=0
	local overlap m
	local monitorid=${screen_0[primary]}

	log 'Find monitor for window %d, checking %d monitors\n' $windowid ${#monitors[@]}

	for m in "${monitors[@]}"; do
		overlap=${ calc_overlap $m $windowid; }
		log 'Window %d -> Monitor %d Overlap=%d\n' $windowid $m $overlap
		if (( overlap > max_overlap )); then
			max_overlap=overlap
			monitorid=$m
		fi
	done
	echo $monitorid
}
	
map_window() {
	local windowid=$1
	local root=${screen_0[root]}
	local -n window=window_$windowid
	local monitorid

	(( ${window[mapped]} )) && return
	window[mapped]=1

	if [[ ${window[$XA_NET_WM_STRUT_PARTIAL]} ]]; then
		log 'Add strut %s\n' $windowid
		window[type]=strut
		monitorid=${ window_monitor $windowid; }
		log 'target monitor %d\n' $monitorid
		add_strut $monitorid $windowid
		calculate_workarea $monitorid
	else
		window[desktop]=${window[desktop]:-$current_desktop}
		window[type]=${ window_type \
				"${window[type]}" \
				"${window[$XA_NET_WM_WINDOW_TYPE]}"; }
		case ${window[type]} in
			tile)	add_tile $windowid
				layout_tiles ${window[desktop]}
				;;
			float)	add_float $windowid
				;;
		esac
	fi
	
	send_map_window $windowid

	send_change_property $windowid $X_PropModeReplace \
		$XA_WM_STATE $XA_WM_STATE 32 2 $X_WM_NormalState 0

	clientlist_add $windowid

	if (( window[input] )); then
		focuslist_add $windowid
		setfocus $windowid
	fi
}

add_desktop_window() {
	local desktopid=$1
	local windowid=$2
	local -n window=window_$windowid

	window[desktop]=$desktopid
	case ${window[type]} in
		tile)	add_tile $windowid
			layout_tiles $desktopid
			;;
		float)	add_float $windowid
	esac

	if (( window[input] )); then
		focuslist_add $windowid
	fi
}

remove_desktop_window() {
	local windowid=$1
	local unmapped=$2
	local -n window=window_$windowid
	local desktopid=${window[desktop]}
	local monitorid=${desktop_monitor[desktopid]}
	local type=${window[type]}

	log 'Remove %s window %s from desktop %s\n' $type $windowid $desktopid

	case $type in
		strut)  remove_id struts_$monitorid $windowid 
			calculate_workarea $monitorid
			;;
		tile)   list_remove desktop_$desktopid tiles $windowid
			layout_tiles $desktopid
			;;
		floats) list_remove desktop_$desktopid floats $windowid;;
	esac

	if (( window[input] )); then
		focuslist_remove $windowid
		setlastfocus
	fi

	if (( unmapped )); then
		clientlist_remove $windowid
		window[mapped]=0
	fi
	unset 'window[desktop]'
}

remove_id() {
	local arr=$1
	local -n ids=$arr
	local id=$2
	local list=" ${ids[*]} "

	log 'Removing %s from %s\n' $id "$arr"

	ids=( ${list/ $id / } )

	log 'Remove <%s> from <%s> => (%s)\n' "$id" "$list" "${ids[*]}"
}

unmap_window() {
	local windowid=$1
	local -n window=window_$windowid
	local desktopid=${window[desktop]}

	(( ${window[mapped]} )) || return

	remove_desktop_window $windowid 1
}

clientlist_add() {
	local windowid=$1

	clientlist+=( $windowid )

	send_clientlist_append $windowid
}

clientlist_remove() {
	local windowid=$1

	remove_id clientlist $windowid

	send_clientlist_update
}

send_clientlist_append() {
	local windowid=$1
	local root=${screen_0[root]}

	send_change_property $root $X_PropModeAppend $XA_NET_CLIENT_LIST \
		$XA_WINDOW 32 1 $windowid
}

send_clientlist_update() {
	local root=${screen_0[root]}

	if (( ${#clientlist[@]} )); then
		send_change_property $root $X_PropModeReplace \
			$XA_NET_CLIENT_LIST $XA_WINDOW 32 \
			${#clientlist[@]} ${clientlist[@]}
	else
		send_delete_property $root $XA_NET_CLIENT_LIST
	fi
}

send_destroy_window() {
	local windowid=$1

	beginrequest $X_DestroyWindow 0 2
	write32 $windowid
}

handle_unmap_notify() {
	local windowid event
	local root=${screen_0[root]}

	readpad 3
	read32 event
	read32 windowid
	readpad 20

	log '< UnmapNotify for window %s from %s\n' $windowid $event

	(( event == root )) && return

	local -n window=window_$windowid
	(( window[mapped] )) && unmap_window $windowid
}


handle_focus_in() {
	local windowid

	readpad 3
	read32 windowid
	readpad 24

	(( screen_0[active] != windowid )) || return

	local -n window=window_$windowid

	(( window[mapped] )) || return

	log '< FocusIn for window %s\n' $windowid

	focuslist_add $windowid
	set_active_window $windowid
}

change_window_state() {
	local windowid=$1
	local prop=$2
	local action=${3:-$X_NET_WM_STATE_TOGGLE}
	local is_present if_present if_absent

	local -n window=window_$windowid
	local state=${window[state]}

	log 'Change window %s state from (%s) with property %s, action %s\n' \
		$windowid "$state" $prop $action 

	case $action in
		$X_NET_WM_StateRemove ) if_present=1  ;;
		$X_NET_WM_StateAdd )    if_absent=1   ;;
		$X_NET_WM_StateToggle ) if_present=1; if_absent=1 ;;
		* ) fail "Invalid change_window_state action %s\n" $action
	esac
	
	[[ $state =~ " $prop " ]] && is_present=1
	(( if_present && is_present )) && state="${state/ $prop/}"
	(( if_absent && ! is_present )) && state+=" $prop "
	
	window[state]=$state

	log 'Window %s state changed to (%s)\n' $windowid "$state"
}

update_window_state() {
	local windowid=$1
	local action=$2
	local props=( $3 $4 )
	local prop

	for prop in ${props[@]}; do
		(( prop == XA_NET_WM_STATE_FULLSCREEN )) || continue
		change_window_state $windowid $prop $action
	done
}

update_fullscreen() {
	local windowid=$1
	local is_fullscreen
	local want_fullscreen=0
	local fs_prop=$XA_NET_WM_STATE_FULLSCREEN
	local -n window=window_$windowid

	is_fullscreen=$(( ${window[fullscreen]} ))
	[[ ${window[state]} =~ " $fs_prop " ]] && want_fullscreen=1

	if (( ! is_fullscreen && want_fullscreen )); then
		local -n monitor=monitor_${desktop_monitor[window[desktop]]}
		send_set_window_pos $windowid \
			${monitor[x]} ${monitor[y]} \
			${monitor[width]} ${monitor[height]} \
			0 $X_Above
		window[fullscreen]=1
	elif (( is_fullscreen && ! want_fullscreen )); then
		send_set_window_pos $windowid
		window[fullscreen]=0
	fi
}

handle_client_message() {
	local format windowid atom i num_values
	local values=()

	read8 format
	readpad 2
	read32 windowid
	read32 atom

	if (( format%8 )); then
		log 'Invalid format %s\n' $format
		return
	fi

	num_values=$(( 160 / format ))
	for (( i=0 ; i<num_values ; i++ )); do
		read$format value
		values[i]=$value
	done
	log '< ClientMessage %s %s %s [0]=%s [1]=%s ...\n' \
			$format $windowid ${ xa_name $atom; } ${values[0]} ${values[1]}


	case $atom in
	$XA_NET_CURRENT_DESKTOP) 
		select_desktop ${values[0]} 
		;;
	$XA_NET_WM_STATE) 
		update_window_state $windowid \
			${values[0]} ${values[1]} ${values[2]}
		update_fullscreen $windowid
		;;
	esac
}

handle_motion_notify() {
	local detail timestamp root event child root_x root_y
	local event_x event_y state same_screen

	read8 detail
	readpad 2
	read32 timestamp
	read32 root
	read32 event
	read32 child
	read16 root_x
	read16 root_y
	read16 event_x
	read16 event_y
	read16 state
	read8 same_screen
	readpad 1

	log '< MotionNotify root=%d event=%d child=%d root_x=%d root_y=%d\n' \
		$root $event $child $root_x $root_y
}


intern_atoms() {
