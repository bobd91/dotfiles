dump_problems() {
	local d desktops windows all_windows

	for m in "${monitors[@]}"; do
		local -n monitor=monitor_$m
		desktops+=${monitor['desktops']}
	done
	for (( d=0 ; d<desktop_count ; d++ )); do
		local -n desktop=desktop_$d
