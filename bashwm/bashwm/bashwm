register_property_handlers() {
	property_change_handlers[XA_WM_HINTS]=wm_hints_changed
}

send_query_extension() {
	local name=$1

	local name_len=${#name}
	local pad=$(pad4 $name_len)
	
	log '> Send Query Extension for %s\n' $name

	beginrequest $X_QueryExtension 0 $((2+(name_len + pad) / 4)) \
		read_query_extension "$@"
		
	write16 $name_len
	writepad 2
	writechars $name_len $name
	writepad $pad
}

read_query_extension() {
	#local unused=$1
	local name=$2
	local handler=$3
	shift 3
	local present opcode event error

	log '> Read Query Extension for %s\n' $name

	readpad 4
	read8 present
	read8 opcode
	read8 event
	read8 error
	readpad 20

	log 'Extension present=%d opcode=%d event=%d error=%d\n' \
		$present $opcode $event $error

	if (( $present )); then
		declare -Ag "extension_$name=( \
			opcode $opcode \
			event $event \
			error $error)"
	fi

	log 'Calling %s\n' "$handler $present"
	$handler $present "$@"
}

send_get_atom_name() {
	local atom=$1

	log '> GetAtomName %d\n' $atom

	beginrequest $X_GetAtomName 0 2 read_get_atom_name $atom
	write32 $atom
}

read_get_atom_name() {
	#local unused=$1 
	local atom=$2
	local reply_length name_length name

	read32 reply_length
	read16 name_length
	readpad 22
	readchars $name_length name
	readpad4 $name_length

	log '< GetAtomName %d = %s\n' $atom "$name"

	xa_names[$atom]="$name"
}

extensionrequest() {
	local name=$1
	local opcode=$2
	local length=$3
	shift 3

	local -n extension=extension_$name

	beginrequest ${extension[opcode]} $opcode $length "$@"
}

send_rr_query_version() {
	local present=$1
	shift

	if (( $present == 0 )); then
		log 'No RANDR extension, using entire screen\n'
		monitor_config
		update_viewports
	else
		extensionrequest $X_RANDR_NAME $X_RRQueryVersion 3 \
			read_rr_query_version "$@"
		write32 $X_RANDR_MAJOR
		write32 $X_RANDR_MINOR
	fi
}

read_rr_query_version() {
	#local unused=$1

	local major minor
	local RR_MINOR_REQD=2

	readpad 4
	read32 major
	read32 minor
	readpad 16

	if (( major < X_RANDR_MAJOR || (major == X_RANDR_MAJOR && minor < RR_MINOR_REQD) )); then
		log 'RANDR incompatible version (%d.%d), using single monitor\n' \
			$major $minor
		monitor_config
		update_viewports
	else
		log 'RANDR initialized\n'
		rr_setup $major $minor
	fi
}

send_rr_select_input() {
	local mask=$1

	log '> RRSelectInput mask=%d\n' $mask

	extensionrequest $X_RANDR_NAME $X_RRSelectInput 3
	write32 ${screen_0[root]}
	write16 $mask
	writepad 2
}

send_rr_get_monitors() {

	log '> RRGetMonitors\n'

	extensionrequest $X_RANDR_NAME $X_RRGetMonitors 3 read_rr_get_monitors
	write32 ${screen_0[root]}
	write8 1
	writepad 3
}

read_rr_get_monitors() {
	#local unused=$1
	local reply_length timestamp nmonitors tnoutputs
	local m name_atom primary auto noutputs monitorid
	local x y width height width_mm height_mm 
	local o outputs output name

	read32 reply_length
	read32 timestamp
	read32 nmonitors
	read32 tnoutputs
	readpad 12

	log '< RRGetMonitors timestamp %s, last change at %s' $timestamp ${monitor_change_timestamp:-0}

	if (( timestamp <= monitor_change_timestamp )); then
		readpad $((24 * nmonitors + 4 * tnoutputs))
		return
	fi
	monitor_change_timestamp=$timestamp

	log 'Monitors nmonitors=%d tnoutputs=%d\n' $nmonitors $tnoutputs
	
	local prev_monitors=( "${monitors[@]}" )

	monitors=()

	for (( m=0 ; m<nmonitors ; m++ )); do
		read32 name_atom
		read8 primary
		read8 auto
		read16 noutputs
		read16 x
		read16 y
		read16 width
		read16 height
		read32 width_mm
		read32 height_mm

		monitorid=$name_atom

		outputs=()
		for (( o=0 ; o<noutputs ; o++ )); do
			read32 output
			outputs+=($output)
		done
		log 'Monitor %d primary=%d auto=%d noutputs=%d x=%d y=%d width=%d height=%d\n' \
			$name_atom $primary $auto $noutputs $x $y $width $height

		name=${xa_names[name_atom]}
		[[ $name ]] || send_get_atom_name $name_atom

		if (( primary )); then
			screen_0[primary]=$monitorid
			[[ $desktop_monitor ]] || init_desktop_monitor $monitorid
		fi

		monitor_config $monitorid $primary $auto $x $y $width $height $timestamp "${outputs[@]}"
		monitors+=( $monitorid )
	done

	for m in "${prev_monitors[@]}"; do
		local -n monitor=monitor_$m
		if (( m[timestamp] < timestamp )); then
			monitor_remove $m
		fi
		unset 'monitors[$m]'
	done

	update_viewports
}

update_viewports() {
	local i
	local vals=()

	for (( i=0 ; i<desktop_count ; i++ )); do
		local -n monitor=monitor_${desktop_monitor[i]}
		vals+=( ${monitor[x]} ${monitor[y]} )
	done
	send_change_property ${screen_0[root]} $X_PropModeReplace \
		$XA_NET_DESKTOP_VIEWPORT $XA_CARDINAL 32 ${#vals[@]} "${vals[@]}"
}

monitor_remove() {
	local monitorid=$1
	local -n monitor=monitor_$monitorid
	local i
	local primary=${screen_0[primary]}

	for (( i=0 ; i<$desktop_count ; i++ )); do
		if (( desktop_monitor[i] == monitorid )); then
			log 'Setting desktop_monitor[%d]=%d\n' $i $primary
			desktop_monitor[i]=$primary
			list_append monitor_$primary desktops $i
		fi
	done

	local desktopid=${ list_head monitor desktops; }
	[[ $desktopid ]] && hide_desktop $desktopid

	unset 'monitor'
	unset "struts_$monitorid"
}

monitor_config() {
	local monitorid=${1:0}
	local primary=${2:-1}
	local auto=${3:-1}
	local x=${4:-0}
	local y=${5:-0}
	local width=${6:-${screen_0[width_pixels]}}
	local height=${7:-${screen_0[height_pixels]}}
	local timestamp=${8:-0}
	shift 7
	local as_string="$monitorid $primary $auto $x $y $width $height $*"
	local changed=0
	local i
	
	local -n monitor=monitor_$monitorid

	if [[ ${monitor@a} == A ]]; then
		[[ ${monitor[as_string]} == "$as_string" ]] && return
		changed=1
	else
		declare -Ag monitor_$monitorid
		local -n monitor=monitor_$monitorid
		declare -ag struts_$monitorid
	fi
	monitor[as_string]=$as_string
	monitor[name_atom]=$monitorid
	monitor[primary]=$primary
	monitor[auto]=$auto
	monitor[x]=$x
	monitor[y]=$y
	monitor[width]=$width
	monitor[height]=$height
	monitor[timestamp]=$timestamp
	monitor[outputs]=$*

	monitor[desktops]=' '
	for (( i=0 ; i<desktop_count ; i++ )); do
		(( monitorid == desktop_monitor[i] )) || continue
		monitor[desktops]+="$i "
	done

	(( changed )) && monitor_changed $monitorid
}

monitor_changed() {
	local monitorid=$1

	local desktopid=${ list_head monitor_$monitorid desktops; }

	layout_tiles $desktopid
	layout_floats $desktopid
}

rr_setup() {
	#local major=$1
	#local minor=$1

	rr_register_event_handlers
	send_rr_get_monitors
	send_rr_select_input $rr_events
}

rr_register_event_handlers() {
	local -n randr=extension_$X_RANDR_NAME
	local base=${randr[event]}

	event_handlers[base + X_RRNotify]=handle_rr_notify
}

handle_rr_notify() {
	local sub_code

	read8 sub_code
	readpad 2

	case $sub_code in
		$X_RRNotify_OutputChange)
			handle_rr_notify_output_change
			;;
		*)	
			die 'Unexpectected RANDR notify event subcode %d\n' \
				%sub_code
			;;
	esac
}

handle_rr_notify_output_change() {
	local timestamp config_timestamp window output crtc mode
	local rotation connection subpixelorder

	read32 timestamp
	read32 config_timestamp
	read32 window
	read32 output
	read32 crtc
	read32 mode
	read16 rotation
	read8 connection
	read8 subpixelorder

	log 'RRNotify_OutputChange window=%d output=%d connection=%d\n' \
		$window $output $connection
	log 'New config timestamp=%d, prev config timestamp=%d\n' \
		$config_timestamp $monitor_change_timestamp

	(( monitor_change_timestamp < config_timestamp )) || return
	monitor_change_timestamp=$config_timestamp

	send_rr_get_output_info $output 

}

send_rr_get_output_info() {
	local output=$1

	log '> RRGetOutputInfo for output %d\n' $output

	extensionrequest $X_RANDR_NAME $X_RRGetOutputInfo 3 read_rr_get_output_info $output
	write32 $output
	write32 $monitor_change_timestamp
}

read_rr_get_output_info() {
	local status=$1
	local output=$2

	local reply_length timestamp connection num_crtcs num_modes 
	local num_pref_modes len_name name

	read32 reply_length
	read32 timestamp
	readpad 12
	read8 connection
	readpad 1
	read16 num_crtcs
	read16 num_modes
	read16 num_pref_modes
	read16 num_clones
	read16 len_name
	readpad $(( 4 * num_crtcs ))
	readpad $(( 4 * num_modes ))
	readpad $(( 4 * num_clones ))
	readchars $len_name name
	readpad4 $len_name

	log '< RRGetOutputInfo status=%d, output=%d\n' $status $output
	log 'reply_length=%d, timestamp=%d, connection=%d\n' $reply_length $timestamp $connection
	log 'crtcs=%d, mode=%d, pref_modes=%d, clones=%d\n' $num_crtcs $num_modes $num_pref_modes $num_clones
	log 'name=%s (%d chars)\n' "$name" $len_name

	if (( status != X_RRSetConfigSuccess )); then
		log 'RANDR config status error %d\n' $status
		return
	fi

	monitor_change_timestamp=$timestamp

	send_rr_select_input 0
	when_idle output_changed "$name" $connection
}

output_change() {
	local name=$1
	local connection=$2

	custom_output_event "$name" $connection
	send_rr_get_monitors
	send_rr_select_input $rr_events
}

# RandR does not automatically configure hot (un)plugged monitors
#
# To trigger WM update of monitors use the xrandr
# to configure/remove outputs as desired
#
# Use feh (or similar) to set the backgound of new monitors
#
# Note: adding/removing monitors above or to the left of others can result
# in the relocation of existing monitors.  Backgrounds will not be relocated
# and will need to be reset as above.
#
# Window manager bars can be killed/spawned as required
custom_output_event() {
	local name=$1
	local connection=$2

	case $connection in
		$X_RR_Connected)
			log 'Output %s connected\n' "$name"
			;;
		$X_RR_Disconnected)
			log 'Output %s disconnected\n' "$name"
			;;
		$X_RR_UnknownConnection)
			log 'Output %s connection state unknown\n' "$name"
			;;
	esac
}
	
init_desktop_monitor() {
	local monitorid=$1
	local i

	for (( i=0 ; i<desktop_count ; i++ )); do
		desktop_monitor[i]=$monitorid
		declare -Ag "desktop_$i=( dirty 0 )"
	done
}

open_unixsocket() {
	local _fd=$1
	local _dsp=$2

	enable -f /usr/share/bashwm/lib/unixconnect.so unixconnect &&
		unixconnect -v $_fd /tmp/.X11-unix/X$_dsp
}

open_display() {
	local dsp=$1

	open_unixsocket xfd $dsp && return

	exec {xfd}<>/dev/tcp/127.0.0.1/$(( 6000+$dsp )) ||
		die 'Failed to connect to X DISPLAY :%d\n' $dsp
}

run() {
	cache_xa_names
	register_property_handlers

	readxauth < "${XAUTHORITY:-~/.Xauthority}"

	open_display $dsp

	send_setup >&${xfd}
	read_setup_leader <&${xfd}

	if (( $setup_success != 1 )); then
		read_setup_failure <&${xfd}

		log_printf 'Setup Failed '
		(( $setup_success == 2 )) && log_printf '(Auth) '
		log_printf ': %s\n' "$setup_failure_reason"
		return $setup_success
	fi

	read_setup_ok <&${xfd}

	local root=${screen_0[root]}

	intern_atoms >&${xfd}
	send_get_keyboard_mapping >&${xfd}
	send_change_window_events $root $root_events >&${xfd}
	add_wmcheck_window >&${xfd}
	send_query_extension $X_RANDR_NAME send_rr_query_version >&${xfd}

	when_idle $autostart
	when_idle adopt_windows $root $xfd

	event_loop >&${xfd} <&${xfd}
}

dump_all() {
	local m

	log 'Screen:\n'
	log_array screen_0

	for m in "${monitors[@]}"; do
		log_monitor $m
		log '\n'
	done

	dump_problems
}

dump_problems() {
	local d desktops windows all_windows

	for m in "${monitors[@]}"; do
		local -n monitor=monitor_$m
		desktops+=${monitor[desktops]}
	done
	for (( d=0 ; d<desktop_count ; d++ )); do
		local -n desktop=desktop_$d
		windows+=" ${desktop[tiles]} ${desktop[floats]} "
		[[ " $desktops " =~ " $d " ]] && continue
		log 'Orphaned desktop %d (%s):\n' $d "$desktops"
		log_desktop $d
	done

	for w in "${!window_@}"; do
		local -n window=$w
		[[ ${window[type]} == tile || ${window[type]} == float ]] ||
			continue
		[[ $windows =~ " ${w#window_} " ]] && continue
		log 'Orphaned window:\n'
		log_array $w
	done
}

log_monitor() {
	local m=$1
	local d

	log 'Monitor:\n'
	log_array monitor_$m 
	log 'Struts:\n'
	log_array struts_$m

	local -n monitor=monitor_$m
	local desktops=${monitor[desktops]}
	log 'Desktops:\n'
	for d in $desktops; do
		log_desktop $d
	done
}

log_desktop() {
	local d=$1
	local desktop t f

	log 'Desktop %d (on monitor %d):\n' $d ${desktop_monitor[$d]}
	local -n desktop=desktop_$d
	
	log 'Tiled Windows:\n'
	for t in ${desktop[tiles]}; do
		log 'Window:\n'
		log_array window_$t
	done
	log 'Floating Windows:\n'
	for f in ${desktop[floats]}; do
		log 'Window:\n'
		log_array window_$f
	done
}

source_config() {
	local p
	if [[ $XDG_CONFIG_HOME ]]; then
		p="$XDG_CONFIG_HOME/bashwm"
	else 
		p="~/.config/bashwm"
	fi
	p+=':/etc/bashwm:/usr/share/bashwm'
	source -p "$p" config.sh 2>/dev/null || log 'Config file not found'
}

require() {
	[[ -v required_$1 ]] && return

	source -p /usr/share/bashwm/lib "$1.sh" || 
		die 'Failed to load required library: %s\n' "$1.sh"

	printf -v "required_$1" 1
}

	

DISPLAY=${DISPLAY:-:0}

dsp=${1:-${DISPLAY:1}}

LC_CTYPE=C

require xcore
require xrandr

proto_major=11
proto_minor=0

X_WM_NormalState=0
X_WM_WithdrawnState=1
X_WM_IconicState=3

X_NET_WM_StateRemove=0
X_NET_WM_StateAdd=1
X_NET_WM_StateToggle=2

desktop_count=4
current_desktop=0

wm_border_width=1
wm_border_active=$(( 16#005577 ))
wm_border_inactive=$(( 16#444444 ))

monitor_change_timestamp=0
replies_pending=0
idle_handlers=()
property_change_handlers=()

declare -a keysym_command_map=(
	[$XK_1]="$X_Mod4Mask:select_desktop 0,$((X_Mod4Mask|X_ShiftMask)):move_to_desktop 0,$((X_Mod4Mask|X_ControlMask)):desktop_to_monitor 0"
	[$XK_2]="$X_Mod4Mask:select_desktop 1,$((X_Mod4Mask|X_ShiftMask)):move_to_desktop 1,$((X_Mod4Mask|X_ControlMask)):desktop_to_monitor 1"
	[$XK_3]="$X_Mod4Mask:select_desktop 2,$((X_Mod4Mask|X_ShiftMask)):move_to_desktop 2,$((X_Mod4Mask|X_ControlMask)):desktop_to_monitor 2"
	[$XK_4]="$X_Mod4Mask:select_desktop 3,$((X_Mod4Mask|X_ShiftMask)):move_to_desktop 3,$((X_Mod4Mask|X_ControlMask)):desktop_to_monitor 3"
	[$XK_Return]="$X_Mod4Mask:new_terminal"
	[$XK_b]="$X_Mod4Mask:new_browser"
	[$XK_c]="$((X_Mod4Mask|X_ShiftMask)):delete_window"
	[$XK_d]="$((X_Mod4Mask|X_ShiftMask)):dump_all"
	[$XK_p]="$X_Mod4Mask:show_menu"
	[$XK_q]="$((X_Mod4Mask|X_ShiftMask)):wm_exit"
)

root_events=$(( $X_SubstructureRedirectMask | 
		    $X_StructureNotifyMask |      
		    $X_SubstructureNotifyMask |   
		    $X_PropertyChangeMask i))

client_events=$(( $X_EnterWindowMask |
			$X_FocusChangeMask |
			$X_StructureNotifyMask |
			$X_PropertyChangeMask ))

rr_events=$(( $X_RROutputChangeNotifyMask ))

event_handlers[X_Reply]=handle_reply
event_handlers[X_ConfigureNotify]=handle_configure_notify
event_handlers[X_CreateNotify]=handle_create_notify
event_handlers[X_MapNotify]=handle_map_notify
event_handlers[X_UnmapNotify]=handle_unmap_notify
event_handlers[X_DestroyNotify]=handle_destroy_notify
event_handlers[X_ConfigureRequest]=handle_configure_request
event_handlers[X_PropertyNotify]=handle_property_notify
event_handlers[X_EnterNotify]=handle_enter_notify
event_handlers[X_KeyPress]=handle_key_press
event_handlers[X_MapRequest]=handle_map_request
event_handlers[X_FocusIn]=handle_focus_in
event_handlers[X_ClientMessage]=handle_client_message

source_config

logfile=${logfile:-~/.cache/bashwm/bashwm.log}
if [[ -f $logfile ]]; then
	>| "$logfile"
else
	mkdir -p ${logfile%/*}
fi

run
