handle_map_request() {
	local windowid

	beginevent 'MapRequest'
	{
	readpad 1
	read16 server_seqno
	readpad 4
	read32 windowid
	readpad 20
	} <&${xfd}

	process_map_request $windowid
}

process_map_request() {
	local windowid=$1

	beginprocess 'MapRequest %s' $windowid

	# Pass on the map request if we are not managing window
	if ! is_object window_$windowid; then
		x_send_map_window $windowid
		return
	fi

	local -n window=window_$windowid
	if (( window['mapped'] == W_NotMapped )); then
		window['mapped']=$W_MapRequested
		pre_map $windowid map_window
	elif (( window['mapped'] == W_Unmapped )); then
		map_window $windowid
	fi
}

max() {
	(( $1 > $2 )) && echo $1 && return
	echo $2
}

min() {
	(( $1 < $2 )) && echo $1 && return
	echo $2
}

calculate_workarea() {
	local monitorid=$1
	log 'Calculate work area for monitor %s\n' $monitorid

	local -n monitor=monitor_$monitorid

	is_object monitor || die 'No such monitor %s\n' $monitorid

	local left=0
	local right=0
	local top=0
	local bottom=0
	local x=0
	local y=0
	local width=${monitor['width']}
	local height=${monitor['height']}
	local wa_x=${monitor['wa_x']:-0}
	local wa_y=${monitor['wa_y']:-0}
	local wa_width=${monitor['wa_width']:-0}
	local wa_height=${monitor['wa_height']:-0}
	local root=${screen_0['root']}
	local id window strut sstrut
	
	log 'Struts: %s\n' "${monitor['struts']}"

	for id in ${monitor['struts']}; do
		log_array window_$id
		local -n window=window_$id
		sstrut="${window[$XA_NET_WM_STRUT_PARTIAL]}"
		log 'Strut: %s\n' "$sstrut"
		strut=( $sstrut )
		(( ${#strut[@]} >= 4 )) || continue
		left=${ max $left ${strut[0]}; }
		right=${ max $right ${strut[1]}; }
		top=${ max $top ${strut[2]}; }
		bottom=${ max $bottom ${strut[3]}; }
	done
	x=$left
	y=$top
	(( width -= left + right ))
	(( height -= top + bottom ))
	
	if (( monitor['wa_x'] == x &&
			monitor['wa_y'] == y &&
			monitor['wa_width'] == width && 
			monitor['wa_height'] == height )); then
		return
	fi

	log 'Work Area for Monitor %s: x=%s y=%s width=%s height=%s\n' \
		$monitorid $x $y $width $height

	monitor['wa_x']=$x
	monitor['wa_y']=$y
	monitor['wa_width']=$width
	monitor['wa_height']=$height

	desktop_dirty ${monitor['desktops']}

}

desktop_dirty() {
	local d

	for d in "$@"; do
		log 'desktop_dirty: <%s>\n' $d
		local -n desktop=desktop_$d
		desktop['dirty']=1
	done
}

update_net_workarea() {
	local vals=()
	local i
	for (( i=0 ; i<desktop_count ; i++ )); do
		local -n monitor=monitor_${desktop_monitor[i]}
		vals+=( ${monitor['wa_x']} \
			${monitor['wa_y']} \
			${monitor['wa_width']} \
			${monitor['wa_height']} )
	done

	[[ ${vals[*]} != ${properties['workarea']} ]] || return

	properties['workarea']=${vals[*]}

	log 'Work area values %s\n' "$properties['workarea']"

	x_send_change_property ${screen_0['root']} $X_PropModeReplace \
		$XA_NET_WORKAREA $XA_CARDINAL 32 ${#vals[@]} "${vals[@]}"
}

setlastfocus() {
	local -n focuslist=focuslist_$current_desktop

	setfocus ${focuslist[@]: -1}
}

setfocus() {
	local windowid=$1
	local timestamp=${2:-$X_CurrentTime}

	if (( $windowid )); then
		local -n window=window_$windowid

		log 'Set Focus for window %s\n' $windowid

		log 'Window %s[mapped] = %s\n' $windowid ${window['mapped']} 

		(( window['mapped'] == $W_Mapped )) || return

		if (( window['take_focus'] )); then
			x_send_protocol_message $windowid $XA_WM_TAKE_FOCUS
		else
			x_send_set_input_focus $windowid $timestamp
		fi
	else
		log 'Set focus to PointerRoot\n'

		set_active_window 0
		x_send_set_input_focus $X_PointerRoot $timestamp
	fi
}

set_active_window() {
	local windowid=$1
	local active_window=${screen_0['active']:-0}

	log 'SetActiveWindow <%s> -> <%s>\n' "$active_window" "$windowid"

	(( $windowid != $active_window )) || return

	if (( active_window )); then
		local -n window=window_$active_window
		if is_object window; then
			set_border_color $active_window $wm_border_inactive
		fi
	fi

	active_window=$windowid

	screen_0['active']=$active_window
	if (( active_window )); then
		local -n window=window_$active_window
		set_border_color $active_window $wm_border_active
		x_send_change_property ${screen_0['root']} $X_PropModeReplace \
			$XA_NET_ACTIVE_WINDOW $XA_WINDOW 32 1 $active_window
		set_current_desktop ${window['desktop']}
	else
		x_send_delete_property ${screen_0['root']} $XA_NET_ACTIVE_WINDOW
	fi
}

set_current_desktop() {
	desktopid=$1

	(( desktopid != current_desktop )) || return

	log 'SetCurrentDesktop <%s> -> <%s>\n' $current_desktop $desktopid

	current_desktop=$desktopid

	x_send_change_property ${screen_0['root']} $X_PropModeReplace \
		$XA_NET_CURRENT_DESKTOP $XA_CARDINAL 32 1 $current_desktop
}

focuslist_add() {
	local windowid=$1
	local -n window=window_$windowid
	local desktopid=${window['desktop']}
	local -n focuslist=focuslist_$desktopid


	remove_id focuslist $windowid

	log 'Adding window %s to focus list for desktop %s\n' $windowid $desktopid

	focuslist+=( $windowid )
}

focuslist_remove() {
	local windowid=$1
	local -n window=window_$windowid
	local desktopid=${window['desktop']}
	local -n focuslist=focuslist_$desktopid

	log 'Removing window %s from focus list for desktop %s\n' $windowid $desktopid

	remove_id focuslist $windowid
}

calc_overlap() {
	local monitorid=$1
	local windowid=$2
	local -n m=monitor_$monitorid
	local -n w=window_$windowid

	local tx=${ max ${m[x]} ${w[x]}; }
	local ty=${ max ${m[y]} ${w[y]}; }
	local bx=${ min $((m[x] + m[width])) $((w[x] + w[width])); }
	local by=${ min $((m[y] + m[height])) $((w[y] + w[height])); }

	log 'Calc Overlap top-left(%d:%d) bottom-right(%d:%d)\n' \
		$tx $ty $bx $by

	if (( tx >= bx || ty >= by )); then
		echo 0
	else
		echo $(( (bx - tx) * (by - ty) ))
	fi
}

window_monitor() {
	local windowid=$1
	local max_overlap=0
	local overlap m
	local monitorid=${screen_0['primary']}

	log 'Find monitor for window %d, checking %d monitors\n' $windowid ${#monitors[@]}

	for m in "${monitors[@]}"; do
		overlap=${ calc_overlap $m $windowid; }
		log 'Window %d -> Monitor %d Overlap=%d\n' $windowid $m $overlap
		if (( overlap > max_overlap )); then
			max_overlap=overlap
			monitorid=$m
		fi
	done
	echo $monitorid
}
	
map_window() {
	local windowid=$1
	local root=${screen_0['root']}
	local -n window=window_$windowid
	local monitorid desktopid
	local manage=1

	log_array window

	(( window['mapped'] != W_Mapped )) || return

	if [[ ${window[$XA_NET_WM_STRUT_PARTIAL]} ]]; then
		log 'Add strut %s\n' $windowid
		window['type']=strut
		monitorid=${ window_monitor $windowid; }
		log 'target monitor %d\n' $monitorid
		window['monitor']=$monitorid
		list_append monitor_$monitorid struts $windowid
		calculate_workarea $monitorid
		layout_monitor $monitorid
		update_net_workarea
		manage=0
	else
		desktopid=${window['desktop']:-$current_desktop}
		window['desktop']=$desktopid
		set_window_type $windowid
		case ${window['type']} in
			tile)
				log 'Add tile %s\n' $windowid
				list_push desktop_$desktopid tiles $windowid
				window['border_width']=$wm_border_width
				layout_tiles $desktopid
				;;
			float)
				log 'Add float %s\n' $windowid
				list_push desktop_$desktopid floats $windowid
				layout_floats $desktopid
				;;
		esac
	fi
	
	is_object window && window['mapped']=$W_Mapped

	x_send_map_window $windowid

	(( manage )) || return

	x_send_change_property $windowid $X_PropModeReplace \
		$XA_WM_STATE $XA_WM_STATE 32 2 $X_WM_NormalState 0

	clientlist_add $windowid

	if (( window['input'] )); then
		focuslist_add $windowid
		setfocus $windowid
	fi
}

add_desktop_window() {
	local desktopid=$1
	local windowid=$2
	local -n window=window_$windowid

	window['desktop']=$desktopid
	case ${window['type']} in
		tile)
			list_push desktop_$desktopid tiles $windowid
			;;
		float)
			list_push desktop_$desktopid floats $windowid
			;;
	esac

	desktop_dirty $desktopid

	if (( window['input'] )); then
		focuslist_add $windowid
	fi
}

remove_desktop_window() {
	local windowid=$1
	local unmapped=$2
	local -n window=window_$windowid

	local desktopid=${window['desktop']}
	[[ $desktopid ]] || return

	local monitorid=${desktop_monitor[desktopid]}
	local type=${window['type']}

	log 'Remove %s window %s from desktop %s\n' $type $windowid $desktopid

	case $type in
		tile)   
			list_remove desktop_$desktopid tiles $windowid
			desktop_dirty $desktopid
			;;
		float) 
			list_remove desktop_$desktopid floats $windowid
			desktop_dirty $desktopid
			;;
	esac

	if (( window['input'] )); then
		log 'Remove window %s from focuslist (active=%s)\n' \
			$windowid ${screen_0['active']}

		focuslist_remove $windowid
	fi

	if (( unmapped )); then
		window['mapped']=$W_Unmapped
	fi
	unset 'window[desktop]'
}

is_object() {
	local -n _o=$1
	[[ ${_o@a} == A ]]
}

remove_window() {
	local windowid=$1
	local desktopid

	local -n window=window_$windowid

	case ${window['type']} in
		strut)
			monitorid=${window['monitor']}
			local -n monitor=monitor_$monitorid
			if is_object monitor; then
				list_remove monitor struts $windowid
				calculate_workarea $monitorid
				layout_monitor $monitorid
				update_net_workarea
			fi
			;;
		tile|float)
			desktopid=${window['desktop']}
			if [[ -z $desktopid ]]; then
				log 'Removing window %s without desktop\n' $windowid
				log_array window
				return
			fi
			remove_desktop_window $windowid 0
			layout_desktop $desktopid
			clientlist_remove $windowid
			;;
	esac

	unset 'window'
}

remove_id() {
	local arr=$1
	local -n ids=$arr
	local id=$2
	local list=" ${ids[*]} "

	log 'Removing %s from %s\n' $id "$arr"

	ids=( ${list/ $id / } )

	log 'Remove <%s> from <%s> => (%s)\n' "$id" "$list" "${ids[*]}"
}

clientlist_add() {
	local windowid=$1

	[[ $clientlist =~ " $windowid " ]] && return

	clientlist+=( $windowid )

	send_clientlist_append $windowid
}

clientlist_remove() {
	local windowid=$1

	[[ $clientlist =~ " $windowid " ]] || return

	remove_id clientlist $windowid

	send_clientlist_update
}

send_clientlist_append() {
	local windowid=$1
	local root=${screen_0['root']}

	x_send_change_property $root $X_PropModeAppend $XA_NET_CLIENT_LIST \
		$XA_WINDOW 32 1 $windowid
}

send_clientlist_update() {
	local root=${screen_0['root']}

	if (( ${#clientlist[@]} )); then
		x_send_change_property $root $X_PropModeReplace \
			$XA_NET_CLIENT_LIST $XA_WINDOW 32 \
			${#clientlist[@]} ${clientlist[@]}
	else
		x_send_delete_property $root $XA_NET_CLIENT_LIST
	fi
}

x_send_destroy_window() {
	local windowid=$1

	beginrequest 'DestroyWindow %s' $windowid
	{
	write8 $X_DestroyWindow
	write8 0
	write16 2
	write32 $windowid
	} >&${xfd}
}

handle_unmap_notify() {
	local windowid event
	local root=${screen_0['root']}

	beginevent 'UnmapNotify'
	{
	readpad 1
	read16 server_seqno
	read32 event
	read32 windowid
	readpad 20
	} <&${xfd}


	(( event == root )) || return

	local -n window=window_$windowid
	is_object window || return

	# We may have already handled the unmapping
	(( window['mapped'] == $W_Mapped )) || return

	process_unmap_notify $windowid
}

process_unmap_notify() {
	local windowid=$1

	beginprocess 'UnmapNotify %s' $windowid

	remove_window $windowid
}

focus_detail=( Ancestor Virtual Inferior Nonlinear NonlinearVirtual Pointer PointerRoot None)
focus_mode=( Normal Grab Ungrab WhileGrabbed ) 

handle_focus_in() {
	local detail windowid mode 

	beginevent 'FocusIn'
	{
	read8 detail
	read16 server_seqno
	read32 windowid
	read8 mode
	readpad 23
        } <&${xfd}

	(( mode == X_NotifyNormal || mode == X_NotifyWhileGrabbed )) || return
	
	(( screen_0['active'] != windowid )) || return

	local -n window=window_$windowid

	# Only interested if we manage the window and it is a mapped tile or float
	is_object window &&
		(( window['mapped'] == W_Mapped )) &&
		[[ ${window['type']} =~ tile|float ]] || return

	process_focus_in $windowid
}

process_focus_in() {
	local windowid=$1

	beginprocess 'FocusIn %s (%s %s)' \
		$windowid ${focus_detail[$detail]} ${focus_mode[$mode]}

	focuslist_add $windowid
	set_active_window $windowid
}

change_window_state() {
	local windowid=$1
	local prop=$2
	local action=${3:-$X_NET_WM_STATE_TOGGLE}
	local is_present if_present if_absent

	local -n window=window_$windowid
	local state=${window['state']}

	log 'Change window %s state from (%s) with property %s, action %s\n' \
		$windowid "$state" $prop $action 

	case $action in
		$X_NET_WM_StateRemove ) if_present=1  ;;
		$X_NET_WM_StateAdd )    if_absent=1   ;;
		$X_NET_WM_StateToggle ) if_present=1; if_absent=1 ;;
		* ) fail "Invalid change_window_state action %s\n" $action
	esac
	
	[[ $state =~ " $prop " ]] && is_present=1
	(( if_present && is_present )) && state="${state/ $prop/}"
	(( if_absent && ! is_present )) && state+=" $prop "
	
	window['state']=$state

	log 'Window %s state changed to (%s)\n' $windowid "$state"
}

update_window_state() {
	local windowid=$1
	local action=$2
	local props=( $3 $4 )
	local prop

	for prop in ${props[@]}; do
		(( prop == XA_NET_WM_STATE_FULLSCREEN )) || continue
		change_window_state $windowid $prop $action
	done
}

update_fullscreen() {
	local windowid=$1
	local is_fullscreen
	local want_fullscreen=0
	local fs_prop=$XA_NET_WM_STATE_FULLSCREEN
	local -n window=window_$windowid

	is_fullscreen=$(( ${window['fullscreen']} ))
	[[ ${window['state']} =~ " $fs_prop " ]] && want_fullscreen=1

	if (( ! is_fullscreen && want_fullscreen )); then
		local -n monitor=monitor_${desktop_monitor[window['desktop']]}
		set_window_pos $windowid \
			${monitor['x']} ${monitor['y']} \
			${monitor['width']} ${monitor['height']} \
			0 $X_Above
		window['fullscreen']=1
	elif (( is_fullscreen && ! want_fullscreen )); then
		set_window_pos $windowid
		window['fullscreen']=0
	fi
}

handle_client_message() {
	local format windowid atom i num_values 
	local values=()

	beginevent 'ClientMessage'
	{
	read8 format
	read16 server_seqno
	read32 windowid
	read32 atom

	(( format==8 || format==16 || format==32 )) ||
		die 'Invalid format %s\n' $format

	num_values=$(( 160 / format ))
	for (( i=0 ; i<num_values ; i++ )); do
		readi$format value
		values[i]=$value
	done
	} <&${xfd}

	process_client_message $windowid $atom "${values[@]}"
}

process_client_message() {
	local windowid=$1
	local atom=$2
	shift 2

	beginprocess 'ClientMessage %s %s %s [0]=%s [1]=%s ...\n' \
			$format $windowid ${ xa_name $atom; } ${values[0]} ${values[1]}

	case $atom in
	$XA_NET_CURRENT_DESKTOP) 
		select_desktop $1 
		;;
	$XA_NET_WM_STATE)
		is_object window_$windowid || return
		update_window_state $windowid $1 $2 $3
		update_fullscreen $windowid
		;;
	esac
}

