}

handle_configure_request() {
	local stack_mode parent window windowid sibling 
	local x y width height border_width value_mask n

	read8 stack_mode
	readpad 2
	read32 parent
	read32 windowid
	read32 sibling
	read16 x
	read16 y
	read16 width
	read16 height
	read16 border_width
	read16 value_mask
	readpad 4

	log '> ConfigureWindow %s\n' $windowid

	local -n window=window_$windowid

	n=$(count_bits $value_mask)
	beginrequest $X_ConfigureWindow 0 $(( 3+n ))
	write32 $windowid
	write16 $value_mask
	writepad 2
	(( $value_mask & $X_CWX )) && 
		write32 $x && 
		window[x]=$x
	(( $value_mask & $X_CWY )) && 
		write32 $y && 
		window[y]=$y
	(( $value_mask & $X_CWWidth )) && 
		write32 $width &&
		window[width]=$width
	(( $value_mask & $X_CWHeight )) &&
		write32 $height &&
		window[height]=$height
	(( $value_mask & $X_CWBorderWidth )) &&
		write32 $border_width &&
		window[border_width]=$border_width
	(( $value_mask & $X_CWSibling )) && 
		write32 $sibling
	(( $value_mask & $X_CWStackMode )) && 
		write32 $stack_mode
}

handle_property_notify() {
	local windowid atom state

	readpad 3
	read32 windowid
	read32 atom
	readpad 4
	read8 state
	readpad 15

	log '< PropertyNotify for window %s, %s, state %s\n' \
		$windowid ${ xa_name $atom; } $state
}

handle_enter_notify() {
	local detail timestamp windowid mode flags

	read8 detail
	readpad 2
	read32 timestamp
	readpad 4
	read32 windowid
	readpad 14
	read8 mode
	read8 flags

	log '< Enter Notify on window %s detail %s mode %s flags %s\n' \
		$windowid $detail $mode $flags

	# Non-root window wanted but only if 
	# enter was not from child to parent and was triggered by motion 
	if (( $windowid != ${screen_0[root]} &&
			( detail == X_NotifyInferior || 
			  mode != X_NotifyNormal ) )); then
		return
	fi

	focuslist_add $windowid
	setfocus $windowid $timestamp
}

handle_destroy_notify() {
