x_send_intern_atom() {
	local name=$1
	local name_len=${#name}
	local name_pad=$(pad4 name_len)
	local req_len=$(( 2 + (name_len + name_pad) / 4 ))
	
	beginrequest 'InternAtom %s' $name
	setreplyhandler x_read_intern_atom $name
	{
	write8 $X_InternAtom
	write8 0
	write16 $req_len 
	write16 $name_len
	writepad 2
	writechars $name_len $name
	writepad $name_pad
	} >&${xfd}
}

x_read_get_keyboard_mapping() {
	local keysyms_per=$1
	local min_keycode=${server['min_keycode']}
	local max_keycode=${server['max_keycode']}
	local keycodes=$(( 1 + max_keycode - min_keycode ))
	local key_mappings=$(( keysyms_per * keycodes ))
	local keycode keycodesym keycmds keycmda keycmd mask

	beginreply 'KeyboardMapping'

	{
	read32 reply_length
	(( reply_length == key_mappings )) ||
		die 'Got %s keboard mappings, expected %s\n' \
			$reply_length $key_mappings
	readpad 24

	for (( keycode=min_keycode ; keycode<=max_keycode ; keycode++ )); do
		# only interested in the first keysym
		read32 keycodesym
		readpad $(( 4 * (keysyms_per - 1) ))

		keycmds=${keysym_command_map[keycodesym]}
		[[ $keycmds ]] && keycode_command_map[keycode]=$keycmds
	done
	} <&${xfd}

	for keycode in ${!keycode_command_map[@]}; do
		log 'Map keycode=%s to command=%s\n' \
			$keycode "${keycode_command_map[keycode]}"
		IFS=',' read -ra keycmds <<< "${keycode_command_map[keycode]}" 
		for keycmd in "${keycmds[@]}"; do
			mask="${keycmd%:*}"
			x_send_grab_key $keycode $mask
		done
	done
}

cache_xa_names() {
	local names=( ATOM CARDINAL COLORMAP CARDINAL INTEGER PIXMAP \
		STRING VISUALID WINDOW WM_COMMAND WM_HINTS WM_NAME \
		WM_NORMAL_HINTS WM_SIZE_HINTS WM_CLASS WM_TRANSIENT_FOR )
	local name xa_id

	for name in ${names[@]}; do
		xa_id="XA_$name"
		xa_names[${!xa_id}]=$name
	done
}

xa_name() {
	xa_id=$1
	echo ${xa_names[xa_id]:-$xa_id}
}

x_read_intern_atom() {
	#local unused=$1
	shift
	local name=$1

	local root=${screen_0['root']}
	local xaname=$name

	beginreply 'InternAtom %s' $name
	{
	readpad 4
	read32 atom
	readpad 20
	} <&${xfd}

	[[ ${xaname::1} == '_' ]] || xaname="_$xaname"
	xaname="XA$xaname"
	printf -v $xaname $atom
	xa_names[atom]=$name

	case $name in
		_NET_CURRENT_DESKTOP) 
			x_send_change_property $root $X_PropModeReplace $atom $XA_CARDINAL 32 1 $current_desktop 
			;;
		_NET_NUMBER_OF_DESKTOPS) 
			x_send_change_property $root $X_PropModeReplace $atom $XA_CARDINAL 32 1 $desktop_count
			;;
		WM_PROTOCOLS)
			property_change_handlers[XA_WM_PROTOCOLS]=wm_protocols_changed
	esac
}

set_wm_class() {
	local instance=$1
	local class=$2
	local len_instance=${#instance}
	local len_class=${#class}
	local bytes=()
	local i

	for (( i=0 ; i<len_instance ; i++ )); do
		bytes+=( "'${instance:i:1}" )
	done
	bytes+=( 0 )
	for (( i=0 ; i<len_class ; i++ )); do
		bytes+=( "'${class:i:1}" )
	done

	x_send_change_property ${screen_0['root']} $X_PropModeReplace $XA_WM_CLASS \
		$XA_WM_CLASS 8 ${#bytes[@]} "${bytes[@]}"
}

# Do not call to set WM_CLASS, call set_wm_class 'instance' 'class' 
x_send_change_property() {
	local windowid=$1
	local mode=$2
	local prop_atom=$3
	local prop_type=$4
	local prop_bits=$5
	local prop_count=$6

	shift 6
	local prop_value=( "$@" )

	local bytes=$(( prop_count * prop_bits / 8 ))
	local pad=${ pad4 $bytes; }
	local req_len=$(( 6 + (bytes + pad) / 4 ))
	local i

	(( prop_bits==8 || prop_bits==16 || prop_bits==32 )) ||
		die 'Invalid format %s' $prop_bits

	beginrequest 'ChangeProperty %s for window %s' \
		${ xa_name $prop_atom; } $windowid
	{
	write8 $X_ChangeProperty
	write8 $mode
	write16 $req_len
	write32 $windowid
	write32 $prop_atom
	write32 $prop_type
	write8 $prop_bits
	writepad 3
	write32 $prop_count

	case $prop_type in
		$XA_STRING) writechars $prop_count $prop_value
			;;
		$XA_UTF8_STRING) writeutf8 $prop_count $prop_value
			;;
		*)	for (( i=0 ; i<$prop_count ; i++ )); do
				writei$prop_bits ${prop_value[i]}
			done
			;;
	esac
	writepad $pad
	} >&${xfd}

	log 'mode %s reqlen %s windowid %s prop_atom %s prop_type %s\n' \
		$mode $req_len $windowid $prop_atom $prop_type
	log 'prop_bits %s prop_count %s prop_values <%s>\n' \
		$prop_bits $prop_count "${prop_value[*]}"

}

x_send_get_property() {
	local windowid=$1
	local atom=$2
	local atom_type=$3
	local length=$4
	local start=${5:-0}

	beginrequest 'GetProperty %s for window %s' ${ xa_name $atom; } $windowid
	setreplyhandler x_read_get_property $windowid $atom $start
	{
	write8 $X_GetProperty
	write8 0
	write16 6
	write32 $windowid
	write32 $atom
	write32 $atom_type
	write32 $start
	write32 $length
	} >&${xfd}	
}

x_read_get_property() {
	local format=$1
	local windowid=$2
	local atom=$3
	local start=$4
	local reply_len atom_type length bytes_after
	local item val byte_count i

	beginreply 'GetProperty %s for window %s' ${ xa_name $atom; } $windowid
	{
	read32 reply_len
	read32 atom_type
	read32 bytes_after
	read32 length
	readpad 12

	(( $length  )) || return

	(( format==8 || format==16 || format==32 )) || 
		die 'Invalid format %s' $format

	local -n window=window_$windowid

	if (( $start )); then
		val=" ${window[$atom]}"
	fi

	case $atom_type in
		$XA_STRING)
			if (( atom == XA_WM_CLASS )); then
				# Special handling for WM_CLASS 
				# 2 Null terminated strings
				readstring item
				val+="${item@Q}"
				readchars $((length - ${#item} - 1)) item
				val+=" ${item@Q}"
			else
				readchars $length item
				val+="$item"
			fi
			;;
		$XA_UTF8_STRING)
			readutf8 $length item
			val+="$item"
			;;
		*)
			for (( i=0 ; i < length ; i++ )); do
				readi${format} item
				val+=" $item"
			done
			val=${val:1}
			;;
	esac

	byte_count=$(( length * format / 8 ))
	readpad4 $byte_count
	} <&${xfd}

	window[$atom]="$val"

	if (( bytes_after )); then
		(( start += byte_count ))
		(( bytes_after -= byte_count ))
		x_send_get_property $windowid $atom $atom_type $bytes_after $start
	else
		property_changed $windowid $atom
	fi
}

x_send_set_input_focus() {
	local windowid=$1
	local timestamp=$2

	beginrequest 'SetInputFocus %s' $windowid
	{
	write8 $X_SetInputFocus
	write8 $X_PointerRoot
	write16 3
	write32 $windowid
	write32 $timestamp
	} >&${xfd}
}

x_send_protocol_message() {
	local windowid=$1
	local protocol=$2

	beginrequest 'SendEvent ClientMessage %s, Protocol %s' $windowid $protocol 
	{
	write8 $X_SendEvent
	write8 0
	write16 11
	write32 $windowid
	write32 $X_NoEventMask

	write8 $X_ClientMessage
	write8 32
	write16 0
	write32 $windowid
	write32 $XA_WM_PROTOCOLS
	write32 $protocol
	writepad 16
	} >&${xfd}
}

wm_protocols_changed() {
	local windowid=$1
	local -n window=window_$windowid
	local protocols=${window[$XA_WM_PROTOCOLS]}
	local protocol

	log 'Protocols changed for window %s to %s\n' $windowid "${protocols[*]}"

	for protocol in $protocols; do
		case $protocol in
			$XA_WM_TAKE_FOCUS)    window['take_focus']=1 ;;
			$XA_WM_DELETE_WINDOW) window['delete_window']=1 ;;
			*) ;;
		esac
	done
}

wm_hints_changed() {
	local windowid=$1
	local -n window=window_$windowid
	local hints=( ${window[$XA_WM_HINTS]} 1 1 )

	log 'Hints changed for window %s to %s\n' $windowid "${hints[*]}"

	window['input']=$(( hints[0] & 1 && hints[1] ))
}

property_changed() {
	local windowid=$1
	local atom=$2
	local handler="${property_change_handlers[atom]}"

	log 'Window %s Property %d handled by %s\n' $windowid $atom $handler
	
	[[ $handler ]] && $handler $windowid $atom
}

x_send_delete_property() {
	local windowid=$1
	local atom=$2

	beginrequest 'DeleteProperty %s for window %s' ${ xa_name $atom; } $windowid
	{
	write8 $X_DeleteProperty
	write8 0
	write16 3
	write32 $windowid
	write32 $atom
	} >&${xfd}
}

x_send_query_tree() {

	beginrequest 'QueryTree'
	setreplyhandler x_read_query_tree "$@"
	{
	write8 $X_QueryTree
	write8 0
	write16 2
	write32 ${screen_0['root']}
	} >&${xfd}
}

x_send_get_window_attributes() {
	local windowid=$1

	beginrequest 'GetWindowAttributes %s' $windowid
	setreplyhandler x_read_get_window_attributes $windowid
	{
	write8 $X_GetWindowAttributes
	write8 0
	write16 2
	write32 $windowid
	} >&${xfd}
}

x_send_get_geometry() {
	local windowid=$1

	beginrequest 'GetGeometry %s' $windowid
	setreplyhandler x_read_get_geometry "$@"
	{
	write8 $X_GetGeometry
	write8 0
	write16 2
	write32 $windowid
	} >&${xfd}
}

x_read_get_geometry() {
	#local unused=$1
	local windowid=$2
	shift 2

	local x y width height border_width

	readpad 8
	readi16 x
	readi16 y
	read16 width
	read16 height
	read16 border_width
	readpad 10

	"$@" $windowid $x $y $width $height $border_width
}

x_read_query_tree() {
	#local unused=$1
	shift

	local num_windows windowid i

	beginreply 'QueryTree'
	{
	readpad 12
	read16 num_windows
	readpad 14

	local windows=()
	for (( i=0 ; i<num_windows ; i++ )); do
		read32 windowid
		windows+=( $windowid )
	done
	} <&${xfd}

	"$@" "${windows[@]}"
}

update_workareas() {
	local m

	for m in "${monitors[@]}"; do
		calculate_workarea $m
	done
	update_net_workarea
}

read_adopt_windows() {
	local windowid 

	(( $# )) || return

	log 'Adopting %s windows\n' $#

	for windowid in "$@"; do
		log 'Checking prospective adoption of window %s\n' $windowid
		x_send_get_window_attributes $windowid
	done

	when_idle update_workareas
}

x_read_get_window_attributes() {
	#local unused=$1
	shift

	local windowid=$1
	local class map_stat override_redirect

	beginreply 'GetWindowAttributes %s' $windowid
	{
	readpad 8
	read16 class
	readpad 12
	read8 map_state
	read8 override_redirect
	readpad 16
	} <&${xfd}

	if (( class == X_InputOnly || override_redirect )); then
		# We do not manage input only or override redirect windows
		# But createnotify does not tell us if input only
		# so we may have already created 'window_xxx' array
		[[ -v window_$windowid ]] && unset window_$windowid
		return
	fi

	# Windows we saw created will have x,y,etc
	# But adopted windows will not
	if [[ ! -v window_$windowid[x] ]]; then
		local mapped
		if (( map_state )); then
			mapped=$W_Mapped
		else
			mapped=$W_NotMapped
		fi
		declare -Ag "window_$windowid=( \
			mapped $mapped \
			take_focus 0 \
			delete_window 0 \
			)"		
		x_send_get_geometry $windowid read_adopt_window
	fi
}

read_adopt_window() {
	local windowid=$1
	local x=$2
	local y=$3
	local width=$4
	local height=$5
	local border_width=$6
	local -n window=window_$windowid

	window['x']=$x
	window['y']=$y
	window['width']=$width
	window['height']=$height
	window['border_width']=$border_width

	log 'Adopted %s\n' $windowid

	if (( window['mapped'] == $W_Mapped )); then
		pre_map $windowid adopt_window
	fi
}

adopt_windows() {
	x_send_query_tree read_adopt_windows
}

is_fixed_size() {
	local hints=${1:-0 0 0 0 0}

	# hints[0] = flags
	# hint[1 2] = minimum width height
	# hint[3 4] = maximum width height
	(( hints[0] & X_WM_PMinSize && 
		hints[0] & X_WM_PMaxSize &&
		hints[1] == hints[3] && 
		hints[2] == hints[4] ))
}

is_normal_type() {
	local net_type=${1:-$XA_NET_WM_WINDOW_TYPE_NORMAL}
	[[ $net_type == $XA_NET_WM_WINDOW_TYPE_NORMAL ]]
}

set_window_type() {
	local windowid=$1
	local -n window=window_$windowid

	[[ ${window[type]} ]] && return

	if [[ ${window[$XA_WM_TRANSIENT_FOR]} == 1 ]] ||
			is_fixed_size ${window[$XA_WM_NORMAL_HINTS]} ||
			! is_normal_type ${window[$XA_NET_WM_WINDOW_TYPE]}; then
		window['type']=float
	else
		window['type']=tile
	fi
}

adopt_window() {
	local windowid=$1
	local root=${screen_0['root']}
	local -n window=window_$windowid
	local monitorid
	local manage=1

	if [[ ${window[$XA_NET_WM_STRUT_PARTIAL]} ]]; then
		log 'Add strut %s\n' $windowid
		window['type']=strut
		monitorid=${ window_monitor $windowid; }
		log 'target monitor %d\n' $monitorid
		window['monitor']=$monitorid
		list_append monitor_$monitorid struts $windowid
		manage=0
	else
		desktopid=${window['desktop']:-$current_desktop}
		window['desktop']=$desktopid
		set_window_type $windowid
		case ${window['type']} in
			tile)
				list_push desktop_$desktopid tiles $windowid
				window['border_width']=$wm_border_width
				;;
			float)
				list_push desktop_$desktopid floats $windowid
				;;
		esac
	fi

	(( manage )) && clientlist_add $windowid
}

allocate_id() {
	if (( last_id )); then
		(( last_id++ ))
	else
		last_id=1
		while (( ! last_id & ${server['resource_id_mask']} )); do
			(( last_id <<= 1))
		done
	fi

	echo $(( ${server['resource_id_base']} | last_id ))
}

x_send_create_wmcheck_window() {
	wmcheck_windowid=$(allocate_id)

	beginrequest 'CreateWindow (for WM_CHECK) %s' $wmcheck_windowid
	{
	write8 $X_CreateWindow
	write8 0
	write16 8
	write32 $wmcheck_windowid
	write32 ${screen_0['root']}
	writei16 0
	writei16 0
	write16 1
	write16 1
	write16 0
	write16 $X_InputOnly
	write32 $X_CopyFromParent
	write32 0
	} >&${xfd}
}

set_wmcheck_window_props() {
	local supported
	local root=${screen_0['root']}

	x_send_change_property $wmcheck_windowid $X_PropModeReplace \
		$XA_NET_SUPPORTING_WM_CHECK $XA_WINDOW 32 1 $wmcheck_windowid
	x_send_change_property $wmcheck_windowid $X_PropModeReplace \
		$XA_NET_WM_NAME $XA_UTF8_STRING 8 6 'bashwm'
	x_send_change_property $root $X_PropModeReplace \
		$XA_NET_SUPPORTING_WM_CHECK $XA_WINDOW 32 1 $wmcheck_windowid
	x_send_delete_property $root $XA_NET_CLIENT_LIST

	supported=( $XA_NET_CURRENT_DESKTOP $XA_NET_NUMBER_OF_DESKTOPS \
		$XA_NET_ACTIVE_WINDOW $XA_NET_SUPPORTED \
		$XA_NET_WM_STATE $XA_NET_SUPPORTING_WM_CHECK \
		$XA_NET_WM_STATE_FULLSCREEN $XA_NET_WM_WINDOW_TYPE \
		$XA_NET_WM_WINDOW_TYPE_DOCK $XA_NET_WM_WINDOW_TYPE_NORMAL \
		$XA_NET_CLIENT_LIST )

	x_send_change_property $root $X_PropModeReplace $XA_NET_SUPPORTED \
		$XA_ATOM 32 ${#supported[@]} ${supported[@]}
}

handle_event() {
	local input_type=$1
	beginevent 'No handler for InputType %s' $input_type
	# discard unwanted event data
	{
	readpad 1
	read16 server_seqno
	readpad 28
	} <&${xfd}
}

