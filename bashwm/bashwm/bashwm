#!/usr/bin/env bash

# TODO: get floats working

die() {
	log "$@"
	exit 1
}

raw_log() {
	printf "$@" >> $logfile ||
		printf 'printf failed: %s\n' "$*" >> $logfile
}

log() {
	if [[ $last_log ]]; then
		last_log=''
		raw_log '\n'
	fi
	raw_log "$@"
}

log_time() {
	log '%(%Y-%m-%d %H:%M:%S)T\n'
}

log_printf() {
	log "$@"
	printf "$@"
}

log_out_chars() {
	local i 
	for(( i=0 ; i<${#1} ; i++ )); do
		log_out_char ${1:$i:1}
	done
}

log_out_char() {
	local x

	printf -v x '%d' "'$1"
	printf -v x '%02x' $x
	log_out_byte $x
}

log_out_byte() {
	# return
	if [[ $last_log != '>' ]]; then
		raw_log '\n>'
		last_log='>'
	fi
	raw_log ' %s' $1
}

log_in_char() {
	local x

	printf -v x '%d' "'$1"
	printf -v x '%02x' $x
	log_in_byte $x
}

log_in_byte() {
	# return
	if [[ $last_log != '<' ]]; then
		raw_log '\n<'
		last_log='<'
	fi
	raw_log ' %s' $1
}

log_array() {
	local name=$1
	local -n _a=$name
	local _i

	log 'Array %s\n' $name
	for _i in ${!_a[@]}; do
		log '%s[%s]=%s\n' $name $_i "${_a[$_i]}"
	done
}


####################
# Helpers for mapping atom names to values
# Some atoms are defined by the core protocol so we can
# cache their mappings early
# Others we have to get the server to generate an id (intern_atom)
# for an atom name and add that to the list of mappings
####################

cache_xa_names() {
	local names=( ATOM CARDINAL COLORMAP CARDINAL INTEGER PIXMAP \
		STRING VISUALID WINDOW WM_COMMAND WM_HINTS WM_NAME \
		WM_NORMAL_HINTS WM_SIZE_HINTS WM_CLASS WM_TRANSIENT_FOR )
	local name xa_id

	for name in ${names[@]}; do
		xa_id="XA_$name"
		xa_names[${!xa_id}]=$name
	done
}

xa_name() {
	xa_id=$1
	echo ${xa_names[xa_id]:-$xa_id}
}

intern_atoms() {
	intern_atom UTF8_STRING
	intern_atom WM_PROTOCOLS
	intern_atom WM_TAKE_FOCUS
	intern_atom WM_DELETE_WINDOW
	intern_atom _NET_CURRENT_DESKTOP
	intern_atom _NET_NUMBER_OF_DESKTOPS
	intern_atom _NET_DESKTOP_VIEWPORT
	intern_atom _NET_WORKAREA
	intern_atom _NET_SUPPORTED
	intern_atom _NET_ACTIVE_WINDOW
	intern_atom _NET_SUPPORTING_WM_CHECK
	intern_atom _NET_WM_NAME
	intern_atom _NET_WM_STATE
	intern_atom _NET_WM_STATE_FULLSCREEN
	intern_atom _NET_WM_WINDOW_TYPE
	intern_atom _NET_WM_WINDOW_TYPE_NORMAL
	intern_atom _NET_WM_STRUT_PARTIAL
	intern_atom _NET_CLIENT_LIST
}

intern_atom() {
	local atom=$1

	x_send_intern_atom $atom set_atom_value
}


set_atom_value() {
	local name=$1
	local atom=$2

	local root=${x_screen_0['root']}
	local xaname=$name

	[[ ${xaname::1} == '_' ]] || xaname="_$xaname"
	xaname="XA$xaname"
	printf -v $xaname $atom
	xa_names[atom]=$name

	case $name in
		_NET_CURRENT_DESKTOP) 
			x_send_change_property $root $X_PropModeReplace $atom $XA_CARDINAL 32 1 $wm_current_desktop 
			;;
		_NET_NUMBER_OF_DESKTOPS) 
			x_send_change_property $root $X_PropModeReplace $atom $XA_CARDINAL 32 1 $wm_desktop_count
			;;
		WM_PROTOCOLS)
			wm_property_change_handlers[XA_WM_PROTOCOLS]=wm_protocols_changed
	esac
}

# This is the other way round than the rest of the atom helpers
# When we get monitor info we get an atom id but no name
# so the monitor code asks for the name, and this is the callback
set_atom_name() {
	local atom=$1
	local name=$2

	xa_names[$atom]=$name
}


####################
# Load XRandR extension, check version then get monitor information
# Monitor changes trigger a ConfigureNotify event where the root
# is both the event source and window target
####################

rr_get_monitors() {
	x_send_query_extension $X_RANDR_NAME rr_query_version
}

rr_query_version() {
	local name=$1
	local present=$2

	if (( present == 0 )); then
		rr_setup_failed
	else
		x_send_rr_query_version rr_setup
	fi
}

rr_setup() {
	local status=$1

	if (( status == X_RROk )); then
		x_send_rr_get_monitors update_monitors
	else
		rr_setup_failed
	fi
}

rr_setup_failed() {
	log 'XRandR extension not present or version not supported\n'
	log 'Using entire screen\n'

	x_screen_0['primary']=0
	wm_monitors=( 0 )

	default_monitor_config
	desktop_monitor_config

	layout_monitor 0

	update_net_workarea
	update_net_viewport
}

handle_configure_notify() {
	local windowid=$1
	local event=$2

	local root=${x_screen_0['root']}

	log '< ConfigureNotify for event %s window %s\n' $event $windowid

	# When xrandr changes monitor/output config root gets a ConfigureNotify
	# We can get lots in a short period as outputs/crtcs get unconfigured 
	# and then reconfigured 
	# The event loop will only request the updated monitor configuration
	# when there are no pending replies or events
	(( event == root && windowid == root )) && request_get_monitors
}


####################
# Get kayboard mapping and grab keys that we use for commands
# Handle key press events to call those commands
####################

get_key_mappings() {
	x_send_get_keyboard_mapping grab_command_keys
}

grab_command_keys() {
	# key_map passed by name
	# key_map[keycode]=keysym
	local -n key_map=$1
	local keycode keysym keycommands keycmds keycmd mask

	for keycode in ${!key_map[@]}; do
		keysym=${key_map[$keycode]}
		keycommands=${wm_keysym_commands[$keysym]}
		[[ $keycommands ]] || continue
		wm_keycode_commands[$keycode]="$keycommands"
		IFS=',' read -ra keycmds <<< "$keycommands" 
		for keycmd in "${keycmds[@]}"; do
			mask="${keycmd%:*}"
			x_send_grab_key $keycode $mask
		done
	done
}

handle_key_press() {
	local keycode=$1
	local keymask=$2

	log 'KeyPress %s' $keycode 

	keycode_cmd="${wm_keycode_commands[keycode]}" 

	log 'Key commands %s\n' "$keycode_cmd"

	[[ $keycode_cmd ]] || return 0

	IFS=',' read -ra keycmds <<< "$keycode_cmd"
	for keycmd in "${keycmds[@]}"; do

		log 'Key command %s\n' "$keycmd"

		mask="${keycmd%:*}"

		log 'Event Mask %s, Key Mask %s\n' "$mask" "$keymask"

		(( mask == keymask )) || continue

		cmd="${keycmd#*:}"

		log 'Command %s\n' "$cmd"

		$cmd
		break
	done
}

####################
# Create and configure a special, never mapped, window 
# for Window Manager identification 
####################

create_wmcheck_window() {
	wmcheck_windowid=$(allocate_id)

	x_send_create_window $wmcheck_windowid 0 0 1 1 0 \
		$X_InputOnly $X_CopyFromParent $X_CopyFromParent
}

# Called by CreateNotify handler when wncheck_windowid is created
set_wmcheck_window_props() {
	local supported
	local root=${x_screen_0['root']}

	x_send_change_property $wmcheck_windowid $X_PropModeReplace \
		$XA_NET_SUPPORTING_WM_CHECK $XA_WINDOW 32 1 $wmcheck_windowid
	x_send_change_property $wmcheck_windowid $X_PropModeReplace \
		$XA_NET_WM_NAME $XA_UTF8_STRING 8 6 'bashwm'
	x_send_change_property $root $X_PropModeReplace \
		$XA_NET_SUPPORTING_WM_CHECK $XA_WINDOW 32 1 $wmcheck_windowid
	x_send_delete_property $root $XA_NET_CLIENT_LIST

	supported=( $XA_NET_CURRENT_DESKTOP $XA_NET_NUMBER_OF_DESKTOPS \
		$XA_NET_ACTIVE_WINDOW $XA_NET_SUPPORTED \
		$XA_NET_WM_STATE $XA_NET_SUPPORTING_WM_CHECK \
		$XA_NET_WM_STATE_FULLSCREEN $XA_NET_WM_WINDOW_TYPE \
		$XA_NET_WM_WINDOW_TYPE_DOCK $XA_NET_WM_WINDOW_TYPE_NORMAL \
		$XA_NET_CLIENT_LIST )

	x_send_change_property $root $X_PropModeReplace $XA_NET_SUPPORTED \
		$XA_ATOM 32 ${#supported[@]} ${supported[@]}
}


####################
# Adopt windows that existed before we started
####################

adopt_windows() {
	x_send_query_tree read_adopt_windows
}

read_adopt_windows() {
	local windowid 

	(( $# )) || return

	log 'Adopting %s windows\n' $#

	for windowid in "$@"; do
		log 'Checking prospective adoption of window %s\n' $windowid
		x_send_get_window_attributes $windowid check_window_attributes
	done

	x_when_sync update_workareas
}

check_window_attributes() {
	local windowid=$1
	local class=$2
	local map_state=$3
	local overide_redirect=$4

	if (( class == X_InputOnly || override_redirect )); then
		# We do not manage input only or override redirect windows
		# But createnotify does not tell us if input only
		# so we may have already created 'window_xxx' array
		[[ -v window_$windowid ]] && unset window_$windowid
		return
	fi

	# Windows we saw created will have x,y,etc
	# But adopted windows will not
	if [[ ! -v window_$windowid[x] ]]; then
		local mapped
		if (( map_state )); then
			mapped=$W_Mapped
		else
			mapped=$W_NotMapped
		fi
		declare -Ag "window_$windowid=( \
			mapped $mapped \
			take_focus 0 \
			delete_window 0 \
			)"		
		x_send_get_geometry $windowid read_adopt_window
	fi
}

read_adopt_window() {
	local windowid=$1
	local x=$2
	local y=$3
	local width=$4
	local height=$5
	local border_width=$6
	local -n window=window_$windowid

	window['x']=$x
	window['y']=$y
	window['width']=$width
	window['height']=$height
	window['border_width']=$border_width

	log 'Adopted %s\n' $windowid

	if (( window['mapped'] == $W_Mapped )); then
		pre_map $windowid adopt_window
	fi
}

adopt_window() {
	local windowid=$1
	local root=${x_screen_0['root']}
	local -n window=window_$windowid
	local monitorid
	local manage=1

	if [[ ${window[$XA_NET_WM_STRUT_PARTIAL]} ]]; then
		log 'Add strut %s\n' $windowid
		window['type']=strut
		monitorid=${ window_monitor $windowid; }
		log 'target monitor %d\n' $monitorid
		window['monitor']=$monitorid
		list_append monitor_$monitorid struts $windowid
		manage=0
	else
		window_config $windowid
		desktopid=${window['desktop']}
		case ${window['type']} in
			tile)
				list_push desktop_$desktopid tiles $windowid
				;;
			float)
				list_push desktop_$desktopid floats $windowid
				;;
		esac
	fi

	(( manage )) && clientlist_add $windowid
}

####################
# 
####################
handle_focus_in() {
	local windowid=$1
	local detail=$2
	local mode=$3

	(( mode == X_NotifyNormal || mode == X_NotifyWhileGrabbed )) || return
	
	(( x_screen_0['active'] != windowid )) || return

	local -n window=window_$windowid

	# Only interested if we manage the window and it is a mapped tile or float
	is_object window &&
		(( window['mapped'] == W_Mapped )) &&
		[[ ${window['type']} =~ tile|float ]] || return

	log 'FocusIn %s (%s %s)' $windowid $detail $mode

	focuslist_add $windowid
	set_active_window $windowid
}

set_border_color() {
	local windowid=$1
	local border_pixel=$2

	log 'Set border color for window %s to %s\n' $windowid $border_pixel

	x_send_change_window_attributes $windowid $X_CWBorderPixel $border_pixel
}

set_window_pos() {
	local windowid=$1
	local -n window=window_$windowid
	local x=${2:-${window['old_x']}}
	local y=${3:-${window['old_y']}}
	local width=${4:-${window['old_width']}}
	local height=${5:-${window['old_height']}}
	local border_width=${6:- \
			${window['old_border_width']:- \
			${window['border_width']}}}
	local stack_mode=$7
	local sibling=$X_None
	local length=8

	window['old_x']=${window['x']}
	window['old_y']=${window['y']}
	window['old_width']=${window['width']}
	window['old_height']=${window['height']}
	window['old_border_width']=${window['border_width']}

	window['x']=$x
	window['y']=$y
	window['width']=$width
	window['height']=$height

	# Don't let border width force window width or height < 1
	if (( width <= (2 * border_width) || height <= (2 * border_width) )); then
		border_width=0
	fi
	window['border_width']=$border_width

	mask=$(( X_CWX | X_CWY | X_CWWidth | X_CWHeight | X_CWBorderWidth ))

	if [[ $stack_mode ]]; then
		(( mask |= X_CWStackMode ))
	else
		stack_mode=$X_Above
	fi

	x_send_configure_window \
		$windowid $stack_mode $mask \
		$x $y $width $height $border_width $sibling
	
	x_send_synthetic_configure_notify $windowid $stack_mode $x $y \
		$width $height $border_width $sibling
}

set_wm_class() {
	local instance=$1
	local class=$2
	local len_instance=${#instance}
	local len_class=${#class}
	local bytes=()
	local i

	for (( i=0 ; i<len_instance ; i++ )); do
		bytes+=( "'${instance:i:1}" )
	done
	bytes+=( 0 )
	for (( i=0 ; i<len_class ; i++ )); do
		bytes+=( "'${class:i:1}" )
	done

	x_send_change_property ${x_screen_0['root']} $X_PropModeReplace \
		$XA_WM_CLASS $XA_STRING 8 ${#bytes[@]} "${bytes[@]}"
}

wm_protocols_changed() {
	local windowid=$1
	local -n window=window_$windowid
	local protocols=${window[$XA_WM_PROTOCOLS]}
	local protocol

	log 'Protocols changed for window %s to %s\n' $windowid "${protocols[*]}"

	for protocol in $protocols; do
		case $protocol in
			$XA_WM_TAKE_FOCUS)    window['take_focus']=1 ;;
			$XA_WM_DELETE_WINDOW) window['delete_window']=1 ;;
			*) ;;
		esac
	done
}

wm_hints_changed() {
	local windowid=$1
	local -n window=window_$windowid
	local hints=( ${window[$XA_WM_HINTS]} 1 1 )

	log 'Hints changed for window %s to %s\n' $windowid "${hints[*]}"

	window['input']=$(( hints[0] & 1 && hints[1] ))
}

set_property() {
	local windowid=$1
	local atom=$2
	local value=$3

	local -n window=window_$windowid
	window[$atom]=$3

	local handler="${wm_property_change_handlers[atom]}"

	log 'Window %s Property %d handled by %s\n' $windowid $atom $handler
	
	[[ $handler ]] && $handler $windowid $atom
}

update_workareas() {
	local m

	for m in "${wm_monitors[@]}"; do
		calculate_workarea $m
	done
	update_net_workarea
}


is_fixed_size() {
	local hints=${1:-'0 0 0 0 0'}

	# hints[0] = flags
	# hint[1 2] = minimum width height
	# hint[3 4] = maximum width height
	(( hints[0] & X_WM_PMinSize && 
		hints[0] & X_WM_PMaxSize &&
		hints[1] == hints[3] && 
		hints[2] == hints[4] ))
}

is_normal_type() {
	local net_type=${1:-$XA_NET_WM_WINDOW_TYPE_NORMAL}
	[[ $net_type == $XA_NET_WM_WINDOW_TYPE_NORMAL ]]
}

window_config() {
	local windowid=$1
	local -n window=window_$windowid
	local border_width=$wm_border_width

	window['desktop']=${window['desktop']:-$wm_current_desktop}

	if [[ -z ${window['type']} ]]; then	
		if [[ ${window[$XA_WM_TRANSIENT_FOR]} == 1 ]] ||
				is_fixed_size ${window[$XA_WM_NORMAL_HINTS]} ||
				! is_normal_type ${window[$XA_NET_WM_WINDOW_TYPE]}; then
			window['type']=float
		else
			window['type']=tile
		fi
	fi

	if ! is_fixed_size ${window[$XA_WM_NORMAL_HINTS]}; then
		window['border_width']=$wm_border_width
	fi
}

allocate_id() {
	if (( last_id )); then
		(( last_id++ ))
	else
		last_id=1
		while (( ! last_id & ${x_server['resource_id_mask']} )); do
			(( last_id <<= 1))
		done
	fi

	echo $(( ${x_server['resource_id_base']} | last_id ))
}

request_get_monitors() {
	(( getmonitors )) && return
	getmonitors=1
	x_when_idle process_get_monitors
}

process_get_monitors() {
	(( getmonitors )) || return
	getmonitors=0
	x_send_rr_get_monitors check_update_monitors
	return
}

check_update_monitors() {
	# If another request_get_monitors has run then discard this reply
	(( getmonitors == 0 )) && update_monitors "$@"
}


update_monitors() {
	local name m monitorid name_atom
	local prev_monitors=" ${wm_monitors[*]} "
	wm_monitors=()
	unset 'x_screen_0['primary']'

	log 'Update wm_monitors nmonitors=%d\n' $#
	for m in "$@"; do
		m=( $m )
		name_atom=${m[0]}
		monitorid=$name_atom

		name=${xa_names[name_atom]}
		[[ $name ]] || x_send_get_atom_name $name_atom set_atom_name

		(( primary )) && x_screen_0['primary']=$monitorid

		monitor_config "${m[@]}"

		wm_monitors+=( $monitorid )
		prev_monitors=${prev_monitors/ $monitorid / }
	done

	x_screen_0['primary']=${x_screen_0['primary']:-${wm_monitors[0]}}

	for m in $prev_monitors; do
		monitor_remove $m
	done

	desktop_monitor_config

	update_workareas 

	for m in "${wm_monitors[@]}"; do
		layout_monitor $m
	done

	update_net_viewport

	x_when_sync monitors_update_notify
}

handle_error() {
	local code=$1
	local data=$2
	local major_op_code=$3
	local minor_op_code=$4

	local res=$code

	case $code in
		$X_BadWindow) res=0
			;;
		$X_BadMatch)
			if (( major_op_code == X_SetInputFocus ||
				major_op_code == X_ConfigureWindow )); then
				res=0
			fi
			;;
		$X_BadAccess)
			if (( major_op_code == X_GrabButton ||
				major_op_code == X_GrabKey )); then
				res=0
			fi
			;;
		0)	# something very wrong
			res=255
			;;
	esac

	if (( $res )); then
		log 'Error code: %d\n' $code
		log 'Error data: %04x\n' $data
		log 'Error op code: %d:%d\n' $major_op_code $minor_op_code

		x_exit $res
	fi
}

handle_create_notify() {
	local windowid=$1
	local x=$2
	local y=$3
	local width=$4
	local height=$5
	local border_width=$6
	local override_redirect=$7

	(( override_redirect )) && return

	log 'Process CreateNotify Event %s\n' $windowid

	if [[ $windowid == $wmcheck_windowid ]]; then
		set_wmcheck_window_props
		return
	fi

	declare -Ag "window_$windowid=( \
		x $x \
		y $y \
		width $width \
		height $height \
		border_width $border_width \
		mapped $W_NotMapped \
		take_focus 0 \
		delete_window 0 \
		)"
	
	log_array window_$windowid

	x_send_get_window_attributes $windowid check_window_attributes
}

handle_configure_request() {
	local windowid=$1
	local stack_mode=$2
	local value_mask=$3
	local x=$4
	local y=$5
	local width=$6
	local height=$7
	local border_width=$8
	local sibling=$9

	log 'Process ConfigureRequest Event %s\n' $windowid

	local -n window=window_$windowid
	if is_object window; then
		log_array window_$windowid
		(( $value_mask & $X_CWX )) && window['x']=$x
		(( $value_mask & $X_CWY )) && window['y']=$y
		(( $value_mask & $X_CWWidth )) && window['width']=$width
		(( $value_mask & $X_CWHeight )) && window['height']=$height
		(( $value_mask & $X_CWBorderWidth )) && window['border_width']=$border_width
		log_array window_$windowid
	fi

	# Configure requested window, even if we are not managing it
	x_send_configure_window "$@"
	
	x_send_synthetic_configure_notify $windowid $stack_mode ${window['x']} \
		${window['y']} ${window['width']} ${window['height']} \
		${window['border_width']} $sibling
}

handle_property_notify() {
	local windowid=$1
	local atom=$2
	local state=$3

	log '< PropertyNotify for window %s, %s, state %s\n' \
		$windowid ${ xa_name $atom; } $state
}

handle_enter_notify() {
	local windowid=$1
	local timestamp=$2
	local detail=$3
	local mode=$4
	local flags=$5

	(( mode == X_NotifyNormal )) || return

	# Non-root window wanted but only if 
	# enter was not from child to parent and was triggered by motion 
	if (( $windowid != ${x_screen_0['root']} &&
			( detail == X_NotifyInferior || 
			  mode != X_NotifyNormal ) )); then
		return
	fi

	is_object window_$windowid || return

	log 'Process EnterNotify on window %s detail %s mode %s flags %s\n' \
		$windowid $detail $mode $flags

	# Make sure it is one of our tile/float windows
	local -n window=window_$windowid

	case ${window['type']} in
		tile|float)
			focuslist_add $windowid
			setfocus $windowid $timestamp
			;;
		*)
			setfocus 0 $timestamp
			;;
	esac
}

handle_destroy_notify() {
	local windowid=$1
	local event=$2
	local window

	(( event == ${x_screen_0['root']} )) || return

	is_object window_$windowid || return

	log 'DestroyWindow %s' $windowid

	remove_window $windowid
}

handle_unmap_notify() {
	local windowid=$1
	local event=$2

	local root=${x_screen_0['root']}

	(( event == root )) || return

	local -n window=window_$windowid
	is_object window || return

	# We may have already handled the unmapping
	(( window['mapped'] == $W_Mapped )) || return

	log 'UnmapNotify %s' $windowid

	remove_window $windowid
}

handle_map_request() {
	local windowid=$1

	log 'MapRequest %s' $windowid

	# Pass on the map request if we are not managing window
	if ! is_object window_$windowid; then
		x_send_map_window $windowid
		return
	fi

	local -n window=window_$windowid
	if (( window['mapped'] == W_NotMapped )); then
		window['mapped']=$W_MapRequested
		pre_map $windowid map_window
	elif (( window['mapped'] == W_Unmapped )); then
		map_window $windowid
	fi
}

add_tile() {
	local windowid=$1
	local -n window=window_$windowid
	local desktopid=${window['desktop']}

	list_push desktop_$desktopid tiles $windowid
}

add_float() {
	local windowid=$1
	local -n window=window_$windowid
	local desktopid=${window['desktop']}
	
	list_push desktop_$desktopid floats $windowid
}

layout_desktop() {
	local desktopid=$1
	local force=${2:-0}

	local -n desktop=desktop_$desktopid

	log 'layout_desktop: desktop=%s force=%s\n' $desktopid $force 

	log ' :dirty=%s\n' ${desktop['dirty']}

	(( force || desktop['dirty'] )) || return

	log ' :laying out windows\n'

	layout_tiles $desktopid
	layout_floats $desktopid

	desktop['dirty']=0
}

layout_tiles() {
	local desktopid=$1
	local -n desktop=desktop_$desktopid
	local tiles=( ${desktop['tiles']} )
	local monitorid=${wm_desktop_monitor[desktopid]}
	local -n monitor=monitor_$monitorid

	local num_tiles=${#tiles[@]}
	local x=$(( monitor['x'] + monitor['wa_x'] ))
	local y=$(( monitor['y'] + monitor['wa_y'] ))
	local width=${monitor['wa_width']}
	local height=${monitor['wa_height']}
	local window w h hdiff i

	log 'Laying out %d tiles for desktop %d on monitor %d\n' \
		$num_tiles $desktopid $monitorid

	case $num_tiles in
		0)	:
			;;
		1)	set_window_pos ${tiles[0]} \
				$x $y $width $height
			;;
		2)	w=$(( width / 2 ))
			set_window_pos ${tiles[0]} \
				$x $y $w $height
			set_window_pos ${tiles[1]} \
				$((x + w)) $y $((width - w)) $height
			;;
		*)      w=$(( width / 2))
			set_window_pos ${tiles[0]} \
				$x $y $w $height
			(( x+=w, width-=w ))
			h=$(( height / (num_tiles - 1) ))
			hdiff=$(( height - (h * (num_tiles - 1)) ))
			for (( i=1 ; i<num_tiles ; i++ )); do
				set_window_pos ${tiles[i]} \
					$x $y \
					$width $(( h + hdiff ))
				(( y += h + hdiff, hdiff = 0 ))
			done
			;;
	esac
}

# This is broken as floats need to know where they were relative to
# previous work area, and that info is not available here
# For now just make sure all are visible
layout_floats() {
	local desktopid=$1
	local -n desktop=desktop_$desktopid
	local floats=( ${desktop['floats']} )

	local -n monitor=monitor_${wm_desktop_monitor[desktopid]}

	local x=$(( monitor['x'] + monitor['wa_x'] ))
	local y=$(( monitor['y'] + monitor['wa_y'] ))
	local width=${monitor['wa_width']}
	local height=${monitor['wa_height']}

	local window i

	log 'Laying out %d floats\n' ${#floats[@]}

	for f in "${floats[@]}"; do
		log 'Laying out float %s in work area x=%d y=%d width=%d height=%d\n' \
			$f $x $y $width $height

		log_array window_$f

		local -n window=window_$f

		if (( window['width'] >= width )); then
			window['x']=$x
			window['width']=$width
		elif (( window['x'] < x || window['x'] + window['width'] > x + width )); then
			window['x']=$(( x + (width - window['width'])/2 ))
		fi

		if (( window['height'] >= height )); then
			window['y']=$y
			window['height']=$height
		elif (( window['y'] < y || window['y'] +window['height'] > y + height )); then
			window['y']=$(( y + (height - window['height'])/2 ))
		fi

		set_window_pos $f ${window['x']} ${window['y']} \
				${window['width']} ${window['height']}

		log_array window_$f
	done
}

get_property() {
	local windowid=$1
	local atom=$2
	local atom_type=$3
	local length=$4

	x_send_get_property $windowid $atom $atom_type $length set_property
}

pre_map() {
	local windowid=$1
	local next_handler=$2

	get_property $windowid $XA_WM_PROTOCOLS $XA_ATOM 6
	get_property $windowid $XA_WM_NAME $XA_STRING 20
	get_property $windowid $XA_WM_CLASS $XA_STRING 20
	get_property $windowid $XA_NET_WM_WINDOW_TYPE $XA_ATOM 1
	get_property $windowid $XA_NET_WM_STRUT_PARTIAL $XA_CARDINAL 12
	get_property $windowid $XA_WM_TRANSIENT_FOR $XA_WINDOW 1
	get_property $windowid $XA_WM_NORMAL_HINTS $XA_WM_SIZE_HINTS 18
	get_property $windowid $XA_WM_HINTS $XA_WM_HINTS 9

	x_when_server_sync pre_map_customize $windowid $next_handler

	change_window_events $windowid $wm_client_events
}

