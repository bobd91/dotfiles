#!/usr/bin/env bash

die() {
	log "$@"
	exit 1
}

raw_log() {
	printf "$@" >> $logfile
}

log() {
	if [[ $last_log ]]; then
		last_log=''
		raw_log '\n'
	fi
	raw_log "$@"
}

log_printf() {
	log "$@"
	printf "$@"
}

log_out_chars() {
	local i 
	for(( i=0 ; i<${#1} ; i++ )); do
		log_out_char ${1:$i:1}
	done
}

log_out_char() {
	local x

	printf -v x '%d' "'$1"
	printf -v x '%02x' $x
	log_out_byte $x
}

log_out_byte() {
	if [[ $last_log != '>' ]]; then
		raw_log '\n>'
		last_log='>'
	fi
	raw_log ' %s' $1
}

log_in_char() {
	local x

	printf -v x '%d' "'$1"
	printf -v x '%02x' $x
	log_in_byte $x
}

log_in_byte() {
	if [[ $last_log != '<' ]]; then
		raw_log '\n<'
		last_log='<'
	fi
	raw_log ' %s' $1
}

log_array() {
	local name=$1
	local -n _a=$name
	local _i

	log 'Array %s\n' $name
	for _i in ${!_a[@]}; do
		log '%s[%s]=%s\n' $name $_i "${_a[$_i]}"
	done
}

write_b() {
	printf '%b' "\x$1" || die 'Write failure: %d\n' $?
	log_out_byte $1
}

write_s() {
	printf '%s' "$1" || die 'Write failure: %d\n' $?
	log_out_chars "$1"
}

write8() {
	local t=00
	(( $1 )) && printf -v t '%02x' "$(( $1 & 16#FF ))"
	write_b $t
}

write16() {
	local val=$1

	write8 $(( val >> 8 ))
	write8 $val
}

write32() {
	local val=$1

	write8 $(( val >> 24 ))
	write8 $(( val >> 16 ))
	write8 $(( val >> 8 ))
	write8 $val
}

writepad() {
	local i
	for (( i=0 ; i<$1 ; i++ )); do
		write8 0
	done
}

pad4() {
	local l=$1
	echo $(( (4 - (l % 4)) % 4 ))
}

writepad4() {
	writepad $(pad4 $1)
}


writechars() {
	local len=$1
	local chars=$2
	write_s "$2"
}

writebytes() {
	local len=$1
	local bytes=$2
	local byte_count=$(( ${#bytes}/2 ))
	local i b

	for (( i=0 ; i<byte_count ; i++ )); do
		b=$(( i*2 ))
		write_b "${bytes:b:2}"
	done
	# If len > byte_count pad with nulls
	for (( i=byte_count ; i<len ; i++ )); do
		write_b 00
	done
}

read8() {
	local _t

	IFS= read -r -d '' -n 1 _t
	if [[ -n $_t ]]; then
		printf -v "$1" '%d' "'$_t"
	else
		printf -v "$1" "0"
	fi

	log_in_char "$_t"
}

read16() {
	local _b1 _b2
	read8 _b1
	read8 _b2
	printf -v "$1" "$(( _b2 + (_b1 << 8) ))"
}

read32() {
	local _b1 _b2 _b3 _b4
	read8 _b1
	read8 _b2
	read8 _b3
	read8 _b4
	printf -v "$1" "$(( _b4 + (_b3 << 8) + (_b2 << 16) + (_b1 << 24) ))"
}

readstr() {
	local _s1
	read8 _s1
	readchars $_s1 $1
}

readstring() {
	local _s
	IFS= read -r -d '' _s

	log "\"$_s\""

	printf -v "$1" "$_s"
}

readchars() {
	local _n=$1
	local _s

	(( $_n )) || return

	IFS= read -r -d '' -n $_n _s

	log "\"$_s\""

	(( _n == ${#_s} )) || readpad $(( $_n - ${#_s} - 1))
	
	printf -v "$2" "$_s"
}

readbytes() {
	local _i _c _b _s

	(( $1 )) || return

	for (( _i=0 ; _i<$1 ; _i++ )); do
		read8 _c
		printf -v _b '%02x' $_c
		_s+=$_b
	done

	printf -v "$2" $_s
}

readutf8() {
	local LC_CTYPE=C
	local _utf8
	readchars $1 _utf8
	LC_TYPE=C.UTF8
	printf -v "$2" '%s' $_utf8
}

readpad() {
	local pad i

	for (( i=0 ; i<$1 ; i++ )); do
		read8 pad
	done
}

readpad4() {
	readpad $(pad4 $1)
}

readxauth() {
	local proto=256
	local addr="${HOSTNAME}"
	local display="${dsp#*:}"
	local length=1

	while [[ $length != 0 && ($xauth_proto != $proto ||
				  $xauth_addr != $addr ||
				  $xauth_display != $display) ]]; do
		read16 xauth_proto
		read16 length
		readchars $length xauth_addr
		read16 length
		readchars $length xauth_display
		read16 xauth_name_length 
		readchars $xauth_name_length xauth_name
		read16 xauth_data_length
		readbytes $xauth_data_length xauth_data
	done
}

send_setup() {
	local lsb_first="$(( 16#42 ))"
	local name_len=${#xauth_name}
	# data is 02x formatted bytes
	local data_len=$(( ${#xauth_data} / 2 ))

	log '> Setup Request\n'

	write8 $lsb_first
	writepad 1
	write16 $proto_major
	write16 $proto_minor
	write16 $name_len
	write16 $data_len
	writepad 2
	writechars $name_len "$xauth_name"
	writepad4 $name_len
	writebytes $data_len "$xauth_data"
	writepad4 $data_len
}

read_setup_leader() {
	log '< Setup Leader\n'

	read8 setup_success
	read8 setup_length
	read16 proto_major
	read16 proto_minor
	read16 extra_length
}

read_setup_failure() {
	log '< Setup Failure\n'

	readchars $setup_length setup_failure_reason
	readpad "$(( extra_length * 4 - setup_length ))"
}

read_setup_ok() {
	local release_number resource_id_base resource_id_mask 
	local motion_buffer_size vendor_length max_request_length
	local no_of_screens no_of_formats image_byte_order bitmap_byte_order
	local bitmap_scanline_unit bitmap_scanline_pad min_keycode max_keycode
	local vendor i root colormap white_pixel black_pixel input_masks
	local width_pixels height_pixels width_mm height_mm min_maps max_maps
	local visual_id backing_stores save_unders root_depth no_of_depths
	local d depth no_of_visuals v class bits_per_rgb colormaps
	local red_mask green_mask blue_mask

	log '< Setup OK\n'

	read32 release_number
	read32 resource_id_base
	read32 resource_id_mask
	read32 motion_buffer_size
	read16 vendor_length
	read16 max_request_length
	read8 no_of_screens
	read8 no_of_formats
	read8 image_byte_order
	read8 bitmap_byte_order
	read8 bitmap_scanline_unit
	read8 bitmap_scanline_pad
	read8 min_keycode
	read8 max_keycode
	readpad 4
	readchars $vendor_length vendor 
	readpad4 $vendor_length
	readpad $(( 8 * no_of_formats ))

	declare -Ag "server=(\
		resource_id_base $resource_id_base \
		resource_id_mask $resource_id_mask \
		no_of_screens $no_of_screens \
		min_keycode $min_keycode \
		max_keycode $max_keycode)"

	for (( i=0 ; i<no_of_screens ; i++ )); do
		read32 root
		read32 colormap
		read32 white_pixel
		read32 black_pixel
		read32 input_masks
		read16 width_pixels
		read16 height_pixels
		read16 width_mm
		read16 height_mm
		read16 min_maps
		read16 max_maps
		read32 visual_id
		read8 backing_stores
		read8 save_unders
		read8 root_depth
		read8 no_of_depths

		declare -Ag "screen_$i=( \
			root $root \
			width_pixels $width_pixels \
			height_pixels $height_pixels)"

		for (( d=0 ; d<no_of_depths ; d++ )); do
			read8 depth
			readpad 1
			read16 no_of_visuals
			readpad 4
			for (( v=0 ; v<no_of_visuals ; v++ )); do
				read32 visual_id
				read8 class
				read8 bits_per_rgb
				read16 colormaps
				read32 red_mask
				read32 green_mask
				read32 blue_mask
				readpad 4
			done
		done
	done
}

beginrequest() {
	local opcode=$1
	local byte1=$2
	local req_length=$3
	local handler=$4

	(( sequence_number++ ))
	write8 $opcode
	write8 $byte1
	write16 $req_length

	local seq_no=$((sequence_number & 16#FFFF))

	if [[ $handler ]]; then
		(( replies_pending++ ))
		shift 4
		declare -Ag "reply_$seq_no=( \
			handler "$handler" \
			args \"$*\" )"
	fi

	log '> Request %s %s (%s)\n' $opcode $req_length $sequence_number
}

send_change_window_events() {
	local windowid=$1
	local mask=$2

	log '> Change Window Events %s\n' $windowid

	beginrequest $X_ChangeWindowAttributes 0 4
	write32 $windowid
	write32 $X_CWEventMask
	write32 $mask
}

send_get_keyboard_mapping() {
	local min_keycode=${server[min_keycode]}
	local max_keycode=${server[max_keycode]}

	log '> GetKeyboardMapping\n'

	beginrequest $X_GetKeyboardMapping 0 2 read_get_keyboard_mapping
	write8 $min_keycode
	write8 $(( 1 + max_keycode - min_keycode ))
	writepad 2
}

send_grab_key() {
	local keycode=$1
	local mask=$2

	log '> GrabKey %s %s\n' $mask $keycode

	beginrequest $X_GrabKey 0 4
	write32 ${screen_0[root]}
	write16 $mask
	write8 $keycode
	write8 1
	write8 1
	writepad 3
}

send_set_border_color() {
	local windowid=$1
	local border_pixel=$2

	log '> SetBorderColor %s to %s\n' $windowid $border_pixel

	beginrequest $X_ChangeWindowAttributes 0 4 
	write32 $windowid
	write32 $X_CWBorderPixel
	write32 $border_pixel
}

send_set_window_pos() {
	local windowid=$1
	local -n window=window_$windowid
	local x=${2:-${window[old_x]}}
	local y=${3:-${window[old_y]}}
	local width=${4:-${window[old_width]}}
	local height=${5:-${window[old_height]}}
	local border_width=${6:-$wm_border_width}
	local stacking_order=$7
	local length=8

	log '> SetWindowPos %s\n' $windowid

	window[old_x]=${window[x]}
	window[old_y]=${window[y]}
	window[old_width]=${window[width]}
	window[old_height]=${window[height]}
	window[x]=$x
	window[y]=$y
	window[width]=$width
	window[height]=$height

	# Don't let border width force window width or height < 1
	if (( width <= (2 * border_width) || height <= (2 * border_width) )); then
		$border_width=0
	fi
	window[border_width]=$border_width

	log_array window_$windowid

	mask=$(( X_CWX | X_CWY | X_CWWidth | X_CWHeight | X_CWBorderWidth ))
	[[ $stacking_order ]] && (( mask |= X_CWStackMode, length++ ))

	beginrequest $X_ConfigureWindow 0 $length
	write32 $windowid
	write16 $mask
	writepad 2
	write32 $x
	write32 $y
	write32 $(( width - (2 * border_width) ))
	write32 $(( height - (2 * border_width) ))
	write32 $border_width
	[[ $stacking_order ]] && write32 $stacking_order
}

send_map_window() {
	local windowid=$1

	log '> MapWindow %s\n' $windowid

	beginrequest $X_MapWindow 0 2
	write32 $windowid
}

send_unmap_window() {
	local windowid=$1

	log '> UnmapWindow %s\n' $windowid

	beginrequest $X_UnmapWindow 0 2
	write32 $windowid
}

send_intern_atom() {
	local name=$1
	local name_len=${#name}
	local name_pad=$(pad4 name_len)
	local req_len=$(( 2 + (name_len + name_pad) / 4 ))
	
	log '> InternAtom %s\n' $name

	beginrequest $X_InternAtom 0 $req_len read_intern_atom $name
	write16 $name_len
	writepad 2
	writechars $name_len $name
	writepad $name_pad
}

read_get_keyboard_mapping() {
	local keysyms_per=$1
	local min_keycode=${server[min_keycode]}
	local max_keycode=${server[max_keycode]}
	local keycodes=$(( 1 + max_keycode - min_keycode ))
	local key_mappings=$(( keysyms_per * keycodes ))
	local keycode keycodesym keycmds keycmda keycmd mask

	log '< Keyboard Mapping\n'

	read32 reply_length
	(( reply_length == key_mappings )) ||
		die "Unexpected number of keboard mappings: " \
			"Got $reply_length, Expected $key_mappings\n"
	readpad 24

	for (( keycode=min_keycode ; keycode<=max_keycode ; keycode++ )); do
		# only interested in the first keysym
		read32 keycodesym
		readpad $(( 4 * (keysyms_per - 1) ))

		keycmds="${keysym_command_map[keycodesym]}"
		[[ $keycmds ]] || continue

		log 'Map keycode=%s to command=%s\n' $keycode "$keycmds"

		keycode_command_map[keycode]=$keycmds
	done

	for keycode in ${!keycode_command_map[@]}; do
		IFS=',' read -ra keycmds <<< "${keycode_command_map[keycode]}" 
		for keycmd in "${keycmds[@]}"; do
			mask="${keycmd%:*}"
			send_grab_key $keycode $mask
		done
	done
}

cache_xa_names() {
	local names=( ATOM CARDINAL COLORMAP CARDINAL INTEGER PIXMAP \
		STRING VISUALID WINDOW WM_COMMAND WM_HINTS WM_NAME \
		WM_NORMAL_HINTS WM_SIZE_HINTS WM_CLASS WM_TRANSIENT_FOR )
	local name xa_id

	for name in ${names[@]}; do
		xa_id="XA_$name"
		xa_names[${!xa_id}]=$name
	done
}

xa_name() {
	xa_id=$1
	echo ${xa_names[xa_id]:-$xa_id}
}

read_intern_atom() {
	#local unused=$1
	shift
	local name=$1

	local root=${screen_0[root]}
	local xaname=$name

	readpad 4
	read32 atom
	readpad 20

	log '< Atom %s = %d\n' $name $atom

	[[ ${xaname::1} == '_' ]] || xaname="_$xaname"
	xaname="XA$xaname"

	printf -v $xaname $atom

	xa_names[atom]=$name

	case $name in
		_NET_CURRENT_DESKTOP) 
			send_change_property $root $X_PropModeReplace $atom $XA_CARDINAL 32 1 $current_desktop 
			;;
		_NET_NUMBER_OF_DESKTOPS) 
			send_change_property $root $X_PropModeReplace $atom $XA_CARDINAL 32 1 $desktop_count
			;;
		WM_PROTOCOLS)
			property_change_handlers[XA_WM_PROTOCOLS]=wm_protocols_changed
	esac
}

send_set_wm_class() {
	local instance=$1
	local class=$2
	local len_instance=${#instance}
	local len_class=${#class}
	local bytes=()
	local i

	for (( i=0 ; i<len_instance ; i++ )); do
		bytes+=( "'${instance:i:1}" )
	done
	bytes+=( 0 )
	for (( i=0 ; i<len_class ; i++ )); do
		bytes+=( "'${class:i:1}" )
	done

	send_change_property ${screen_0[root]} $X_PropModeReplace $XA_WM_CLASS \
		$XA_WM_CLASS 8 ${#bytes[@]} "${bytes[@]}"
}

# Do not call directly to set WM_CLASS
# Use: send_set_wm_class 'instance' 'class' 
#
# When setting XA_UTF8_STRING properties the prop_count may be modified
# if UTF8 conversion adds extra bytes
send_change_property() {
	local windowid=$1
	local mode=$2
	local prop_atom=$3
	local prop_type=$4
	local prop_bits=$5
	local prop_count=$6

	shift 6
	local prop_value=( "$@" )

	local LC_TYPE=C
	if (( prop_type == XA_UTF8_STRING )); then
		LC_TYPE=C.UTF8
		local len=${#prop_value}
		(( len <= prop_count )) || prop_count=$len
	fi

	local bytes=$(( prop_count * prop_bits / 8 ))
	local pad=${ pad4 $bytes; }
	local req_len=$(( 6 + (bytes + pad) / 4 ))
	local i

	log '> Change Property %s for window %s\n' ${ xa_name $prop_atom; } $windowid

	log 'Bits=%d, Count=%d, Bytes=%d, No of Values=%d, Req_Len=%d\n' \
		$prop_bits $prop_count $bytes ${#prop_value[@]} $req_len

	if (( prop_bits%8 )); then
		log 'Invalid format %s\n' $prop_bits
		return
	fi

	beginrequest $X_ChangeProperty $mode $req_len
	write32 $windowid
	write32 $prop_atom
	write32 $prop_type
	write8 $prop_bits
	writepad 3
	write32 $prop_count

	if (( prop_type == XA_STRING || prop_type == XA_UTF8_STRING )); then
		writechars $prop_count $prop_value
	else
		for (( i=0 ; i<$prop_count ; i++ )); do
			write$prop_bits ${prop_value[i]}
		done
	fi
	writepad $pad
}

send_get_property() {
	local windowid=$1
	local atom=$2
	local atom_type=$3
	local length=$4
	local start=${5:-0}

	log '> Get property %s for window %d\n' ${ xa_name $atom; } $windowid
	beginrequest $X_GetProperty 0 6 read_get_property $windowid $atom $start
	write32 $windowid
	write32 $atom
	write32 $atom_type
	write32 $start
	write32 $length
}

read_get_property() {
	local format=$1
	local windowid=$2
	local atom=$3
	local start=$4
	local reply_len atom_type length bytes_after
	local item val byte_count i

	read32 reply_len
	read32 atom_type
	read32 bytes_after
	read32 length
	readpad 12

	if (( format%8 )); then
		log 'Invalid format %s\n' $format
		return
	fi

	log '< Property %s for window %d, length %d\n' ${ xa_name $atom; } $windowid $length

	(( $length  )) || return

	local -n window=window_$windowid

	if (( $start )); then
		val=" ${window[$atom]}"
	fi

	case $atom_type in
		$XA_WM_CLASS)
			# Special handling for WM_CLASS - 2 Null terminated strings
			readstring item
			val+="${item@Q}"
			readchars $((length - ${#item} - 1)) item
			val+=" ${item@Q}"
			;;
		$XA_STRING)
			readchars $length item
			val+="$item"
			;;
		$XA_UTF8_STRING)
			readutf8 $length item
			val+="$item"
			;;
		*)
			for (( i=0 ; i < length ; i++ )); do
				read${format} item
				val+=" $item"
			done
			val=${val:1}
			;;
	esac

	byte_count=$(( length * format / 8 ))
	readpad4 $byte_count

	window[$atom]="$val"

	if (( bytes_after )); then
		(( start += byte_count ))
		(( bytes_after -= byte_count ))
		send_get_property $windowid $atom $atom_type $bytes_after $start
	else
		property_changed $windowid $atom
	fi
}

send_set_input_focus() {
	local windowid=$1
	local timestamp=$2

	log '> Set Input Focus to window %s\n' $windowid

	beginrequest $X_SetInputFocus $X_PointerRoot 3
	write32 $windowid
	write32 $timestamp
}

send_protocol_message() {
	local windowid=$1
	local protocol=$2

	log '> Send Client Message (Protocol %s) to window %s\n' $protocol $windowid

	beginrequest $X_SendEvent 0 11
	write32 $windowid
	write32 $X_NoEventMask

	write8 $X_ClientMessage
	write8 32
	write16 0
	write32 $windowid
	write32 $XA_WM_PROTOCOLS
	write32 $protocol
	writepad 16
}

wm_protocols_changed() {
	local windowid=$1
	local -n window=window_$windowid
	local protocols=${window[$XA_WM_PROTOCOLS]}
	local protocol

	log 'Protocols changed for window %s to %s\n' $windowid "${protocols[*]}"

	window[take_focus]=0
	window[delete_window]=0
	for protocol in $protocols; do
		case $protocol in
			$XA_WM_TAKE_FOCUS)    window[take_focus]=1 ;;
			$XA_WM_DELETE_WINDOW) window[delete_window]=1 ;;
			*) ;;
		esac
	done
}

wm_hints_changed() {
	local windowid=$1
	local -n window=window_$windowid
	local hints=( ${window[$XA_WM_HINTS]} 1 1 )

	log 'Hints changed for window %s to %s\n' $windowid "${hints[*]}"

	window[input]=$(( hints[0] & 1 && hints[1] ))
}

property_changed() {
	local windowid=$1
	local atom=$2
	local handler="${property_change_handlers[atom]}"

	log 'Window %s Property %d handled by %s\n' $windowid $atom $handler
	
	[[ $handler ]] && $handler $windowid $atom
}

send_delete_property() {
	local windowid=$1
	local atom=$2

	log '> Delete property %s for window %s\n' ${ xa_name $atom; } $windowid

	beginrequest $X_DeleteProperty 0 3
	write32 $windowid
	write32 $atom
}

send_query_tree() {
	local root=$1
	shift

	log '> Query Tree\n'

	beginrequest $X_QueryTree 0 2 read_query_tree "$@"
	write32 $root
}

send_get_window_attributes() {
	local windowid=$1

	log '> Get Window Attributes for %s\n' $windowid

	beginrequest $X_GetWindowAttributes 0 2 read_get_window_attributes $windowid
	write32 $windowid
}

send_get_geometry() {
	local windowid=$1

	log '> Get Geometry for %s\n' $windowid

	beginrequest $X_GetGeometry 0 2 $windowid read_get_geometry "$@"
	write32 $windowid
}

read_get_geometry() {
	#local unused=$1
	shift

	local x y width height border_width

	readpad 8
	read16 x
	read16 y
	read16 width
	read16 height
	read16 border_width
	readpad 10

	"$@" $x $y $width $height $border_width
}

read_query_tree() {
	#local unused=$1
	shift

	local num_windows windowid i

	readpad 12
	read16 num_windows
	readpad 14

	local windows=()
	for (( i=0 ; i<num_windows ; i++ )); do
		read32 windowid
		windows+=( $windowid )
	done

	"$@" "${windows[@]}"
}

calculate_workareas() {
	local m

	for m in "${monitors[@]}"; do
		calculate_workarea $m
	done
}

read_adopt_windows() {
	local windowid 

	(( $# )) || return

	log 'Adopting %s windows\n' $#

	for windowid in "$@"; do
		log 'Checking prospective adoption of window %s\n' $windowid
		send_get_window_attributes $windowid
	done

	when_idle calculate_workareas
}

read_get_window_attributes() {
	#local unused=$1
	shift

	local windowid=$1
	local class map_stat override_redirect

	readpad 8
	read16 class
	readpad 12
	read8 map_state
	read8 override_redirect
	readpad 16

	if (( class == X_InputOnly || override_redirect )); then
		# We do not manage input only or override redirect windows
		# But createnotify does not tell us if input only
		# so we may have already created 'window_xxx' array
		[[ -v window_$windowid ]] && unset window_$windowid
		return
	fi

	# Windows we saw created will have x,y,etc
	# But adopted windows will not
	if [[ ! -v window_$windowid[x] ]]; then
		declare -Ag "window_$windowid=(mapped $((map_state != 0)))"
		send_get_geometry $windowid read_adopt_window
	fi
}

read_adopt_window() {
	local windowid=$1
	local x=$2
	local y=$3
	local width=$4
	local height=$5
	local border_width=$6
	local -n window=window_$windowid

	window[x]=$x
	window[y]=$y
	window[width]=$width
	window[height]=$height
	window[border_width]=$border_width

	log 'Adopting\n'
	log_array window_$windowid

	(( window[mapped] )) && pre_map $windowid adopt_window
}

adopt_windows() {
	local root=$1
	local xfd=$2

	send_query_tree $root read_adopt_windows >&${xfd}
}

window_type() {
	local t=$1
	local wm_t=$2

	log 'Window type: t=<%s> wm_t=<%s> -> ' "$t" "$wm_t"
	if [[ -z $t ]]; then
		if [[ $wm_t && $wm_t != $XA_NET_WM_WINDOW_TYPE_NORMAL ]]; then
			t=float
		else
			t=tile
		fi
	fi
	log 't=<%s>\n' "$t"
	echo $t
}

adopt_window() {
	local windowid=$1
	local root=${screen_0[root]}
	local -n window=window_$windowid
	local monitorid

	if [[ ${window[$XA_NET_WM_STRUT_PARTIAL]} ]]; then
		log 'Add strut %s\n' $windowid
		window[type]=strut
		monitorid=${ window_monitor $windowid; }
		log 'target monitor %d\n' $monitorid
		add_strut $monitorid $windowid
	else
		window[desktop]=${window[desktop]:-$current_desktop}
		window[type]=${ window_type \
				"${window[type]}" \
				"${window[$XA_NET_WM_WINDOW_TYPE]}"; }

		case ${window[type]} in
			tile)	add_tile $windowid
				;;
			float)	add_float $windowid
				;;
		esac
	fi

	clientlist_add $windowid
}

allocate_id() {
	if (( last_id )); then
		(( last_id++ ))
	else
		last_id=1
		while (( ! last_id & ${server[resource_id_mask]} )); do
			(( last_id <<= 1))
		done
	fi

	echo $(( ${server[resource_id_base]} | last_id ))
}

add_wmcheck_window() {
	wmcheck_windowid=$(allocate_id)
	log '> WM Check window id=%s\n' $wmcheck_windowid

	beginrequest $X_CreateWindow 0 8
	write32 $wmcheck_windowid
	write32 ${screen_0[root]}
	write16 0
	write16 0
	write16 1
	write16 1
	write16 0
	write16 $X_InputOnly
	write32 $X_CopyFromParent
	write32 0
}

set_wmcheck_window_props() {
	local supported
	local root=${screen_0[root]}

	send_change_property $wmcheck_windowid $X_PropModeReplace \
		$XA_NET_SUPPORTING_WM_CHECK $XA_WINDOW 32 1 $wmcheck_windowid
	send_change_property $wmcheck_windowid $X_PropModeReplace \
		$XA_NET_WM_NAME $XA_UTF8_STRING 8 6 'bashwm'
	send_change_property $root $X_PropModeReplace \
		$XA_NET_SUPPORTING_WM_CHECK $XA_WINDOW 32 1 $wmcheck_windowid
	send_delete_property $root $XA_NET_CLIENT_LIST

	supported=( $XA_NET_CURRENT_DESKTOP $XA_NET_NUMBER_OF_DESKTOPS \
		$XA_NET_ACTIVE_WINDOW $XA_NET_SUPPORTED \
		$XA_NET_WM_STATE $XA_NET_SUPPORTING_WM_CHECK \
		$XA_NET_WM_STATE_FULLSCREEN $XA_NET_WM_WINDOW_TYPE \
		$XA_NET_WM_WINDOW_TYPE_DOCK $XA_NET_WM_WINDOW_TYPE_NORMAL \
		$XA_NET_CLIENT_LIST )

	send_change_property $root $X_PropModeReplace $XA_NET_SUPPORTED \
		$XA_ATOM 32 ${#supported[@]} ${supported[@]}
}

handle_event() {
	local input_type=$1
	log '< No handler for InputType %s\n' $input_type
	# discard unwanted event data
	readpad 31
}

discard_processed() {
	local last=$1
	local current=$2

	if (( last > current )); then
		# Only the lowest 2 bytes of sequence numbers are 
		# transmitted by X Server so we may well roll over
		# Ensure last <= current for recursive call
		discard_processed $((last & 16#FFFF)) $(( 16#FFFF ))
		last=0
	fi

	for(( r=last+1 ; r<=current ; r++ )); do
		unset "request_$r"
	done
}

event_loop() {
	local input_type input_code seq_no handler byte_1 error_code

	while : ; do
		read8 input_type
		input_code=$(( input_type & 16#7F ))

		if ((input_code == $X_Error)); then
			if ! handle_error $input_type; then
				error_code=$?
				log 'Unrecoverable error, exiting...\n'
				return $error_code
			fi
			log 'Recoverable error, continuing...\n'
		else
			handler=${event_handlers[input_code]:-handle_event}
			$handler $input_type
		fi

		(( replies_pending == 0 )) && handle_when_idle
	done
}

when_idle() {
	local cmd=${@@Q}
	idle_handlers+=( "$cmd" )
}

handle_when_idle() {
	local i cmd
	
	for i in ${!idle_handlers[@]}; do
		declare -a cmd="(${idle_handlers[i]})"
		"${cmd[@]}"
		unset 'idle_handlers[i]'
	done
}

handle_error() {
	local code seq_no data major_op_code minor_op_code

	read8 code
	read16 seq_no
	read32 data
	read16 major_op_code
	read8 minor_op_code
	readpad 21

	local res=$code

	case $code in
		$X_BadWindow) res=0
			;;
		$X_BadMatch)
			if (( major_op_code == X_SetInputFocus ||
				major_op_code == X_ConfigureWindow )); then
				res=0
			fi
			;;
		$X_BadAccess)
			if (( major_op_code == X_GrabButton ||
				major_op_code == X_GrabKey )); then
				res=0
			fi
			;;
		0)	# something very wrong
			res=255
			;;
	esac

	log 'Error code: %d\n' $code
	log 'Error seq_no: %d\n' $seq_no
	log 'Error data: %04x\n' $data
	log 'Error op code: %d:%d\n' $major_op_code $minor_op_code

	return $res
}

handle_reply() {
	local reply_byte seq_no

	read8 reply_byte
	read16 seq_no

	local -n reply=reply_$seq_no

	local handler=${reply[handler]}
	[[ $handler ]] || log "Unexpected reply: sequence number = $seq_no"
	log '< Reply %s %s <%s>(%s)\n' $reply_byte $seq_no $handler "${reply[args]}" 
	$handler $reply_byte ${reply[args]}

	handle_after_reply $seq_no

	(( replies_pending-- ))
}

handle_after_reply() {
	local seq_no=$1
	local actions len lenlen action cmd
	if [[ -v after_replies[seq_no] ]]; then
		actions="${after_replies[seq_no]}"
		while (( ${#actions} )); do
			len="${actions%%(*}"
			lenlen=${#len}
			action="${actions:$lenlen:$len}"
			actions="${actions:(( lenlen + len ))}"
			declare -a cmd="$action"
			"${cmd[@]}"
		done
		unset 'after_replies[seq_no]'
	fi
}

count_bits() {
	local mask=$1
	local count=0
	while (( mask )); do
		(( count+=mask&1, mask>>=1 ))
	done
	echo $count
}

handle_configure_notify() {
