select_desktop() {
	local desktopid=$1

	log 'Selecting desktop %d, current %d\n' $desktopid $current_desktop

	(( current_desktop != desktopid )) || return

	local current_monitor=${desktop_monitor[current_desktop]}
	local monitorid=${desktop_monitor[desktopid]}

	log 'Selecting monitor %d, current %d\n' $monitorid $current_monitor

	local -n monitor=monitor_$monitorid

	if (( current_monitor != monitorid )); then
		set_current_desktop ${ list_head monitor desktops; }
	fi

	if (( current_desktop == desktopid )); then
		setlastfocus
	else
		hide_desktop $current_desktop
		set_current_desktop $desktopid
		show_desktop $current_desktop
		list_push monitor desktops $current_desktop
	fi

	send_change_property ${screen_0[root]} $X_PropModeReplace \
		$XA_NET_CURRENT_DESKTOP $XA_CARDINAL 32 1 $desktopid
}

hide_desktop() {
	local desktopid=$1
	local -n desktop=desktop_$desktopid
	local windows=( ${desktop[tiles]} ${desktop[floats]} )

	log 'Hide Desktop %s\n' $desktopid
	log 'Unmapping %s windows\n' ${#windows[@]}
	for id in ${windows[@]}; do
		local -n window=window_$id
		window[mapped]=0
		send_unmap_window $id
		send_delete_property $id $XA_WM_STATE
		remove_id clientlist $id
	done
	send_clientlist_update
}

show_desktop() {
	local desktopid=$1
	local -n desktop=desktop_$desktopid
	local windows=( ${desktop[tiles]} ${desktop[floats]} )

	log 'Show Desktop %s\n' $desktopid
	log 'Mapping %s windows\n' ${#windows[@]}
	for id in ${windows[@]}; do
		local -n window=window_$id
		window[mapped]=1
		send_map_window $id
	done

	clientlist+=( ${windows[@]} )
	send_clientlist_update
}

move_to_desktop() {
	local desktopid=$1

	log 'Move window to desktop %d, current %d\n' $desktopid $current_desktop

	(( current_desktop != desktopid )) || return

	local current_monitor=${desktop_monitor[current_desktop]}
	local monitorid=${desktop_monitor[desktopid]}

	log 'New monitor %d, current %d\n' $monitorid $current_monitor

	local windowid=${screen_0[active]}

	[[ $windowid ]] || return

	local -n window=window_$windowid

	[[ ${window[desktop]} == $current_desktop && 
		${window[type]} =~ tile|float ]] || return

	if (( current_monitor == monitorid )); then	
		send_unmap_window $windowid
		send_delete_property $windowid $XA_WM_STATE
		remove_desktop_window $windowid 1
	else
		remove_desktop_window $windowid 0
	fi
	add_desktop_window $desktopid $windowid
}

delete_window() {
	local windowid=${screen_0[active]}
	(( $windowid )) || return
	local window=window_$windowid

	log 'Delete window %s\n' $windowid

	if (( ${window[delete_window]} )); then
		log 'Using delete_window protocol\n'

		send_protocol_message $windowid $XA_WM_DELETE_WINDOW
	else
		log 'Sending DestroyWindow op code\n'

		send_destroy_window $windowid
	fi
}

list_head() {
	local -n array=$1
	local index=$2
	local list=${array[$index]:1}
	echo ${list%% *}
}

list_remove() {
	local -n array=$1
	local index=$2
	local item=$3
	local list=${array[$index]}
	array[$index]="${list/ $item / }"
}

list_push() {
	local -n array=$1
	local index=$2
	local item=$3
	local list=${array[$index]:-' '}
	array[$index]=" ${item}${list/ $item / }"
}

list_append() {
	local -n array=$1
	local index=$2
	local list=${array[$index]:-' '}
	shift 2
	local item
	for item in "$@"; do
		list="${list/ $item / }${item} "
	done
	array[$index]="$list"
}

desktop_to_monitor() {
	local monitorpos=$1

	(( monitorpos < ${#monitors[@]} )) || return

	local to_monitorid=${monitors[monitorpos]}
	local from_monitorid=${desktop_monitor[current_desktop]}

	(( to_monitorid != from_monitorid )) || return

	log 'Setting desktop_monitor[%d]=%d\n' $current_desktop $to_monitorid

	desktop_monitor[current_desktop]=$to_monitorid

	local -n monitor=monitor_$from_monitorid
	log 'Remove desktop %d from monitor_%d[desktops](%s)\n' $current_desktop $from_monitorid "${monitor[desktops]}"
	list_remove monitor desktops $current_desktop
	desktopid=${ list_head monitor desktops; }
	log 'Got first desktop %d from monitor_%d[desktops](%s)\n' $desktopid $from_monitorid "${monitor[desktops]}"
	[[ $desktopid ]] && show_desktop $desktopid

	local -n monitor=monitor_$to_monitorid
	local desktopid=${ list_head monitor desktops; }
	#log 'Got first desktop %d from monitor_%d[desktops](%s)\n' $desktopid $to_monitorid "${monitor[desktops]}"
	[[ $desktopid ]] && hide_desktop $desktopid
	list_push monitor desktops $current_desktop
	log 'Added desktop %d to monitor_%d[desktops](%s)\n' $current_desktop $to_monitorid "${monitor[desktops]}"
	layout_tiles $current_desktop
	layout_floats $current_desktop

	setlastfocus

	update_viewports
}

wm_exit() {
	exit
}

spawn() {
	export DISPLAY=:$dsp
	/usr/bin/env --default-signal -C "$HOME" setsid -f "$@"
}

