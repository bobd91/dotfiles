move_focus() {
	local direction=$1
	local active=${x_screen_0['active']}
	[[ $active ]] || return
	local -n window=window_$active
	local windowid

	case $window['type'] in
		tile) windowid=${ ${wm_layout}_find_tile $active $direction; } ;;
		float) windowid=${ find_float $active $direction; } ;;
	esac

	[[ $windowid ]] && focus_window $windowid
}

find_float() {
	local windowid=$1
	local direction=$2

	# only called when window is on current desktop
	local -n focuslist=focuslist_$wm_current_desktop
	local count=${#focuslist[@]}
	local floats=()
	local pos current id

	for (( pos=0 ; pos<count ; pos++ )); do
		id=${focuslist[pos]}
		local -n window=window_$id
		[[ ${window['type']} == 'float' ]] || continue
		floats+=( $id )
		if (( focuslist[pos] == windowid )); then
			current=pos
		fi
	done
	[[ $current ]] || 
		die 'Window %s is not a float in the focuslist [%s]\n' \
			$windowid "${floats[*]}"

	count=${#floats[@]}

	case $direction in
		$W_Next|$W_Down|$W_Right|$W_Clockwise) 
			echo ${floats[current + 1 % count}]} ;;
		$W_Previous|$W_Up|$W_Left|$W_AntiClockwise)
			echo ${floats[count + current - 1 % count]} ;;
	esac
}

dynamic_find_tile() {
	local windowid=$1
	local direction=$2

	log 'find_tile from %s in direction %s\n' $windowid $direction

	# Will only be called if window is on current desktop
	local -n desktop=desktop_$wm_current_desktop

	local ids=( ${desktop['tiles']} )
	local count=${#ids[@]}
	log 'tile count=%d, tiles=[%s]' $count "${ids[*]}"

	(( count > 1 )) || return

	local pos
	for (( pos=0 ; pos<count ; pos++ )); do
		(( windowid == ids[pos] )) && break
	done
	(( pos < count )) || 
		die 'Window %s is not in tile list [%s]\n' \
			$windowid "${ids[*]}" 

	case $direction in
		$W_Left)
			(( pos )) && echo ${ids[0]} ;;
		$W_Right)
			(( pos == 0 )) && echo ${ids[1]} ;;
		$W_Previous|$W_AntiClockwise)
			echo ${ids[(count + pos - 1) % count]} ;;
		$W_Next|$W_Clockwise)
			echo ${ids[(pos + 1) % count]} ;;
		$W_Up)
			(( pos > 1 )) && echo ${ids[pos - 1]} ;;
		$W_Down)
			(( pos > 0 && pos < count - 1 )) &&
				echo ${ids[pos + 1]} ;;
	esac
}

move_reposiiton() {
	local active=${x_screen_0['active']}
	[[ $active ]] || return
	local -n window=window_$active
	case ${window['type']} in
		tile) ${wm_layout}_reposition_tile $active $direction;;
		float) reposition_float $active $direction;;
	esac
}

dynamic_reposition_tile() {
	local windowid=$1
	local direction=$2

	local tile=${ dynamic_find_tile $windowid $direction; }

	[[ $tile ]] || return

	local window_pos= dynamic_tile_pos $windowid
	local tile_pos=dynamic_tile_pos $tile

	case $direction in
		$W_Left)
			dynamic_rotate_tiles 1  $window_pos $tile_pos ;;
		$W_AntiClockwise)
			dynamic_rotate_tiles -1 ;;
		$W_Clockwise)
			dynamic_rotate_tiles 1 ;;
		*)
			dynamic_swap_tiles $window_pos $tile_pos ;;
	esac

	layout_desktop $wm_current_desktop
}



