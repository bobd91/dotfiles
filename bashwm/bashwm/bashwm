	x_send_intern_atom _NET_WM_STATE_FULLSCREEN
	x_send_intern_atom _NET_WM_WINDOW_TYPE
	x_send_intern_atom _NET_WM_WINDOW_TYPE_NORMAL
	x_send_intern_atom _NET_WM_STRUT_PARTIAL
	x_send_intern_atom _NET_CLIENT_LIST
}

select_desktop() {
	local desktopid=$1
	local top_desktop=$current_desktop

	log 'Selecting desktop %d, current %d\n' $desktopid $current_desktop

	(( current_desktop != desktopid )) || return

	local current_monitor=${desktop_monitor[current_desktop]}
	local monitorid=${desktop_monitor[desktopid]}

	log 'Selecting monitor %d, current %d\n' $monitorid $current_monitor

	local -n monitor=monitor_$monitorid

	if (( current_monitor != monitorid )); then
		top_desktop=${ list_head monitor desktops; }
	fi

	if (( top_desktop == desktopid )); then
		set_current_desktop $top_desktop
		setlastfocus
	else
		hide_desktop $top_desktop
		set_current_desktop $desktopid
		show_desktop $current_desktop
		list_push monitor desktops $current_desktop
	fi
}

hide_desktop() {
	local desktopid=$1
	local -n desktop=desktop_$desktopid
	local windows=( ${desktop['tiles']} ${desktop['floats']} )
	local active=${screen_0['active']}
	local id

	log 'Hide Desktop %s\n' $desktopid
	log 'Unmapping %s windows\n' ${#windows[@]}
	for id in ${windows[@]}; do
		local -n window=window_$id

		if (( id == active )); then
			set_active_window 0
			x_send_set_input_focus $X_None $X_CurrentTime
			x_send_unmap_window $id
			x_send_set_input_focus $X_PointerRoot $X_CurrentTime
		else
			x_send_unmap_window $id
		fi

		window['mapped']=$W_Unmapped
		x_send_delete_property $id $XA_WM_STATE
	done
}

show_desktop() {
	local desktopid=$1
	local -n desktop=desktop_$desktopid
	local windows=( ${desktop['tiles']} ${desktop['floats']} )
	local id

	log 'Show Desktop %s\n' $desktopid
	layout_desktop $desktopid
	log 'Mapping %s windows\n' ${#windows[@]}
	for id in ${windows[@]}; do
		local -n window=window_$id
		window['mapped']=$W_Mapped
		x_send_map_window $id
		x_send_change_property $id $X_PropModeReplace \
			$XA_WM_STATE $XA_WM_STATE 32 2 $X_WM_NormalState 0
	done
	setlastfocus
}

move_to_desktop() {
	local desktopid=$1
	local dtop

	log 'Move window to desktop %d, current %d\n' $desktopid $current_desktop

	(( current_desktop != desktopid )) || return

	local current_monitor=${desktop_monitor[current_desktop]}
	local monitorid=${desktop_monitor[desktopid]}

	log 'New monitor %d, current %d\n' $monitorid $current_monitor

	local windowid=${screen_0['active']}

	[[ $windowid ]] || return

	local -n window=window_$windowid

	[[ ${window['desktop']} == $current_desktop && 
		${window['type']} =~ tile|float ]] || return

	dtop=${ list_head monitor_$monitorid desktops; }

	if (( desktopid != dtop )); then	
		remove_desktop_window $windowid 1
		if (( windowid == ${screen_0['active']} )); then
			local -n focuslist=focuslist_$current_desktop
			if (( ${#focuslist[@]} )); then
				setlastfocus
				x_send_unmap_window $windowid
			else
				set_active_window 0
				x_send_set_input_focus $X_None $X_CurrentTime
				x_send_unmap_window $windowid
				x_send_set_input_focus $X_PointerRoot $X_CurrentTime
			fi
		else
			x_send_unmap_window $windowid
		fi
		window['mapped']=$W_Unmapped
		x_send_delete_property $windowid $XA_WM_STATE
	else
		remove_desktop_window $windowid 0
	fi
	add_desktop_window $desktopid $windowid

	layout_desktop $current_desktop
	if (( window['mapped'] )); then
		layout_desktop $desktopid
	fi
}

delete_window() {
	local windowid=${screen_0['active']}
	(( $windowid )) || return
	local -n window=window_$windowid

	log 'Delete window %s\n' $windowid

	if (( window['delete_window'] )); then
		log 'Using delete_window protocol\n'

		x_send_protocol_message $windowid $XA_WM_DELETE_WINDOW
	else
		log 'Sending DestroyWindow op code\n'

		x_send_destroy_window $windowid
	fi
}

list_head() {
	local -n array=$1
	local index=$2
	local list=${array[$index]:1}
	echo ${list%% *}
	echo $head
}

list_remove() {
	local -n array=$1
	local index=$2
	local item=$3
	local list=${array[$index]}
	array[$index]="${list/ $item / }"
}

list_pop() {
	local -n array=$1
	local index=$2
	local list=${array[$index]:1}
	local head=${list%% *}
	array[$index]=${list:${#head}}
	echo $head
}


list_push() {
	local -n array=$1
	local index=$2
	local item=$3
	local list=${array[$index]:-' '}
	array[$index]=" ${item}${list/ $item / }"
}

list_append() {
	local -n array=$1
	local index=$2
	local list=${array[$index]:-' '}
	shift 2
	local item
	for item in "$@"; do
		list="${list/ $item / }${item} "
	done
	array[$index]="$list"
}

desktop_to_monitor() {
	local monitorpos=$1

	(( monitorpos < ${#monitors[@]} )) || return

	local to_monitorid=${monitors[monitorpos]}
	local from_monitorid=${desktop_monitor[current_desktop]}

	(( to_monitorid != from_monitorid )) || return

	log 'Setting desktop_monitor[%d]=%d\n' $current_desktop $to_monitorid

	desktop_monitor[current_desktop]=$to_monitorid

	local -n monitor=monitor_$from_monitorid
	log 'Remove desktop %d from monitor_%d[desktops](%s)\n' $current_desktop $from_monitorid "${monitor['desktops']}"
	list_remove monitor desktops $current_desktop
	desktopid=${ list_head monitor desktops; }
	log 'Got first desktop %s from monitor_%d[desktops](%s)\n' ${desktopid:-<none>} $from_monitorid "${monitor['desktops']}"
	[[ $desktopid ]] && show_desktop $desktopid

	local -n monitor=monitor_$to_monitorid
	local desktopid=${ list_head monitor desktops; }
	log 'Got first desktop %s from monitor_%d[desktops](%s)\n' ${desktopid:-<none>} $to_monitorid "${monitor['desktops']}"
	[[ $desktopid ]] && hide_desktop $desktopid
	list_push monitor desktops $current_desktop
	log 'Added desktop %d to monitor_%d[desktops](%s)\n' $current_desktop $to_monitorid "${monitor['desktops']}"

	layout_desktop $current_desktop 1

	setlastfocus

	update_net_workarea
	update_net_viewport
}

swap_master() {
	local active=${screen_0['active']}

	[[ $active ]] || return

	local -n window=window_$active

	[[ ${window[type]} == tile ]] || return

	local desktopid=${window['desktop']}
	local -n desktop=desktop_$desktopid

	if [[ $active == ${ list_head desktop tiles; } ]]; then
		local master=${ list_pop desktop tiles; }
		local next=${ list_pop desktop tiles; }
		list_push desktop tiles $master
		[[ $next ]] && list_push desktop tiles $next
	else
		list_push desktop tiles $active
	fi
	layout_desktop $desktopid 1
}


