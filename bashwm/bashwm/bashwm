max() {
	(( $1 > $2 )) && echo $1 && return
	echo $2
}

min() {
	(( $1 < $2 )) && echo $1 && return
	echo $2
}

calculate_workarea() {
	local monitorid=$1
	log 'Calculate work area for monitor %s\n' $monitorid

	local -n monitor=monitor_$monitorid

	is_object monitor || die 'No such monitor %s\n' $monitorid

	local left=0
	local right=0
	local top=0
	local bottom=0
	local x=0
	local y=0
	local width=${monitor['width']}
	local height=${monitor['height']}
	local wa_x=${monitor['wa_x']:-0}
	local wa_y=${monitor['wa_y']:-0}
	local wa_width=${monitor['wa_width']:-0}
	local wa_height=${monitor['wa_height']:-0}
	local root=${x_screen_0['root']}
	local id window strut sstrut
	
	log 'Struts: %s\n' "${monitor['struts']}"

	for id in ${monitor['struts']}; do
		log_array window_$id
		local -n window=window_$id
		sstrut="${window[$XA_NET_WM_STRUT_PARTIAL]}"
		log 'Strut: %s\n' "$sstrut"
		strut=( $sstrut )
		(( ${#strut[@]} >= 4 )) || continue
		left=${ max $left ${strut[0]}; }
		right=${ max $right ${strut[1]}; }
		top=${ max $top ${strut[2]}; }
		bottom=${ max $bottom ${strut[3]}; }
	done
	x=$left
	y=$top
	(( width -= left + right ))
	(( height -= top + bottom ))
	
	if (( monitor['wa_x'] == x &&
			monitor['wa_y'] == y &&
			monitor['wa_width'] == width && 
			monitor['wa_height'] == height )); then
		return
	fi

	log 'Work Area for Monitor %s: x=%s y=%s width=%s height=%s\n' \
		$monitorid $x $y $width $height

	monitor['wa_x']=$x
	monitor['wa_y']=$y
	monitor['wa_width']=$width
	monitor['wa_height']=$height

	desktop_dirty ${monitor['desktops']}

}

desktop_dirty() {
	local d

	for d in "$@"; do
		log 'desktop_dirty: <%s>\n' $d
		local -n desktop=desktop_$d
		desktop['dirty']=1
	done
}

update_net_workarea() {
	local vals=()
	local i
	for (( i=0 ; i<wm_desktop_count ; i++ )); do
		local -n monitor=monitor_${wm_desktop_monitor[i]}
		vals+=( ${monitor['wa_x']} \
			${monitor['wa_y']} \
			${monitor['wa_width']} \
			${monitor['wa_height']} )
	done

	[[ ${vals[*]} != ${wm_properties['workarea']} ]] || return

	wm_properties['workarea']=${vals[*]}

	log 'Work area values %s\n' "$wm_properties['workarea']"

	x_send_change_property ${x_screen_0['root']} $X_PropModeReplace \
		$XA_NET_WORKAREA $XA_CARDINAL 32 ${#vals[@]} "${vals[@]}"
}

setlastfocus() {
	local -n focuslist=focuslist_$wm_current_desktop

	setfocus ${focuslist[@]: -1}
}

setfocus() {
	local windowid=$1
	local timestamp=${2:-$X_CurrentTime}

	if (( $windowid )); then
		local -n window=window_$windowid

		log 'Set Focus for window %s\n' $windowid

		log 'Window %s[mapped] = %s\n' $windowid ${window['mapped']} 

		(( window['mapped'] == $W_Mapped )) || return

		if (( window['take_focus'] )); then
			x_send_protocol_message $windowid $XA_WM_TAKE_FOCUS
		else
			x_send_set_input_focus $windowid $timestamp
		fi
	else
		log 'Set focus to PointerRoot\n'

		set_active_window 0
		x_send_set_input_focus $X_PointerRoot $timestamp
	fi
}

set_active_window() {
	local windowid=$1
	local active_window=${x_screen_0['active']:-0}

	log 'SetActiveWindow <%s> -> <%s>\n' "$active_window" "$windowid"

	(( $windowid != $active_window )) || return

	if (( active_window )); then
		local -n window=window_$active_window
		if is_object window; then
			set_border_color $active_window $wm_border_inactive
		fi
	fi

	active_window=$windowid

	x_screen_0['active']=$active_window
	if (( active_window )); then
		local -n window=window_$active_window
		set_border_color $active_window $wm_border_active
		x_send_change_property ${x_screen_0['root']} $X_PropModeReplace \
			$XA_NET_ACTIVE_WINDOW $XA_WINDOW 32 1 $active_window
		set_current_desktop ${window['desktop']}
	else
		x_send_delete_property ${x_screen_0['root']} $XA_NET_ACTIVE_WINDOW
	fi
}

set_current_desktop() {
	desktopid=$1

	(( desktopid != wm_current_desktop )) || return

	log 'SetCurrentDesktop <%s> -> <%s>\n' $wm_current_desktop $desktopid

	wm_current_desktop=$desktopid

	x_send_change_property ${x_screen_0['root']} $X_PropModeReplace \
		$XA_NET_CURRENT_DESKTOP $XA_CARDINAL 32 1 $wm_current_desktop
}

focuslist_add() {
	local windowid=$1
	local -n window=window_$windowid
	local desktopid=${window['desktop']}
	local -n focuslist=focuslist_$desktopid


	remove_id focuslist $windowid

	log 'Adding window %s to focus list for desktop %s\n' $windowid $desktopid

	focuslist+=( $windowid )
}

focuslist_remove() {
	local windowid=$1
	local -n window=window_$windowid
	local desktopid=${window['desktop']}
	local -n focuslist=focuslist_$desktopid

	log 'Removing window %s from focus list for desktop %s\n' $windowid $desktopid

	remove_id focuslist $windowid
}

calc_overlap() {
	local monitorid=$1
	local windowid=$2
	local -n m=monitor_$monitorid
	local -n w=window_$windowid

	local tx=${ max ${m[x]} ${w[x]}; }
	local ty=${ max ${m[y]} ${w[y]}; }
	local bx=${ min $((m[x] + m[width])) $((w[x] + w[width])); }
	local by=${ min $((m[y] + m[height])) $((w[y] + w[height])); }

	log 'Calc Overlap top-left(%d:%d) bottom-right(%d:%d)\n' \
		$tx $ty $bx $by

	if (( tx >= bx || ty >= by )); then
		echo 0
	else
		echo $(( (bx - tx) * (by - ty) ))
	fi
}

window_monitor() {
	local windowid=$1
	local max_overlap=0
	local overlap m
	local monitorid=${x_screen_0['primary']}

	log 'Find monitor for window %d, checking %d wm_monitors\n' $windowid ${#wm_monitors[@]}

	for m in "${wm_monitors[@]}"; do
		overlap=${ calc_overlap $m $windowid; }
		log 'Window %d -> Monitor %d Overlap=%d\n' $windowid $m $overlap
		if (( overlap > max_overlap )); then
			max_overlap=overlap
			monitorid=$m
		fi
	done
	echo $monitorid
}
	
map_window() {
	local windowid=$1
	local root=${x_screen_0['root']}
	local -n window=window_$windowid
	local monitorid desktopid
	local manage=1

	log_array window

	(( window['mapped'] != W_Mapped )) || return

	if [[ ${window[$XA_NET_WM_STRUT_PARTIAL]} ]]; then
		log 'Add strut %s\n' $windowid
		window['type']=strut
		monitorid=${ window_monitor $windowid; }
		log 'target monitor %d\n' $monitorid
		window['monitor']=$monitorid
		list_append monitor_$monitorid struts $windowid
		calculate_workarea $monitorid
		layout_monitor $monitorid
		update_net_workarea
		manage=0
	else
		window_config $windowid
		desktopid=${window['desktop']}
		case ${window['type']} in
			tile)
				log 'Add tile %s\n' $windowid
				list_push desktop_$desktopid tiles $windowid
				layout_tiles $desktopid
				;;
			float)
				log 'Add float %s\n' $windowid
				list_push desktop_$desktopid floats $windowid
				layout_floats $desktopid
				;;
		esac
	fi
	
	is_object window && window['mapped']=$W_Mapped

	x_send_map_window $windowid

	(( manage )) || return

	clientlist_add $windowid

	if (( window['input'] )); then
		focuslist_add $windowid
		setfocus $windowid
	fi
}

add_desktop_window() {
	local desktopid=$1
	local windowid=$2
	local -n window=window_$windowid

	window['desktop']=$desktopid
	case ${window['type']} in
		tile)
			list_push desktop_$desktopid tiles $windowid
			;;
		float)
			list_push desktop_$desktopid floats $windowid
			;;
	esac

	desktop_dirty $desktopid

	if (( window['input'] )); then
		focuslist_add $windowid
	fi
}

remove_desktop_window() {
	local windowid=$1
	local unmapped=$2
	local -n window=window_$windowid

	local desktopid=${window['desktop']}
	[[ $desktopid ]] || return

	local monitorid=${wm_desktop_monitor[desktopid]}
	local type=${window['type']}

	log 'Remove %s window %s from desktop %s\n' $type $windowid $desktopid

	case $type in
		tile)   
			list_remove desktop_$desktopid tiles $windowid
			desktop_dirty $desktopid
			;;
		float) 
			list_remove desktop_$desktopid floats $windowid
			desktop_dirty $desktopid
			;;
	esac

	if (( window['input'] )); then
		log 'Remove window %s from focuslist (active=%s)\n' \
			$windowid ${x_screen_0['active']}

		focuslist_remove $windowid
	fi

	if (( unmapped )); then
		window['mapped']=$W_Unmapped
	fi
	unset 'window[desktop]'
}

is_object() {
	local -n _o=$1
	[[ ${_o@a} == A ]]
}

remove_window() {
	local windowid=$1
	local desktopid

	local -n window=window_$windowid

	case ${window['type']} in
		strut)
			monitorid=${window['monitor']}
			local -n monitor=monitor_$monitorid
			if is_object monitor; then
				list_remove monitor struts $windowid
				calculate_workarea $monitorid
				layout_monitor $monitorid
				update_net_workarea
			fi
			;;
		tile|float)
			desktopid=${window['desktop']}
			if [[ -z $desktopid ]]; then
				log 'Removing window %s without desktop\n' $windowid
				log_array window
				return
			fi
			remove_desktop_window $windowid 0
			layout_desktop $desktopid
			clientlist_remove $windowid
			;;
	esac

	unset 'window'
}

remove_id() {
	local arr=$1
	local -n ids=$arr
	local id=$2
	local list=" ${ids[*]} "

	log 'Removing %s from %s\n' $id "$arr"

	ids=( ${list/ $id / } )

	log 'Remove <%s> from <%s> => (%s)\n' "$id" "$list" "${ids[*]}"
}

clientlist_add() {
	local windowid=$1

	[[ $clientlist =~ " $windowid " ]] && return

	clientlist+=( $windowid )

	send_clientlist_append $windowid
}

clientlist_remove() {
	local windowid=$1

	[[ $clientlist =~ " $windowid " ]] || return

	remove_id clientlist $windowid

	send_clientlist_update
}

send_clientlist_append() {
	local windowid=$1
	local root=${x_screen_0['root']}

	x_send_change_property $root $X_PropModeAppend $XA_NET_CLIENT_LIST \
		$XA_WINDOW 32 1 $windowid
}

send_clientlist_update() {
	local root=${x_screen_0['root']}

	if (( ${#clientlist[@]} )); then
		x_send_change_property $root $X_PropModeReplace \
			$XA_NET_CLIENT_LIST $XA_WINDOW 32 \
			${#clientlist[@]} ${clientlist[@]}
	else
		x_send_delete_property $root $XA_NET_CLIENT_LIST
	fi
}


change_window_state() {
	local windowid=$1
	local prop=$2
	local action=${3:-$X_NET_WM_StateToggle}
	local is_present if_present if_absent

	local -n window=window_$windowid
	local state=${window['state']:-' '}

	log 'Change window %s state from (%s) with property %s, action %s\n' \
		$windowid "$state" ${ xa_name prop; } $action 

	case $action in
		$X_NET_WM_StateRemove ) if_present=1  ;;
		$X_NET_WM_StateAdd )    if_absent=1   ;;
		$X_NET_WM_StateToggle ) if_present=1; if_absent=1 ;;
		* ) fail "Invalid change_window_state action %s\n" $action
	esac
	
	[[ $state =~ " $prop " ]] && is_present=1
	(( if_present && is_present )) && state="${state/$prop / }"
	(( if_absent && ! is_present )) && state+="$prop "
	
	window['state']=$state

	log 'Window %s state changed to (%s)\n' $windowid "$state"
}

update_window_state() {
	local windowid=$1
	local action=$2
	shift 2
	local prop

	for prop in "$@"; do
		(( prop == XA_NET_WM_STATE_FULLSCREEN )) || continue
		change_window_state $windowid $prop $action
	done
}

update_fullscreen() {
	local windowid=$1
	local is_fullscreen
	local want_fullscreen=0
	local fs_prop=$XA_NET_WM_STATE_FULLSCREEN
	local -n window=window_$windowid

	is_fullscreen=$(( window['fullscreen'] ))
	[[ ${window['state']} =~ " $fs_prop " ]] && want_fullscreen=1

	if (( ! is_fullscreen && want_fullscreen )); then
		local -n monitor=monitor_${wm_desktop_monitor[window['desktop']]}
		set_window_pos $windowid \
			${monitor['x']} ${monitor['y']} \
			${monitor['width']} ${monitor['height']} \
			0 $X_Above
		window['fullscreen']=1
		x_send_change_property $windowid $X_PropModeReplace \
			$XA_NET_WM_STATE $XA_ATOM 32 1 $XA_NET_WM_STATE_FULLSCREEN
	elif (( is_fullscreen && ! want_fullscreen )); then
		set_window_pos $windowid
		window['fullscreen']=0
		x_send_delete_property $windowid $XA_NET_WM_STATE
	fi
}

handle_client_message() {
	local windowid=$1
	local atom=$2
	shift 2

	log 'ClientMessage %s %s [%s]\n' \
			$windowid ${ xa_name $atom; } "$*"

	case $atom in
	$XA_NET_CURRENT_DESKTOP) 
		select_desktop $1 
		;;
	$XA_NET_WM_STATE)
		is_object window_$windowid || return
		update_window_state $windowid $1 $2 $3
		update_fullscreen $windowid
		;;
	esac
}



select_desktop() {
	local desktopid=$1
	local top_desktop=$wm_current_desktop

	log 'Selecting desktop %d, current %d\n' $desktopid $wm_current_desktop

	(( wm_current_desktop != desktopid )) || return

	local current_monitor=${wm_desktop_monitor[wm_current_desktop]}
	local monitorid=${wm_desktop_monitor[desktopid]}

	log 'Selecting monitor %d, current %d\n' $monitorid $current_monitor

	local -n monitor=monitor_$monitorid

	if (( current_monitor != monitorid )); then
		top_desktop=${ list_head monitor desktops; }
	fi

	if (( top_desktop == desktopid )); then
		set_current_desktop $top_desktop
		setlastfocus
	else
		hide_desktop $top_desktop
		set_current_desktop $desktopid
		show_desktop $wm_current_desktop
		list_push monitor desktops $wm_current_desktop
	fi
}

hide_desktop() {
	local desktopid=$1
	local -n desktop=desktop_$desktopid
	local windows=( ${desktop['tiles']} ${desktop['floats']} )
	local active=${x_screen_0['active']}
	local id

	log 'Hide Desktop %s\n' $desktopid
	log 'Unmapping %s windows\n' ${#windows[@]}
	for id in ${windows[@]}; do
		local -n window=window_$id

		if (( id == active )); then
			set_active_window 0
			x_send_set_input_focus $X_None $X_CurrentTime
			x_send_unmap_window $id
			x_send_set_input_focus $X_PointerRoot $X_CurrentTime
		else
			x_send_unmap_window $id
		fi

		window['mapped']=$W_Unmapped
	done
}

show_desktop() {
	local desktopid=$1
	local -n desktop=desktop_$desktopid
	local windows=( ${desktop['tiles']} ${desktop['floats']} )
	local id

	log 'Show Desktop %s\n' $desktopid
	layout_desktop $desktopid
	log 'Mapping %s windows\n' ${#windows[@]}
	for id in ${windows[@]}; do
		local -n window=window_$id
		window['mapped']=$W_Mapped
		x_send_map_window $id
	done
	setlastfocus
}

move_to_desktop() {
	local desktopid=$1
	local dtop

	log 'Move window to desktop %d, current %d\n' $desktopid $wm_current_desktop

	(( wm_current_desktop != desktopid )) || return

	local current_monitor=${wm_desktop_monitor[wm_current_desktop]}
	local monitorid=${wm_desktop_monitor[desktopid]}

	log 'New monitor %d, current %d\n' $monitorid $current_monitor

	local windowid=${x_screen_0['active']}

	[[ $windowid ]] || return

	local -n window=window_$windowid

	[[ ${window['desktop']} == $wm_current_desktop && 
		${window['type']} =~ tile|float ]] || return

	dtop=${ list_head monitor_$monitorid desktops; }

	if (( desktopid != dtop )); then	
		remove_desktop_window $windowid 1
		if (( windowid == ${x_screen_0['active']} )); then
			local -n focuslist=focuslist_$wm_current_desktop
			if (( ${#focuslist[@]} )); then
				setlastfocus
				x_send_unmap_window $windowid
			else
				set_active_window 0
				x_send_set_input_focus $X_None $X_CurrentTime
				x_send_unmap_window $windowid
				x_send_set_input_focus $X_PointerRoot $X_CurrentTime
			fi
		else
			x_send_unmap_window $windowid
		fi
		window['mapped']=$W_Unmapped
	else
		remove_desktop_window $windowid 0
	fi
	add_desktop_window $desktopid $windowid

	layout_desktop $wm_current_desktop
	if (( window['mapped'] )); then
		layout_desktop $desktopid
	fi
}

change_window_events() {
	local windowid=$1
	local event_mask=$2

	x_send_change_window_attributes $windowid $X_CWEventMask $event_mask
}

delete_window() {
	local windowid=${x_screen_0['active']}
	(( $windowid )) || return
	local -n window=window_$windowid

	log 'Delete window %s\n' $windowid

	if (( window['delete_window'] )); then
		log 'Using delete_window protocol\n'

		x_send_protocol_message $windowid $XA_WM_DELETE_WINDOW
	else
		log 'Sending DestroyWindow op code\n'

		x_send_destroy_window $windowid
	fi
}

list_head() {
	local -n array=$1
	local index=$2
	local list=${array[$index]:1}
	echo ${list%% *}
	echo $head
}

list_remove() {
	local -n array=$1
	local index=$2
	local item=$3
	local list=${array[$index]}
	array[$index]="${list/ $item / }"
}

list_pop() {
	local -n array=$1
	local index=$2
	local list=${array[$index]:1}
	local head=${list%% *}
	array[$index]=${list:${#head}}
	echo $head
}


list_push() {
	local -n array=$1
	local index=$2
	local item=$3
	local list=${array[$index]:-' '}
	array[$index]=" ${item}${list/ $item / }"
}

list_append() {
	local -n array=$1
	local index=$2
	local list=${array[$index]:-' '}
	shift 2
	local item
	for item in "$@"; do
		list="${list/ $item / }${item} "
	done
	array[$index]="$list"
}

desktop_to_monitor() {
	local monitorpos=$1

	(( monitorpos < ${#wm_monitors[@]} )) || return

	local to_monitorid=${wm_monitors[monitorpos]}
	local from_monitorid=${wm_desktop_monitor[wm_current_desktop]}

	(( to_monitorid != from_monitorid )) || return

	log 'Setting wm_desktop_monitor[%d]=%d\n' $wm_current_desktop $to_monitorid

	wm_desktop_monitor[wm_current_desktop]=$to_monitorid

	local -n monitor=monitor_$from_monitorid
	log 'Remove desktop %d from monitor_%d[desktops](%s)\n' $wm_current_desktop $from_monitorid "${monitor['desktops']}"
	list_remove monitor desktops $wm_current_desktop
	desktopid=${ list_head monitor desktops; }
	log 'Got first desktop %s from monitor_%d[desktops](%s)\n' ${desktopid:-<none>} $from_monitorid "${monitor['desktops']}"
	[[ $desktopid ]] && show_desktop $desktopid

	local -n monitor=monitor_$to_monitorid
	local desktopid=${ list_head monitor desktops; }
	log 'Got first desktop %s from monitor_%d[desktops](%s)\n' ${desktopid:-<none>} $to_monitorid "${monitor['desktops']}"
	[[ $desktopid ]] && hide_desktop $desktopid
	list_push monitor desktops $wm_current_desktop
	log 'Added desktop %d to monitor_%d[desktops](%s)\n' $wm_current_desktop $to_monitorid "${monitor['desktops']}"

	layout_desktop $wm_current_desktop 1

	setlastfocus

	update_net_workarea
	update_net_viewport
}

swap_master() {
	local active=${x_screen_0['active']}

	[[ $active ]] || return

	local -n window=window_$active

	[[ ${window[type]} == tile ]] || return

	local -n desktop=desktop_$wm_current_desktop

	if [[ $active == ${ list_head desktop tiles; } ]]; then
		local master=${ list_pop desktop tiles; }
		local next=${ list_pop desktop tiles; }
		list_push desktop tiles $master
		[[ $next ]] && list_push desktop tiles $next
	else
		list_push desktop tiles $active
	fi
	layout_desktop $wm_current_desktop 1
}


