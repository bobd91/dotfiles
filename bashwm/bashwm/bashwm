x_send_query_extension() {
	local name=$1

	local name_len=${#name}
	local pad=$(pad4 $name_len)
	
	beginrequest 'QueryExtension %s' $name
	setreplyhandler x_read_query_extension "$@"
	{
	write8 $X_QueryExtension
	write8 0
	write16 $((2+(name_len + pad) / 4))
	write16 $name_len
	writepad 2
	writechars $name_len $name
	writepad $pad
	} >&${xfd}
}

x_read_query_extension() {
	#local unused=$1
	local name=$2
	local handler=$3
	shift 3
	local present opcode event error

	beginreply 'QueryExtension %s' $name
	{
	readpad 4
	read8 present
	read8 opcode
	read8 event
	read8 error
	readpad 20
	} <&${xfd}

	log 'Extension present=%d opcode=%d event=%d error=%d\n' \
		$present $opcode $event $error

	if (( $present )); then
		declare -Ag "extension_$name=( \
			opcode $opcode \
			event $event \
			error $error)"
	fi

	log 'Calling %s\n' "$handler $present"
	$handler $present "$@"
}

x_send_get_atom_name() {
	local atom=$1

	beginrequest 'GetAtomName %d' $atom
	setreplyhandler x_read_get_atom_name $atom
	{
	write8 $X_GetAtomName
	write8 0
	write16 2
	write32 $atom
	} >&${xfd}
}

x_read_get_atom_name() {
	#local unused=$1 
	local atom=$2
	local reply_length name_length name

	beginreply 'GetAtomName %d' $atom
	{
	read32 reply_length
	read16 name_length
	readpad 22
	readchars $name_length name
	readpad4 $name_length
	} <&${xfd}

	log '< GetAtomName %d = %s\n' $atom "$name"

	xa_names[$atom]="$name"
}

extension_opcode() {
	local name=$1

	local -n extension=extension_$name
	echo ${extension[opcode]}
}

x_send_rr_query_version() {
	local present=$1
	shift

	if (( $present == 0 )); then
		log 'No RANDR extension, using entire screen\n'
		no_rr_setup
	else
		beginrequest 'RRQueryVersion'
		setreplyhandler x_read_rr_query_version "$@"
		{
		write8 ${ extension_opcode $X_RANDR_NAME; }
		write8 $X_RRQueryVersion
		write16 3
		write32 $X_RANDR_MAJOR
		write32 $X_RANDR_MINOR
		} >&${xfd}
	fi
}

x_read_rr_query_version() {
	#local unused=$1

	local major minor
	local RR_MINOR_REQD=2

	beginreply "RRQueryVersion"
	{
	readpad 4
	read32 major
	read32 minor
	readpad 16
	} <&${xfd}

	if (( major < X_RANDR_MAJOR || (major == X_RANDR_MAJOR && minor < RR_MINOR_REQD) )); then
		log 'RANDR incompatible version (%d.%d), using single monitor\n' \
			$major $minor
		no_rr_setup
	else
		log 'RANDR initialized\n'
		rr_setup $major $minor
	fi
}

x_send_rr_get_monitors() {

	beginrequest 'RRGetMonitors'
	if (( $# )); then
		setreplyhandler "$@"
	else
		setreplyhandler x_read_rr_get_monitors
	fi
	{
	write8 ${ extension_opcode $X_RANDR_NAME; }
	write8 $X_RRGetMonitors
	write16 3
	write32 ${screen_0['root']}
	write8 1
	writepad 3
	} >&${xfd}
}

x_discard_rr_get_monitors() {
	local reply_length timestamp nmonitors tnoutputs

	beginreply 'Discarding RRGetMonitors'
	{
	read32 reply_length
	read32 timestamp
	read32 nmonitors
	read32 tnoutputs
	readpad 12
	readpad $((24 * nmonitors + 4 * tnoutputs))
	} <&${xfd}
}

x_read_rr_get_monitors() {
	#local unused=$1
	local reply_length timestamp nmonitors tnoutputs
	local m o outputs output

	beginreply 'RRGetMonitors'
	{
	read32 reply_length
	read32 timestamp
	read32 nmonitors
	read32 tnoutputs
	readpad 12

	# Would be nice to use timestamp to skip get_monitors responses when
	# there is no change but the timestamp doesn't get updated on
	# randr set/del monitor requests so we have to compare the reply data

	for (( m=0 ; m<nmonitors ; m++ )); do
		declare -Ag tmon_$m
		local -n tmon=tmon_$m
		read32 tmon['name_atom']
		read8 tmon['primary']
		read8 tmon['auto']
		read16 tmon['noutputs']
		read16 tmon['x']
		read16 tmon['y']
		read16 tmon['width']
		read16 tmon['height']
		read32 tmon['width_mm']
		read32 tmon['height_mm']

		outputs=" "
		for (( o=0 ; o<tmon['noutputs'] ; o++ )); do
			read32 output
			outputs+="$output "
		done
		tmon['outputs']=$output
	done
	} <&${xfd}

	update_monitors $nmonitors
}

update_monitors() {
	local nmonitors=$1

	local name m monitorid name_atom
	local prev_monitors=" ${monitors[*]} "
	monitors=()
	unset 'screen_0['primary']'

	log 'Update Monitors nmonitors=%d\n' $nmonitors
	for (( m=0 ; m<nmonitors ; m++ )); do
		local -n tmon=tmon_$m

		log 'Monitor %s primary=%s auto=%s noutputs=%s x=%s y=%s width=%s height=%s\n' \
			${tmon['name_atom']} ${tmon['primary']} ${tmon['auto']} \
			${tmon['noutputs']} \
			${tmon['x']} ${tmon['y']} ${tmon['width']} ${tmon['height']}

		name_atom=${tmon['name_atom']}
		monitorid=$name_atom

		name=${xa_names[name_atom]}
		[[ $name ]] || x_send_get_atom_name $name_atom

		(( primary )) && screen_0['primary']=$monitorid

		monitor_config $m

		monitors+=( $monitorid )
		prev_monitors=${prev_monitors/ $monitorid / }

		unset 'tmon'
	done

	screen_0['primary']=${screen_0['primary']:-${monitors[0]}}

	for m in $prev_monitors; do
		monitor_remove $m
	done

	desktop_monitor_config

	update_workareas 

	for m in "${monitors[@]}"; do
		layout_monitor $m
	done

	update_net_viewport

	when_idle monitors_update_notify
}
#
# override in config.sh to update status bar(s) after monitor change
monitors_update_notify() {
	: 
}

update_net_viewport() {
	local i
	local vals=()

	for (( i=0 ; i<desktop_count ; i++ )); do
		local -n monitor=monitor_${desktop_monitor[i]}
		vals+=( ${monitor['x']} ${monitor['y']} )
	done

	[[ ${vals[*]} != ${properties['viewport']} ]] || return

	properties['viewport']=${vals[*]}

	x_send_change_property ${screen_0['root']} $X_PropModeReplace \
		$XA_NET_DESKTOP_VIEWPORT $XA_CARDINAL 32 ${#vals[@]} "${vals[@]}"
}

monitor_remove() {
	local monitorid=$1
	local -n monitor=monitor_$monitorid
	local struts=${monitor['struts']}
	local desktops=${monitor['desktops']}
	local primary=${screen_0['primary']}
	local s d

	for s in $struts; do
		unset 'window_$s'
	done

	for d in $desktops; do
		log 'Setting desktop_monitor[%s]=%s\n' $d $primary
		desktop_monitor[d]=$primary
	done

	list_append monitor_$primary desktops $desktops
	desktop_dirty $desktops

	local rtop=${ list_head monitor_$monitorid desktops; }
	local ptop=${ list_head monitor_$primary desktops; }

	if [[ $rtop ]]; then
		if (( $rtop == $ptop )); then
			layout_desktop $rtop
			setlastfocus
		else
			hide_desktop $rtop
		fi
	fi

	unset 'monitor'
}

monitor_config() {
	local tmonid=$1
	local -n tmon=tmon_$tmonid

	local monitorid=${tmon['name_atom']:-0}
	local primary=${tmon['primary']:-1}
	local auto=${tmon['auto']:-1}
	local x=${tmon['x']:-0}
	local y=${tmon['y']:-0}
	local width=${tmon['width']:-${screen_0['width_pixels']}}
	local height=${tmon['height']:-${screen_0['height_pixels']}}

	local -n monitor=monitor_$monitorid

	if ! is_object monitor; then
		log 'declaring monitor_%s\n' $monitorid
		declare -Ag "monitor_$monitorid=( \
			wa_x 0 \
			wa_y 0 \
			wa_width $width \
			wa_height $height \
			desktops ' ' \
			struts ' ' \
			)"
		local -n monitor=monitor_$monitorid
	fi
	monitor['name_atom']=$monitorid
	monitor['primary']=$primary
	monitor['auto']=$auto
	monitor['x']=$x
	monitor['y']=$y
	monitor['width']=$width
	monitor['height']=$height
	monitor['outputs']=${tmon['outputs']}
}

layout_monitor() {
	local monitorid=$1

	log 'Layout monitor %d\n' $monitorid
	local desktopid=${ list_head monitor_$monitorid desktops; }
	[[ $desktopid ]] && layout_desktop $desktopid
}

rr_setup() {
	#local major=$1
	#local minor=$1

	# Run get monitors directly
	x_send_rr_get_monitors
}

desktop_monitor_config() {
	local d
	local primary=${screen_0['primary']}

	if (( ${#desktop_monitor} == 0 )); then
		for (( d=0 ; d<desktop_count ; d++ )); do
			desktop_monitor[d]=$primary
			declare -Ag "desktop_$d=( dirty 1 )"
			list_append monitor_$primary desktops $d
		done
	else
		for (( d=0 ; d<desktop_count ; d++ )); do
			desktop_dirty $d
		done
	fi
}

no_rr_setup() {
	screen_0['primary']=0
	monitors=( 0 )

	monitor_config
	desktop_monitor_config

	layout_monitor 0

	update_net_workarea
	update_net_viewport
}

