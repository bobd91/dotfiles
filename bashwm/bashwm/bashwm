	x_send_query_extension $X_RANDR_NAME x_send_rr_query_version
	intern_atoms
	x_send_get_keyboard_mapping
	x_send_change_window_events $root $root_events
	x_send_create_wmcheck_window

	when_idle adopt_windows
	[[ $autostart ]] && when_idle $autostart

	event_loop
}

	

