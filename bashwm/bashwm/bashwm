link_append_ids() {
	local src=$1
	local srcid=$2
	local tgt=$3
	local tgtid=$4
	local tgts=${tgt}s

	local -n target=${tgt}_${tgtid}

	log 'link_append_ids: %s\n' "$*"

	if list_member ${src}_${srcid} ${tgts} ${tgtid}; then
		log '  ERROR: %s already in %s_%s[%s]\n' \
			${tgtid} ${src} ${srcid} ${tgts}
	fi
	if [[ ${target[$src]} ]]; then
		log '  ERROR: %s_%s[%s] is linked to %s_%s' \
			${tgt} ${tgtid} ${src} ${target[$src]}
	fi

	list_push ${src}_$srcid ${tgts} $tgtid
	target[$src]=$srcid
}

link_push_ids() {
	local src=$1
	local srcid=$2
	local tgt=$3
	local tgtid=$4
	local tgts=${tgt}s

	local -n target=${tgt}_${tgtid}

	log 'link_push_ids: %s\n' "$*"

	if list_member ${src}_${srcid} ${tgts} ${tgtid}; then
		log '  ERROR: %s already in %s_%s[%s]\n' \
			${tgtid} ${src} ${srcid} ${tgts}
	fi
	if [[ ${target[$src]} ]]; then
		log '  ERROR: %s_%s[%s] is linked to %s_%s' \
			${tgt} ${tgtid} ${src} ${target[$src]}
	fi

	list_push ${src}_$srcid ${tgts} $tgtid
	target[$src]=$srcid
}

unlink_ids() {
	local src=$1
	local srcid=$2
	local tgt=$3
	local tgtid=$4

	local -n target=${tgt}_${tgtid}

	log 'unlink_ids: %s\n' "$*"

	if ! list_member ${src}_${srcid} ${tgts} ${tgtid}; then
		log '  ERROR: %s not in %s_%s[%s]\n' \
			${tgtid} ${src} ${srcid} ${tgts}
	fi
	if [[ ${target[$src]} != $srcid ]]; then
		log '  ERROR: %s_%s[%s] is not linked to %s_%s (is %s)' \
			${tgt} ${tgtid} ${src} ${srcid} ${target[$src]:-empty} 
	fi

	list_remove ${src}_$srcid ${tgts} $tgtid
	unset 'target[$src]'
}

log_monitor() {
