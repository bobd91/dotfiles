request_get_monitors() {
	getmonitors=1
}

process_get_monitors() {
	(( getmonitors )) || return 1
	getmonitors=0
	x_send_rr_get_monitors read_get_monitors
	return 0
}

read_get_monitors() {
	# If another request_get_monitors has run then discard this reply
	if (( getmonitors )); then
		x_discard_rr_get_monitors
	else
		x_read_rr_get_monitors $1
	fi
}

event_loop() {
	local input_type input_code handler error_code

	while : ; do
		<&${xfd} read8 input_type
		log_time
		input_code=$(( input_type & 16#7F ))

		if ((input_code == $X_Error)); then
			if ! handle_error $input_type; then
				error_code=$?
				log 'Unrecoverable error, exiting...\n'
				return $error_code
			fi
			log 'Recoverable error, continuing...\n'
		else
			handler=${event_handlers[input_code]:-handle_event}
			log 'Running %s\n' $handler
			$handler $input_type
		fi

		log 'Event loop: replies pending=%d, idle queue=%d, get monitors=%d\n' \
			$replies_pending ${#idle_handlers[@]} $getmonitors

		process_replied

		while (( replies_pending == 0 )); do
			process_idle || process_get_monitors || break
		done
	done
}

when_replied() {
	local cmd="$server_seqno $wm_seqno ${@@Q}"
	if [[ $cmd ]]; then
		replied_handlers+=( "$cmd" )
		log 'Replied: Queue handler %s (%d in queue)\n' "$cmd" ${#replied_handler[@]}
	fi
}

process_replied() {
	local key
	local keys=${!replied_handlers[@]}

	[[ $keys ]] || return 1

	key=${keys%% *}
	local -a cmd="(${replied_handlers[$key]})"

	if (( cmd[0] > server_seqno || cmd[1] <= server_seqno )); then
		log 'Replied: Running %s (server=%s, wm=%s)\n' \
			"${cmd[*]}" $server_seqno $wm_seqno
		"${cmd[@]:2}" >>$logfile
		log 'Replied: Complete\n'

		unset 'replied_handlers[$key]'
	fi
}

when_idle() {
	local cmd=${@@Q}
	if [[ $cmd ]]; then
		idle_handlers+=( "$cmd" )
		log 'Idle: Queue handler %s (%d in queue)\n' "$cmd" ${#idle_handlers[@]}
	fi
}

process_idle() {
	local key
	local keys=${!idle_handlers[@]}

	[[ $keys ]] || return 1

	key=${keys%% *}
	local -a cmd="(${idle_handlers[$key]})"

	log 'Idle: Running %s\n' "${cmd[*]}"
	"${cmd[@]}" >>$logfile
	log 'Idle: Complete\n'

	unset 'idle_handlers[$key]'
	return 0
}



handle_error() {
	local code data major_op_code minor_op_code

	beginevent 'Error'
	{
	read8 code
	read16 server_seqno
	read32 data
	read16 major_op_code
	read8 minor_op_code
	readpad 21
	} <&${xfd}

	local res=$code

	case $code in
		$X_BadWindow) res=0
			;;
		$X_BadMatch)
			if (( major_op_code == X_SetInputFocus ||
				major_op_code == X_ConfigureWindow )); then
				res=0
			fi
			;;
		$X_BadAccess)
			if (( major_op_code == X_GrabButton ||
				major_op_code == X_GrabKey )); then
				res=0
			fi
			;;
		0)	# something very wrong
			res=255
			;;
	esac

	remove_reply $server_seqno

	log 'Error code: %d\n' $code
	log 'Error seq_no: %d\n' $server_seqno
	log 'Error data: %04x\n' $data
	log 'Error op code: %d:%d\n' $major_op_code $minor_op_code

	return $res
}

handle_reply() {
	local reply_byte 

	{
	read8 reply_byte
	read16 server_seqno
	} <&${xfd}

	local -n reply=reply_$server_seqno

	local handler=${reply[handler]}
	[[ $handler ]] || die 'Unexpected reply: sequence number %d\n' $server_seqno

	log 'Reply %s: %s(%s %s)\n' $server_seqno $handler $reply_byte "${reply[args]}" 
	$handler $reply_byte ${reply[args]}

	remove_reply $server_seqno
}

remove_reply() {
	local seq_no=$1
	local -n reply=reply_$seq_no
	if (( ${#reply[@]} )); then
		unset reply
		(( replies_pending-- ))
	fi
}

count_bits() {
	local mask=$1
	local count=0
	while (( mask )); do
		(( count+=mask&1, mask>>=1 ))
	done
	echo $count
}

handle_configure_notify() {
	local event window above x y width height border_width 
	local override_redirect
	local root=${screen_0['root']}

	beginevent 'ConfigureNotify'
	{
	readpad 1
	read16 server_seqno
	read32 event
	read32 window
	readpad 20
	} <&${xfd}

	log '< ConfigureNotify for event %s window %s\n' $event $window

	# When xrandr changes monitor/output config root gets a ConfigureNotify
	# We can get lots in a short period as outputs/crtcs get unconfigured 
	# and then reconfigured 
	# The event loop will only request the updated monitor configuration
	# when there are no pending replies or events
	(( event == root && window == root )) && request_get_monitors
}

handle_create_notify() {
	local windowid x y width height border_width override_redirect

	beginevent 'CreateNotify'
	{
	readpad 1
	read16 server_seqno
	readpad 4
	read32 windowid
	readi16 x
	readi16 y
	read16 width
	read16 height
	read16 border_width
	read8 override_redirect
	readpad 9
	} <&${xfd}

	log 'CreateNotify for window %s, override_redirect %s\n' $windowid $override_redirect

	(( override_redirect )) && return

	process_create_notify $windowid $x $y $width $height $border_width 
}

process_create_notify() {
	local windowid=$1
	local x=$2
	local y=$3
	local width=$4
	local height=$5
	local border_width=$6

	log 'Process CreateNotify Event %s\n' $windowid

	if [[ $windowid == $wmcheck_windowid ]]; then
		set_wmcheck_window_props
		return
	fi

	declare -Ag "window_$windowid=( \
		x $x \
		y $y \
		width $width \
		height $height \
		border_width $border_width \
		mapped $W_NotMapped \
		take_focus 0 \
		delete_window 0 \
		)"
	
	log_array window_$windowid

	x_send_get_window_attributes $windowid
}

handle_map_notify() {
	local windowid override_redirect

	beginevent 'MapNotify'
	{
	readpad 1
	read16 server_seqno
	readpad 4
	read32 windowid
	read8 override_redirect
	readpad 19
	} <&${xfd}

	log 'MapNotify for window %s, override_redirect %s\n' $windowid $override_redirect
}

handle_configure_request() {
	local stack_mode parent window windowid sibling
	local x y width height border_width value_mask n

	beginevent 'ConfigureRequest'
	{
	read8 stack_mode
	read16 server_seqno
	read32 parent
	read32 windowid
	read32 sibling
	readi16 x
	readi16 y
	read16 width
	read16 height
	read16 border_width
	read16 value_mask
	readpad 4
	} <&${xfd}

	process_configure_request $windowid $stack_mode $value_mask $x $y $width $height $border_width $sibling 
}

process_configure_request() {
	local windowid=$1
	local stack_mode=$2
	local value_mask=$3
	local x=$4
	local y=$5
	local width=$6
	local height=$7
	local border_width=$8
	local sibling=$9

	log 'Process ConfigureRequest Event %s\n' $windowid

	local -n window=window_$windowid
	if is_object window; then
		log_array window_$windowid
		(( $value_mask & $X_CWX )) && window['x']=$x
		(( $value_mask & $X_CWY )) && window['y']=$y
		(( $value_mask & $X_CWWidth )) && window['width']=$width
		(( $value_mask & $X_CWHeight )) && window['height']=$height
		(( $value_mask & $X_CWBorderWidth )) && window['border_width']=$border_width
		log_array window_$windowid
	fi

	# Configure requested window, even if we are not managing it
	x_send_configure_window "$@"
}

handle_property_notify() {
	local windowid atom state

	beginevent 'PropertyNotify'
	{
	readpad 1
	read16 server_seqno
	read32 windowid
	read32 atom
	readpad 4
	read8 state
	readpad 15
	} <&${xfd}

	log '< PropertyNotify for window %s, %s, state %s\n' \
		$windowid ${ xa_name $atom; } $state
}

handle_enter_notify() {
	local detail timestamp windowid mode flags window

	beginevent 'EnterNotify'
	{
	read8 detail
	read16 server_seqno
	read32 timestamp
	readpad 4
	read32 windowid
	readpad 14
	read8 mode
	read8 flags
	} <&${xfd}

	(( mode == X_NotifyNormal )) || return

	# Non-root window wanted but only if 
	# enter was not from child to parent and was triggered by motion 
	if (( $windowid != ${screen_0['root']} &&
			( detail == X_NotifyInferior || 
			  mode != X_NotifyNormal ) )); then
		return
	fi

	is_object window_$windowid || return

	process_enter_notify $windowid $timestamp
}

process_enter_notify() {
	local windowid=$1
	local timestamp=$2

	log 'Process EnterNotify on window %s detail %s mode %s flags %s\n' \
		$windowid $detail $mode $flags

	# Make sure it is one of our tile/float windows
	local -n window=window_$windowid

	case ${window['type']} in
		tile|float)
			focuslist_add $windowid
			setfocus $windowid $timestamp
			;;
		*)
			setfocus 0 $timestamp
			;;
	esac
}

handle_destroy_notify() {
	local event windowid window

	beginevent 'DestroyNotify'
	{
	readpad 1
	read16 server_seqno
	read32 event
	read32 windowid
	readpad 20
	} <&${xfd}

	(( event == ${screen_0['root']} )) || return

	is_object window_$windowid || return

	process_destroy_notify $windowid
}

process_destroy_notify() {
	local windowid=$1
	local window

	beginprocess 'DestroyWindow %s' $windowid

	# Race condition, window may have existed when we were queued
	# but unmap may have since removed it
	is_object window_$windowid || return

	remove_window $windowid
}

handle_key_press() {
	local keycode keymask keycode_cmd keycmd mask cmd

	beginevent 'KeyPress'
	{
	read8 keycode
	read16 server_seqno
	readpad 24
	read16 keymask
	readpad 2
	} <&${xfd}

	# Don't queue event, process immediately
	key_press_event $keycode $keymask
}

key_press_event() {
	local keycode=$1
	local keymask=$2

	beginprocess 'KeyPress %s' $keycode 

	keycode_cmd="${keycode_command_map[keycode]}" 

	log 'Key commands %s\n' "$keycode_cmd"

	[[ $keycode_cmd ]] || return 0

	IFS=',' read -ra keycmds <<< "$keycode_cmd"
	for keycmd in "${keycmds[@]}"; do

		log 'Key command %s\n' "$keycmd"

		mask="${keycmd%:*}"

		log 'Event Mask %s, Key Mask %s\n' "$mask" "$keymask"

		(( mask == keymask )) || continue

		cmd="${keycmd#*:}"

		log 'Command %s\n' "$cmd"

		$cmd
		break
	done
}

add_tile() {
	local windowid=$1
	local -n window=window_$windowid
	local desktopid=${window['desktop']}

	list_push desktop_$desktopid tiles $windowid
}

add_float() {
	local windowid=$1
	local -n window=window_$windowid
	local desktopid=${window['desktop']}
	
	list_push desktop_$desktopid floats $windowid
}

layout_desktop() {
	local desktopid=$1
	local force=${2:-0}

	local -n desktop=desktop_$desktopid

	log 'layout_desktop: desktop=%s force=%s\n' $desktopid $force 

	log ' :dirty=%s\n' ${desktop['dirty']}

	(( force || desktop['dirty'] )) || return

	log ' :laying out windows\n'

	layout_tiles $desktopid
	layout_floats $desktopid

	desktop['dirty']=0
}

layout_tiles() {
	local desktopid=$1
	local -n desktop=desktop_$desktopid
	local tiles=( ${desktop['tiles']} )
	local monitorid=${desktop_monitor[desktopid]}
	local -n monitor=monitor_$monitorid

	local num_tiles=${#tiles[@]}
	local x=$(( monitor['x'] + monitor['wa_x'] ))
	local y=$(( monitor['y'] + monitor['wa_y'] ))
	local width=${monitor['wa_width']}
	local height=${monitor['wa_height']}
	local window w h hdiff i

	log 'Laying out %d tiles for desktop %d on monitor %d\n' \
		$num_tiles $desktopid $monitorid

	case $num_tiles in
		0)	:
			;;
		1)	set_window_pos ${tiles[0]} \
				$x $y $width $height
			;;
		2)	w=$(( width / 2 ))
			set_window_pos ${tiles[0]} \
				$x $y $w $height
			set_window_pos ${tiles[1]} \
				$((x + w)) $y $((width - w)) $height
			;;
		*)      w=$(( width / 2))
			set_window_pos ${tiles[0]} \
				$x $y $w $height
			(( x+=w, width-=w ))
			h=$(( height / (num_tiles - 1) ))
			hdiff=$(( height - (h * (num_tiles - 1)) ))
			for (( i=1 ; i<num_tiles ; i++ )); do
				set_window_pos ${tiles[i]} \
					$x $y \
					$width $(( h + hdiff ))
				(( y += h + hdiff, hdiff = 0 ))
			done
			;;
	esac
}

# This is broken as floats need to know where they were relative to
# previous work area, and that info is not available here
# For now just make sure all are visible
layout_floats() {
	local desktopid=$1
	local -n desktop=desktop_$desktopid
	local floats=( ${desktop['floats']} )

	local -n monitor=monitor_${desktop_monitor[desktopid]}

	local x=$(( monitor['x'] + monitor['wa_x'] ))
	local y=$(( monitor['y'] + monitor['wa_y'] ))
	local width=${monitor['wa_width']}
	local height=${monitor['wa_height']}

	local window i

	log 'Laying out %d floats\n' ${#floats[@]}

	for f in "${floats[@]}"; do
		log 'Laying out float %s in work area x=%d y=%d width=%d height=%d\n' \
			$f $x $y $width $height

		log_array window_$f

		local -n window=window_$f

		if (( window['width'] >= width )); then
			window['x']=$x
			window['width']=$width
		elif (( window['x'] < x || window['x'] + window['width'] > x + width )); then
			window['x']=$(( x + (width - window['width'])/2 ))
		fi

		if (( window['height'] >= height )); then
			window['y']=$y
			window['height']=$height
		elif (( window['y'] < y || window['y'] +window['height'] > y + height )); then
			window['y']=$(( y + (height - window['height'])/2 ))
		fi

		set_window_pos $f ${window['x']} ${window['y']} \
				${window['width']} ${window['height']}

		log_array window_$f
	done
}

