#!/usr/bin/env bash

# TODO: get working again after rework

die() {
	log "$@"
	exit 1
}

raw_log() {
	printf "$@" >> $logfile ||
		printf 'printf failed: %s\n' "$*" >> $logfile
}

log() {
	if [[ $last_log ]]; then
		last_log=''
		raw_log '\n'
	fi
	raw_log "$@"
}

log_time() {
	log '%(%Y-%m-%d %H:%M:%S)T\n'
}

log_printf() {
	log "$@"
	printf "$@"
}

log_out_chars() {
	local i 
	for(( i=0 ; i<${#1} ; i++ )); do
		log_out_char ${1:$i:1}
	done
}

log_out_char() {
	local x

	printf -v x '%d' "'$1"
	printf -v x '%02x' $x
	log_out_byte $x
}

log_out_byte() {
	# return
	if [[ $last_log != '>' ]]; then
		raw_log '\n>'
		last_log='>'
	fi
	raw_log ' %s' $1
}

log_in_char() {
	local x

	printf -v x '%d' "'$1"
	printf -v x '%02x' $x
	log_in_byte $x
}

log_in_byte() {
	# return
	if [[ $last_log != '<' ]]; then
		raw_log '\n<'
		last_log='<'
	fi
	raw_log ' %s' $1
}

log_array() {
	local name=$1
	local -n _a=$name
	local _i

	log 'Array %s\n' $name
	for _i in ${!_a[@]}; do
		log '%s[%s]=%s\n' $name $_i "${_a[$_i]}"
	done
}

write_b() {
	printf '%b' "\x$1" || die 'Write failure: %d\n' $?
	log_out_byte $1
}

write_s() {
	printf '%s' "$1" || die 'Write failure: %d\n' $?
	log_out_chars "$1"
}

write8() {
	local t=00
	(( $1 )) && printf -v t '%02x' "$(( $1 & 16#ff ))"
	write_b $t
}

writei8() {
	local i=$1
	local b=${2:-8}

	(( b == 16 || b == 32 )) && writepad $(( b / 8 - 1 ))

	(( i > 16#7f )) && (( i &= 16#7f ))
	# write8 will handle negative numbers correctly
	write8 $i
}

write16() {
	local val=$1

	write8 $(( val >> 8 ))
	write8 $val
}

writei16() {
	local i=$1
	local b=${2:-16}

	(( b == 32 )) && writepad 2

	if (( i < 0 )); then
		(( i &= 16#ffff ))
	else
		(( i &= 16#7fff ))
	fi
	write16 $i
}

write32() {
	local val=$1

	write8 $(( val >> 24 ))
	write8 $(( val >> 16 ))
	write8 $(( val >> 8 ))
	write8 $val
}

writei32() {
	local i=$1

	if (( i < 0 )); then
		(( i &= 16#ffffffff ))
	else
		(( i &= 16#7fffffff ))
	fi
	write32 $i
}

writepad() {
	local i
	for (( i=0 ; i<$1 ; i++ )); do
		write8 0
	done
}

pad4() {
	local l=$1
	echo $(( (4 - (l % 4)) % 4 ))
}

writepad4() {
	writepad $(pad4 $1)
}


writechars() {
	#local len=$1
	write_s "$2"
}

writeutf8() {
	#local len=$1
	local LC_TYPE=C.UTF8
	write_s "$2"
}

writebytes() {
	local len=$1
	local bytes=$2
	local byte_count=$(( ${#bytes}/2 ))
	local i b

	for (( i=0 ; i<byte_count ; i++ )); do
		b=$(( i*2 ))
		write_b "${bytes:b:2}"
	done
	# If len > byte_count pad with nulls
	for (( i=byte_count ; i<len ; i++ )); do
		write_b 00
	done
}

read8() {
	local _t

	[[ ${1::1} != '_' ]] && log "$1=read8"

	IFS= read -r -d '' -n 1 _t
	if [[ -n $_t ]]; then
		printf -v "$1" '%d' "'$_t"
	else
		printf -v "$1" "0"
	fi

	log_in_char "$_t"
}

readi8() {
	local _i8

	[[ ${1::1} != '_' ]] && log "$1=readi8"

	read8 _i8
	(( _i8 > 16#7f )) && (( _i8 -= 16#100 ))
	printf -v "$1" '%d' $_i8
}

read16() {
	local _b1 _b2
	[[ ${1::1} != '_' ]] && log "$1=read16"
	read8 _b1
	read8 _b2
	printf -v "$1" '%d' "$(( _b2 + (_b1 << 8) ))"
}

readi16() {
	local _i16

	[[ ${1::1} != '_' ]] && log "$1=readi16"

	read16 _i16

	(( _i16 > 16#7fff )) && (( _i16 -= 16#10000 ))

	printf -v "$1" '%d' $_i16
}

read32() {
	local _b1 _b2 _b3 _b4
	[[ ${1::1} != '_' ]] && log "$1=read32"
	read8 _b1
	read8 _b2
	read8 _b3
	read8 _b4
	printf -v "$1" '%d' "$(( _b4 + (_b3 << 8) + (_b2 << 16) + (_b1 << 24) ))"
}

readi32() {
	local _i32

	[[ ${1::1} != '_' ]] && log "$1=readi32"

	read32 _i32
	(( _i32 > 16#7fffffff )) && (( _i32 -= 16#100000000 ))
	printf -v "$1" '%d' $_i32
}

readstr() {
	local _s1
	read8 _s1
	readchars $_s1 $1
}

readstring() {
	local _s

	[[ ${1::1} != '_' ]] && log "$1=readstring"

	IFS= read -r -d '' _s

	log "\"$_s\""

	printf -v "$1" "$_s"
}

readchars() {
	local _n=$1
	local _s

	(( $_n )) || return

	[[ ${2::1} != '_' ]] && log "$2=readchars"

	IFS= read -r -d '' -n $_n _s

	log "\"$_s\""

	(( _n == ${#_s} )) || readpad $(( $_n - ${#_s} - 1))
	
	printf -v "$2" "$_s"
}

readbytes() {
	local _i _c _b _s

	(( $1 )) || return

	[[ ${2::1} != '_' ]] && log "$2=readbytes"

	for (( _i=0 ; _i<$1 ; _i++ )); do
		read8 _c
		printf -v _b '%02x' $_c
		_s+=$_b
	done

	printf -v "$2" $_s
}

readutf8() {
	local LC_CTYPE=C.UTF8
	local _utf8

	[[ ${1::1} != '_' ]] && log "$1=readutf8"

	readchars $1 _utf8
	printf -v "$2" '%s' $_utf8
}

readpad() {
	local _pad i

	[[ ${1::1} != '_' ]] && log "pad=readpad $1\n"

	for (( i=0 ; i<$1 ; i++ )); do
		read8 _pad
	done
}

readpad4() {
	readpad $(pad4 $1)
}

readxauth() {
	local proto=256
	local addr="${HOSTNAME}"
	local display="${dsp#*:}"
	local length=1
	local xauth_proto xauth_addr xauth_display xauth_name xauth_data

	log 'ReadXAuth: %s %s %s\n' $proto $addr $display

	{
	while [[ $length != 0 && ($xauth_proto != $proto ||
				  $xauth_addr != $addr ||
				  $xauth_display != $display) ]]; do
		read16 xauth_proto
		read16 length
		readchars $length xauth_addr
		read16 length
		readchars $length xauth_display
		read16 xauth_name_length 
		readchars $xauth_name_length xauth_name
		read16 xauth_data_length
		readbytes $xauth_data_length xauth_data
	done
	} < "${XAUTHORITY:-~/.Xauthority}"

	server['xauth_name']="$xauth_name"
	server['xauth_data']="$xauth_data"
}

x_send_setup() {
	local name_len=${#server['xauth_name']}
	# data is 02x formatted bytes
	local data_len=$(( ${#server['xauth_data']} / 2 ))

	log 'SetupRequest\n'

	{
	write8 ${server['byte_order']}
	writepad 1
	write16 ${server['wm_proto_major']}
	write16 ${server['wm_proto_minor']}
	write16 $name_len
	write16 $data_len
	writepad 2
	writechars $name_len "${server['xauth_name']}"
	writepad4 $name_len
	writebytes $data_len "${server['xauth_data']}"
	writepad4 $data_len
	} >&${xfd}
}

x_read_setup_leader() {
	log '< Setup Leader\n'
	{
	read8 server['setup_success']
	read8 server['setup_length']
	read16 server['proto_major']
	read16 server['proto_minor']
	read16 server['extra_length']
	} <&${xfd}
}

x_read_setup_failure() {
	log '< Setup Failure\n'
	{
	readchars ${server['setup_length']} server['setup_failure_reason']
	readpad "$(( server['extra_length'] * 4 - server['setup_length'] ))"
	} <&${xfd}
}

x_read_setup_ok() {
	local s d depth no_of_visuals v class bits_per_rgb colormaps
	local red_mask green_mask blue_mask

	log '< Setup OK\n'

	{
	read32 server['release_number']
	read32 server['resource_id_base']
	read32 server['resource_id_mask']
	read32 server['motion_buffer_size']
	read16 server['vendor_length']
	read16 server['max_request_length']
	read8 server['no_of_screens']
	read8 server['no_of_formats']
	read8 server['image_byte_order']
	read8 server['bitmap_byte_order']
	read8 server['bitmap_scanline_unit']
	read8 server['bitmap_scanline_pad']
	read8 server['min_keycode']
	read8 server['max_keycode']
	readpad 4
	readchars ${server['vendor_length']} server['vendor'] 
	readpad4 ${server['vendor_length']}
	readpad $(( 8 * server['no_of_formats'] ))

	for (( s=0 ; s<server['no_of_screens'] ; s++ )); do
		declare -Ag screen_$s
		local -n screen=screen_$s
		read32 screen['root']
		read32 screen['colormap']
		read32 screen['white_pixel']
		read32 screen['black_pixel']
		read32 screen['input_masks']
		read16 screen['width_pixels']
		read16 screen['height_pixels']
		read16 screen['width_mm']
		read16 screen['height_mm']
		read16 screen['min_maps']
		read16 screen['max_maps']
		read32 screen['visual_id']
		read8 screen['backing_stores']
		read8 screen['save_unders']
		read8 screen['root_depth']
		read8 screen['no_of_depths']

		# Not sure that this detail will be needed
		for (( d=0 ; d<screen['no_of_depths'] ; d++ )); do
			read8 depth
			readpad 1
			read16 no_of_visuals
			readpad 4
			for (( v=0 ; v<no_of_visuals ; v++ )); do
				read32 visual_id
				read8 class
				read8 bits_per_rgb
				read16 colormaps
				read32 red_mask
				read32 green_mask
				read32 blue_mask
				readpad 4
			done
		done
	done
	} <&${xfd}
}

beginrequest() {
	local format=$1
	shift 1

	(( wm_seqno >= 16#ffff )) && wm_seqno=0
	(( wm_seqno++ ))

	log "Request %s: $format\n" $wm_seqno "$@" 
}

beginreply() {
	local format=$1
	shift 1

	log "Reply: $format\n" "$@"
}

beginevent() {
	local format=$1
	shift 1

	log "Read Event: $format\n" "$@"
}

beginprocess() {
	local format=$1
	shift 1

	log "Process Event: $format\n" "$@"
}

setreplyhandler() {
	local handler=$1

	if [[ $handler ]]; then
		(( replies_pending++ ))
		shift 1
		declare -Ag "reply_$wm_seqno=( \
			handler "$handler" \
			args \"$*\" )"
		log 'Created reply handler for sequence number %s, %s\n' \
			$wm_seqno $handler
	fi
}

x_send_change_window_events() {
	local windowid=$1
	local mask=$2

	beginrequest 'ChangeWindowEvents %s' $windowid
	{
	write8 $X_ChangeWindowAttributes
	write8 0
	write16 4
	write32 $windowid
	write32 $X_CWEventMask
	write32 $mask
	} >&${xfd}
}

x_send_get_keyboard_mapping() {
	local min_keycode=${server['min_keycode']}
	local max_keycode=${server['max_keycode']}

	beginrequest 'GetKeyBoardMapping'
	setreplyhandler x_read_get_keyboard_mapping
	{
	write8 $X_GetKeyboardMapping
	write8 0
	write16 2
	write8 $min_keycode
	write8 $(( 1 + max_keycode - min_keycode ))
	writepad 2
	} >&${xfd}
}

x_send_grab_key() {
	local keycode=$1
	local mask=$2

	beginrequest 'GrabKey %s %s' $mask $keycode
	{
	write8 $X_GrabKey
	write8 0
	write16 4
	write32 ${screen_0['root']}
	write16 $mask
	write8 $keycode
	write8 1
	write8 1
	writepad 3
	} >&${xfd}
}

set_border_color() {
	local windowid=$1
	local border_pixel=$2

	log 'Set border color for window %s to %s\n' $windowid $border_pixel

	x_send_change_window_attributes $windowid $X_CWBorderPixel $border_pixel
}

x_send_change_window_attributes() {
	local windowid=$1
	local mask=$2
	local bit_count=${ count_bits $mask; }
	shift 2

	beginrequest 'ChangeWindowAttributes %s' $windowid 
	{
	write8 $X_ChangeWindowAttributes 
	write8 0
	write16 $(( 3 + bit_count ))
	write32 $windowid
	write32 $mask
	local i
	for (( i=0 ; i<bit_count ; i++ )); do
		write32 $1
		shift
	done
	} >&${xfd}
}

set_window_pos() {
	local windowid=$1
	local -n window=window_$windowid
	local x=${2:-${window['old_x']}}
	local y=${3:-${window['old_y']}}
	local width=${4:-${window['old_width']}}
	local height=${5:-${window['old_height']}}
	local border_width=${6:- \
			${window['old_border_width']:- \
			${window['border_width']}}}
	local stack_mode=$7
	local sibling=$X_None
	local length=8

	window['old_x']=${window['x']}
	window['old_y']=${window['y']}
	window['old_width']=${window['width']}
	window['old_height']=${window['height']}
	window['old_border_width']=${window['border_width']}

	window['x']=$x
	window['y']=$y
	window['width']=$width
	window['height']=$height

	# Don't let border width force window width or height < 1
	if (( width <= (2 * border_width) || height <= (2 * border_width) )); then
		border_width=0
	fi
	window['border_width']=$border_width

	mask=$(( X_CWX | X_CWY | X_CWWidth | X_CWHeight | X_CWBorderWidth ))

	if [[ $stack_mode ]]; then
		(( mask |= X_CWStackMode ))
	else
		stack_mode=$X_Above
	fi

	x_send_configure_window \
		$windowid $stack_mode $mask \
		$x $y $width $height $border_width $sibling
}

x_send_configure_window() {
	local windowid=$1
	local stack_mode=$2
	local mask=$3
	local x=$4
	local y=$5
	local width=$6
	local height=$7
	local border_width=$8
	local sibling=$9

	width=$(( width - (2 * border_width) ))
	height=$(( height - (2 * border_width) ))

	local bit_count=${ count_bits $mask; }

	beginrequest 'ConfigureWindow %s' $windowid
	{
	write8 $X_ConfigureWindow
	write8 0
	write16 $(( 3 + bit_count ))
	write32 $windowid
	write16 $mask
	writepad 2

	local i=0
	(( mask & X_CWX )) && writei16 $x 32
	(( mask & X_CWY )) && writei16 $y 32
	(( mask & X_CWWidth )) && write32 $width
	(( mask & X_CWHeight )) && write32 $height
	(( mask & X_CWBorderWidth )) && write32 $border_width
	(( mask & X_CWSibling )) && write32 $sibling
	(( mask & X_CWStackMode )) && write32 $stack_mode

	} >&${xfd}

	 
	x_send_synthetic_configure_notify \
		$windowid $width $height $stack_mode $sibling
}

x_send_synthetic_configure_notify() {
	local windowid=$1
	local width=$2
	local height=$3
	local stack_mode=$4
	local sibling=$5

	(( stack_mode != X_Above )) && sibling=$X_None

	local -n window=window_$windowid

	beginrequest 'SendEvent Configure Notify %s' $windowid 
	{
	write8 $X_SendEvent
	write8 0
	write16 11
	write32 $windowid
	write32 $X_StructureNotifyMask

	write8 $X_ConfigureNotify
	write8 32
	write16 0
	write32 $windowid
	write32 $windowid
	write32 $sibling
	writei16 ${window['x']}
	writei16 ${window['y']}
	write16 $width
	write16 $height
	write16 ${window['border_width']}
	write8 0
	writepad 5
	} >&${xfd}
}


