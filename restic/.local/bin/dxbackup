#!/usr/bin/env bash

_fail() {
         >&2 echo "$@"
         exit 1
}

[[ "$#" -ge 1 ]] || _fail Usage: $(basename "$0") \<dir\> [ --restore ]

case $2 in
--restore ) 
	[[ -e "$1" ]] && _fail "$1" already exists
	restic -r "rclone:Dropbox:$1" restore latest --target .
	;;
* )
	[[ -d "$1" ]] || _fail "$1" is not a directory
	restic -r "rclone:Dropbox:$1" backup "$1" --skip-if-unchanged
	rm -r "$1"
	;;
esac
